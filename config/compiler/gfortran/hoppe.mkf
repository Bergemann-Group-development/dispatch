# Production, multi-host build -- the gfortran counterpart to ifort/hoppe.mkf.
#
# ifort builds an AVX2 baseline plus an auto-dispatched AVX-512 path. gfortran has
# no flag-level equivalent of Intel's -ax CPU dispatch (function multi-versioning
# would need per-routine source annotations), so it compiles for a portable
# baseline of the build host's architecture:
#
#   x86-64          -> -march=x86-64-v3 : AVX2 and FMA (Haswell, AMD Zen and newer),
#                                         matching ifort's baseline.
#   arm64 (Apple)   -> -mcpu=apple-m1   : runs across all Apple silicon (M1+).
#   aarch64 (Linux) -> -mcpu=generic    : portable across ARM servers.
#
# For a single known node, override on the make command line: HW=-march=native.
# -O3 (not -Ofast) is deliberate: -ffast-math would perturb the golden tests.

OPT   = -O3
DEBUG = -fbacktrace

ARCH := $(shell uname -m)
ifeq ($(ARCH),x86_64)
  HW = -march=x86-64-v3 -mtune=generic
else ifeq ($(ARCH),arm64)
  HW = -mcpu=apple-m1
else ifeq ($(ARCH),aarch64)
  HW = -mcpu=generic -mtune=generic
else
  HW = -mtune=generic
endif
