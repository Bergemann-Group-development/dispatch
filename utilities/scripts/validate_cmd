#!/bin/csh

set label = "$1$patch"
shift
set cmd = "$*"

set date = `date +%y%m%d_%H%M`

#echo " "

set cmd = "$cmd >& $label.log"
if ($?tee) set cmd = "$cmd |& tee $label.log"

# echo the command
echo "$cmd"
if ($?dryrun) exit

# run the command
csh -c "$cmd"

# check if a .val file exists, rerun if not
if (! -e $label.val ) then
  echo "   WARNING: creating new $label.val from $label.log"
  mv $label.log $label.val
  csh -c "$cmd"
endif

diff -ibw $label.val $label.log
if ($status) then
  echo "                                                                    ==> NOT the same"
  cp -p $label{,_$date}.log
  cp -p $label{,_$date}.val
  cp -p $label.{log,val}
  exit(1)
else
  echo "                                                                    ==> OK, same result"
  exit(0)
endif
