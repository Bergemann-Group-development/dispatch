!-------------------------------------------------------------------------------
! This is exactly the same experiment as sedov1.nml, except it uses 4 patches
! with 64x64 points each, instead of one with 256x256.  Check if the results 
! are the same!  Also: try using Python to piece together the full picture!
!-------------------------------------------------------------------------------
&sedov_params
 w_gauss=0.005
 p_gauss=8
 gamma=1.666667
 amplitude=0.0
 amplitude_rho=2.0
 nu=0.2,1.0
/
&refine_params
 msplit=2               ! split into 2x2
 max_change=0.1         ! log value
 levelmax=9             ! continue up to resolution = 2**levelmax
 refine_from=0.0        ! start refining at t=0.0
 refine_until=-1.0      ! continue all the time
/
&io_params
 levelmax=9             ! for output data files
 do_trace=f verbose=1   ! =1 for output file messages
/
&box_params
 size=1,1,1             ! box size
 dims=4,4,1             ! number of patches
/
&timestep_params
 time_order=2
 end_time=0.30000 out_time=0.00300 dt_fixed=0.00020     ! production runs
/
&patch_params
 dims=64,64,1,5,5       ! nx, ny, nz, ntime, nvar
/
