&sedov_params
 w_gauss=0.03
 p_gauss=8
 gamma=1.666667
 amplitude=0.0
 amplitude_rho=2.0
 nu=0.6,2.0
/
&refine_params
 msplit=2
 refine_from=0.0
 refine_until=0.0
 max_change=0.3
 levelmax=8
/
&io_params
 !do_trace=t verbose=3   ! =1 for output file messages
 do_trace=f verbose=1   ! =1 for output file messages
 !do_trace=f verbose=4   ! =1 for output file messages
/
&box_params
 size=1,1,0             ! box size
 !dims=1,1,1             ! number of patches
 dims=8,8,1             ! number of patches
/
&timestep_params
 courant=0.10
 time_order=3
!end_time=0.300   out_time=0.004   dt_fixed=0.00002
 end_time=0.00003 out_time=0.00001 dt_fixed=0.00002
/
&patch_params
 !dims=256,256,1,5,5       ! nx, ny, nz, ntime, nvar
 dims=16,16,1,5,5       ! nx, ny, nz, ntime, nvar
/
