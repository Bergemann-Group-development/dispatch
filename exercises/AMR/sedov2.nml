!-------------------------------------------------------------------------------
! A case where all of the pressure is due to extra entropy, at constant density.
! Try estimating how much mass there is in the explosion, relative to the total.
!
! Safeguarded against multi-patch-problems, and making it maximally simple to 
! visualize, by using a single patch.  Fast (but not so realistic) by being
! two-dimensional
!
! Makes 101 snapshots, which is a suitable number for smooth animation.
!-------------------------------------------------------------------------------
&sedov_params
 w_gauss=0.005
 p_gauss=8
 gamma=1.666667
 amplitude=3.0
 amplitude_rho=0.0
 nu=0.2,1.0
/
&refine_params
 msplit=2               ! split into 2x2
 max_change=0.1         ! log value
 levelmax=9             ! continue up to resolution = 2**levelmax
 refine_from=0.0        ! start refining at t=0.0
 refine_until=-1.0      ! continue all the time
/
&io_params
 levelmax=9             ! for output data files
 do_trace=f verbose=1   ! =1 for output file messages
/
&box_params
 size=1,1,1             ! box size
 dims=1,1,1             ! number of patches
/
&timestep_params
 time_order=2
 end_time=0.30000 out_time=0.00300 dt_fixed=0.00020     ! production runs
/
&patch_params
 dims=256,256,1,5,5       ! nx, ny, nz, ntime, nvar
/
