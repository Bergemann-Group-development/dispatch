&poisson_params
 w_gauss=0.20           ! Gaussian width
 p_gauss=2              ! exp(-(r/w_gauss)**p_gauss)
 amplitude=0.5          ! density max = exp(amplitude)
 G=1.                   ! strength of gravity
 tolerance=1e-3         ! tolerance on relative error
 min_iter=5             ! minimum number of iterations in gravity solver
 max_iter=1000          ! maximum number of iterations in gravity solver
 solver='jacobi_2nd'    ! solver name (jacobi_2nd or jacobi_4th)
!solver='jacobi_4th'    ! solver name (jacobi_2nd or jacobi_4th)
/
&io_params
!do_trace=t verbose=4   ! Trace through routine calls. Max debug.
!do_trace=f verbose=3   ! Print out error for each iteration
 do_trace=f verbose=2   ! Print out final iteration count and error
!do_trace=f verbose=1   ! Only complain if solution not converged
/
&patch_params
 dims=16,16,16         ! nx, ny, nz
/
