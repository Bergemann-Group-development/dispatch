&BE_params
 w_BE=0.15              ! Gaussian width
 p_BE=4                 ! f(r) = exp(-(r/w_gauss)**p_gauss) for small r
 a_BE=0.1               ! f(r) = a/r**2 for r >> w_gauss
 r_BE=0.48              ! phi(r)=0, rho(r)=constant, ..., for r > r_BE
 amplitude=27.          ! density contrast
/
&ghd_params
 G=4.0                  ! strength of gravity G = (c/R_BE)**2 / (2\rho_BE)
 tolerance=1e-3         ! tolerance on relative error
 min_iter=5             ! minimum number of iterations in gravity solver
 max_iter=1000          ! maximum number of iterations in gravity solver
 solver='sor'           ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
!omega_sor=1.5
/
&hd_params              ! defaults are visible in the log file
/
&patch_params
 dims=18,18,18          ! patch dimensions
/
&box_params
 dims=1,1,1             ! number of patches
/
&timestep_params
 end_time=0.0010        ! experiment end time, of the order r_BE/c_sound
 out_time=0.0001        ! output cadence
 dt_fixed=0.0001        ! fixed time step
 !end_time=0.2000        ! experiment end time, of the order r_BE/c_sound
 !out_time=0.0020        ! output cadence
 !dt_fixed=0.0002        ! fixed time step
/
&refine_params
 msplit=3               ! split into that many
 refine_from =0.0001    ! enables refinment at that time
 refine_until=0.0002    ! disables refinment at that time
 min_jeans=5            ! min 10 points per Jeans length
 levelmax=10            ! max 3**10 = 5900 times
/
&io_params
 do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
/
