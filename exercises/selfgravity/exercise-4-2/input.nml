&BE_params
 w_BE=0.15              ! Gaussian width
 p_BE=8                 ! f(r) = exp(-(r/w_gauss)**p_gauss) for small r
 a_BE=0.1              ! f(r) = a/r**2 for r >> w_gauss
 amplitude=10.          ! density contrast
/
&ghd_params
 G=1.                   ! strength of gravity
 tolerance=1e-3         ! tolerance on relative error
 min_iter=5             ! minimum number of iterations in gravity solver
 max_iter=1000          ! maximum number of iterations in gravity solver
 solver='gauss-seidel'  ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
 solver='jacobi'        ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
 solver='sor'           ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
/
&hd_params
/
&patch_params
 dims=16,16,16,6,6
 !dims=64,64,64
/
&box_params
 dims=1,1,1
/
&timestep_params
 end_time=0.0
/
&refine_params
 refine_until=-1
/
&io_params
 do_trace=t verbose=4   ! =1 for output file messages
/
