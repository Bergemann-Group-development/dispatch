&run_params
 refine_only=f
 t_end=0.5 t_out=0.00125
 verbose=1
 datadir='gmc2'
 logdir='gmc2'
 do_trace=f
 do_debug=f
 do_output=t
 do_timer=f
 particles_only=f
 list_trace=f
/

&unigrid_params level=6 n=32 center=0.5,0.5,0.5 t_step=0.01 t_next=0.0 /
&unigrid_params level=6 n=64 center=0.5,0.5,0.5 t_step=0.01 t_next=0.0 /

&debug_params
 !debug_select=4 zap_value=0.0
 !id_debug=15
 !id_debug=507 i_debug=13,0,13,6
 !id_debug=32771
/

&init_params
nout=5
!xmin=0.0 xmax=1.0
!ymin=0.0 ymax=1.0
!zmin=0.0 zmax=1.0
maxlvl=8
path='gmc2'
/

&refine_params dynamic_refine=f /
&refine_on_potential_params /
&refine_on_timestep_params /
&refine_on_speed_params
 umax=1e6
/

&patch_params
 level=6
 size=1.0,1.0,1.0
 pos=0.0,0.0,0.0
 !n=55,55,55
 n=128,128,128
 u=0,0,0
 ng=2
/

&pde_params
 !nu=0.1,0.7,3.0,0.5,0.2,0.50 ! pretty good
 !nu=0.1,0.7,3.0,1.0,0.2,1.00 !
 nu=0.05,0.7,3.0,2.0,0.1,1.00 !
 nu=0.05,.35,1.5,2.0,0.1,1.00 !
 !nu=0.30,0.0,0.0,2.0,0.1,1.00 !
 eta=0.0
 speed_limit=20
/

&timestep_params
 fixed_boundary=f,f,f
 timeorder=3 courant_number=0.333
 !timeorder=1 courant_number=0.05
 verbose=1
/

&poisson_params grho=0.0 /
&rank_params amrgb=0.05 /
&force_params /

&star_params /
