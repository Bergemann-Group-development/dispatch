! $Id: 690510a73bf541bec42645fd4caef92ee48dfe18 $

&cartesian_params
 size=1,1,1 dims=04,04,04 mpi_dims=1,1,1                !  1 process    1 node      64 patches    2 cores    128x128x128  32 patches/core
 origin=0,0,0
/

!---------------------------------------------
! For unigrid run, use the no_mans_land=t line
!---------------------------------------------
&scaling_params         l_pc=40 v_kms=1 d_cgs=4e-22
&patch_params           nt=5 nv=8 grace=0.1 n=3*16 no_mans_land=t /
&out_params             end_time=11-4 out_time=2e-4 print_every=1 /
&io_params              verbose=0 do_trace=f omp_trace=t do_output=t
                        method='legacy' id_debug=0
                        guard_zones=t time_derivs=0 /
&timer_params           sec_per_report=5 /
&validate_params        state='write' /

!---------------------------------
! Initial condition and forces
!---------------------------------
&ramses_reader_params   verbose=0
                       !path='gmc2' nout=11 levelmin=5 levelmax=9 centre_on_sink=f      ! steno
                        path='gmc2' nout=9  levelmin=6 levelmax=8 centre_on_sink=f      ! laptop, mn
                        direct_load=t do_evaluate=f detailed_timer=f /
&guard_zone_params      verbose=0 method='opt' detailed_timer=f /
&download_params        verbose=0 id_debug=0 detailed_timer=f
                        use_restrict='different'
                        !use_restrict='diff_pro'
                        !use_restrict='guard_zones'
                        !use_same='different'
                        !use_same='guard_zones'
                        use_same='same'
                        !use_prolong='different'
                        !use_prolong='prolong'
                        !use_prolong='guard_zones'
                        use_prolong='diff_pro'
                        /
&IC_params         /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=2 t_turn=0.05 k1=1 k2=2 pk=0.0 seed=5 /
&selfgravity_params     selfgravity=f /

!---------------------------------
! Solver specific parameters
!---------------------------------
&ramses_params          courant_factor=0.250 isothermal=f gamma=1.4 slope_type=2 
                        smallr=1e-5 smallc=5e-1 riemann='hlld' detailed_timer=f /
&mhd_params             isothermal=f gamma=1.01 nu=0.20,1.4,1.0,0.1,1.0,1.0 /
&timestep_params        /
&refine_params          on=f check_interval=2 /
&sinkparticles_params   do_sink=f rho_limit=1.2 max_sinks=1 verbose=0 /

!----------------------------------------------------------------------------------
! MPI and loadbalancing parameters
!----------------------------------------------------------------------------------
&load_balance_params    /

!----------------------------------------------------------------------------------
! Method=0 uses a ready queue, which may or may not work for more than 1e12 updates
! Method=1 uses a simple master thread dispatcher
! Method=2 uses a more complex master thread dispatcher
!----------------------------------------------------------------------------------
&dispatcher_params      method=0 test=f verbose=1 use_locks=t /
&dispatcher0_params     verbose=0 retry_stalled=10. /
&task_list_params       verbose=0 detailed_timer=t /
&mpi_mesg_params        /

