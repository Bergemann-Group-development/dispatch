!---------------------------------------------
! I/O parameters
!---------------------------------------------
&scaling_params         l_pc=250 v_kms=1 d_cgs=1.67e-24
&ramses_reader_params   verbose=2 levelmin=7 levelmax=22
                        path='run14j' nout=52
                        !path='/scratch/aake/run14j' nout=52
                        direct_load=t do_evaluate=f detailed_timer=f /
&patch_params           nt=3 nv=8 grace=0.1 n=3*16 zero_order_extrap=t /
&io_params              verbose=0 do_trace=f omp_trace=t
                        !id_debug=7086
                        id_debug=7479
                        do_output=t method='background'
                        guard_zones=f time_derivs=0 /
&timer_params           sec_per_report=30 /
&download_params        verbose=0 /
&interp_params          verbose=0 /

!---------------------------------------------
! Redundant namelist when not continuing runs
!---------------------------------------------
&cartesian_params       size=1,1,1 dims=03,03,03 mpi_dims=1,1,1 origin=0,0,0 /
&out_params             end_time=0.0201 out_time=0.01 print_every=300 /
