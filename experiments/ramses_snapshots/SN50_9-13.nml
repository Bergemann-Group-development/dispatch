! $Id$

&cartesian_params
 size=1,1,1 dims=03,03,03 mpi_dims=1,1,1
 origin=0,0,0
/

!---------------------------------------------
! For unigrid run, use the no_mans_land=t line
!---------------------------------------------
&patch_params           nt=3 nv=8 grace=0.1 n=3*16 no_mans_land=t
                        zero_order_extrap=t /
&out_params             end_time=0.0201 out_time=0.01 print_every=300 /
&io_params              verbose=1 do_trace=f omp_trace=t do_output=t
                        method='amr' id_debug=0 restart=-9
                        guard_zones=t time_derivs=0 /
&timer_params           sec_per_report=30 /
&validate_params        state='write' /
&download_params        verbose=0 /
&task_list_params       /
&mpi_mesg_params        /

!---------------------------------
! Initial condition and forces
!---------------------------------
&ramses_reader_params   verbose=0 levelmin=9 levelmax=13
                        !n_cell=16 cut_out_size=1.0 centre_on_sink=f
                        path='SN50' nout=785
                        direct_load=t do_evaluate=f detailed_timer=f /
&initial_params         /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=2 t_turn=0.05 k1=1 k2=2 pk=0.0 seed=5 /
&selfgravity_params     selfgravity=f /

!---------------------------------
! Solver specific parameters
!---------------------------------
&ramses_params          courant_factor=0.250 isothermal=t
                        slope_type=2 smallr=1e-4 smallc=5e-1 riemann='hlld' /
&mhd_params             isothermal=f gamma=1.05 nu=0.20,1.4,1.0,0.1,1.0,1.0 /
&timestep_params        /
&refine_params          on=f check_interval=2 levelmin=20 /
&sinkparticles_params   do_sink=f rho_limit=1.2 max_sinks=1 verbose=0 /

!----------------------------------------------------------------------------------
! MPI and loadbalancing parameters
!----------------------------------------------------------------------------------
&load_balance_params    /

!----------------------------------------------------------------------------------
! Method=0 uses a ready queue, which may or may not work for more than 1e12 updates
! Method=1 uses a simple master thread dispatcher
! Method=2 uses a more complex master thread dispatcher
!----------------------------------------------------------------------------------
&dispatcher_params      verbose=0 /

