&cartesian_params
 size=1,1,1 dims=3*4  mpi_dims=1,1,2                !  1 process    1 node      64 patches    2 cores    128x128x128  32 patches/core
 !size=1,1,1 dims=3*16 mpi_dims=2,2,2                !  1 process    1 node      64 patches    2 cores    128x128x128  32 patches/core
 !size=1,1,1 dims=3*20 mpi_dims=2,2,4                !  1 process    1 node      64 patches    2 cores    128x128x128  32 patches/core
 omp_init=t origin=0,0,0 /
!---------------------------------------------
! For unigrid run, use the no_mans_land=t line
!---------------------------------------------
!&patch_params           nt=5 grace=0.3 n=3*32 no_mans_land=t /
&patch_params           nt=5 grace=0.3 n=3*16 no_mans_land=t /
&out_params             end_time=0.111 out_time=0.020 print_every=50 /
&io_params              verbose=0 do_trace=f omp_trace=f do_output=f restart=-2
                        method='legacy' format=10 guard_zones=t time_derivs=0 /
&pdf_io_params          on=t verbose=0 out_time=0.02 nbins=201 bin_min=-12. bin_max=8. /
&timer_params           sec_per_report=10 min_fraction=5e-3 /
&validate_params        mode='' /
&time_slices_params     order=1 /
&download_params        verbose=0 use_locks=f sorted=t check_filled=t id_debug=0 /
&counters_params        verbose=0 /
&lock_params            verbose=0 verbose_time=000 tasks=t /
&remesh_params          verbose=0 order=0 /
&refine_params          on=t verbose=0 levelmin=6 levelmax=9 check_interval=5
                        !max_jeans=0.15 min_jeans=0.06
                        !max_vorticity=8 min_vorticity=3.2
                        max_vorticity=12 min_vorticity=4.8
                        !max_compress=20 min_compress=6.4
                        /
!---------------------------------
! Initial condition and forces
!---------------------------------
&initial_params         type='turbulence' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=8 t_turn=0.10 k1=1 k2=2 pk=0.0 seed=5 /
&IC_turbulence_params   b0=0.1 /
&selfgravity_params     selfgravity=f /
&trace_particle_params  on=f verbose=0 per_cell=1.0 /
!---------------------------------
! Solver specific parameters
!---------------------------------
&ramses_params          courant_factor=0.250 isothermal=t gamma=1.0 slope_type=3.5 smallr=1e-5 smallc=1
                        unsigned=t detailed_timer=f /
&stagger_params         gamma=1.0 nu=0.30,0.0,1.0,0.1,1.0,1.0 /
&timestep_params        /
&sinkparticles_params   on=f rho_limit=1.2 max_sinks=1 verbose=0 /
!----------------------------------------------------------------------------------
! MPI and loadbalancing parameters
!----------------------------------------------------------------------------------
&dispatcher_params      method=0 test=f /
&dispatcher0_params     debug=f do_delay=t retry_stalled=10 /
&load_balance_params    /
&task_list_params       verbose=0 job_seconds=1e6 detailed_timer=t dead_mans_hand=60 /
!&task_mesg_params       verbose=0 method='improbe' /
&task_mesg_params       verbose=0 method='irecv' /
!&task_mesg_params       verbose=0 method='private' /
!&mpi_mesg_params        verbose=0 /
!&mpi_mesg_params        verbose=0 send_priv=f max_send=5 max_sent=1000 min_nq=0 max_recv=1000 max_probe=1000 /
&mpi_mesg_params        verbose=0 send_priv=f max_sent=30 min_nq=0 max_recv=1000 max_probe=1000 delay_ms=0.1 /
!&mpi_mesg_params        verbose=0 send_priv=t max_sent=30 min_nq=0 max_recv=1000 max_probe=1000 delay_ms=0.1 /
