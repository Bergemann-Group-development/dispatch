! --- Dimensions ---------------------------------------------------------------
&scaling_params         v_kms=1 l_pc=40 d_cgs=1e-22 /
&cartesian_params                                  ! ranks nodes patches cores rootgr initial/core 
                        dims=3*4  mpi_dims=1,1,2   !     2     1      64    20   64^3          3
                       !dims=3*8  mpi_dims=2,2,2   !     4     2     512    40  128^3         12
                       !dims=3*16 mpi_dims=2,2,4   !    16     8    2048   160  256^3         12
                       !dims=3*32 mpi_dims=4,4,4   !    32    16     16k  3200  512^3          5
                        size=1,1,1 origin=0,0,0 /
&patch_params           nt=5 grace=0.3 n=3*32 do_check_nan=f
                        zero_order_extrap=t /
&task_params            verbose=0 /

! --- I/O parameters -----------------------------------------------------------
&out_params             end_time=0.10 out_time=0.020 print_every=500 /
&io_params              verbose=0 do_trace=f omp_trace=t do_output=t restart=-2
                        task_logging=0 log_interval=300 guard_zones=t time_derivs=0
                        method='background' /
&time_slices_params     order=3 /
&amr_io_params          verbose=0 nt=2 /
&pdf_io_params          on=f verbose=0 out_time=0.02 nbins=201 bin_min=-12. bin_max=8. /
&timer_params           sec_per_report=10 min_fraction=1e-3 /
&validate_params        mode='' /

! --- Refinement and guard zone parameters -------------------------------------
&refine_params          on=t verbose=0 levelmin=6 levelmax=10
                        min_jeans=16
                        max_vorticity=6
                        max_compress=8 max_compress_level=7
                        check_interval=5 /
&halo_params            verbose=0 /
&guards_params          verbose=0 /
&intrp_params           verbose=0 /

! --- Initial conditions and forces --------------------------------------------
&cooling_params         on=f /
&IC_params              type='turbulence' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=8 t_turn=0.10 k1=1 k2=2 pk=0.0 seed=5 /
&IC_turbulence_params   b0=3*0.0 /
&selfgravity_params     on=f /
&trace_particle_params  on=f verbose=0 per_cell=1.0 /

! --- Solver specific parameters -----------------------------------------------
&eos_params             gamma=1 /
&ramses_params          courant_factor=0.250 slope_type=3.5 smallr=1e-5 smallc=1
                        unsigned=t detailed_timer=f /
&stagger_params         gamma=1.0 nu=0.30,0.0,1.0,0.1,1.0,1.0 /
&timestep_params        /
&sinkparticles_params   on=f rho_limit=1.2 max_sinks=1 verbose=0 /
&kdk_params             on=f /

! --- Framerwork parameters ----------------------------------------------------
&lock_params            verbose=1 verbose_time=0 log='queue' tasks=t /
!lock_params            verbose=0 alternate_time=15 verbose_time=0 tasks=t /
&counters_params        verbose=0 /
&dispatcher_params      verbose=0 method=0 /
&dispatcher0_params     verbose=0 retry_stalled=10 max_stalled=20 /
&task_list_params       verbose=0 detailed_timer=f dead_mans_hand=60 /
&task_mesg_params       verbose=0 /
&mpi_mesg_params        verbose=0 /
&load_balance_params    verbose=1 is_on=f length=10 dry_run=f q_min=5 q_max=10 /
