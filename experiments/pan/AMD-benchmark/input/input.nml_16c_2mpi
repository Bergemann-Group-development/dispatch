! $Id: 6536bf0a3a62eea75f0a16db926c562d28edb0ea $

&cartesian_params
 omp_init=f
 !size=1,1,1 dims=3*3   mpi_dims=1,1,1                !  1 process    1 node      27 patches    1 cores       96x96x96  27 patches/core
 !size=1,1,1 dims=3*4   mpi_dims=1,1,1                !  1 process    1 node      64 patches    1 cores    128x128x128  64 patches/core
 !size=1,1,1 dims=4,4,8 mpi_dims=1,1,1                !  2 processes  1 node     128 patches    2 cores    128x128x256  64 patches/core
 !size=1,2,2 dims=4,8,8 mpi_dims=1,1,1                !  4 processes  1 node     256 patches    4 cores    128x256x256  64 patches/core
 !size=2,2,2 dims=8,8,8 mpi_dims=1,1,1                !  8 processes  1 node     512 patches    8 cores    256x256x256  64 patches/core
 size=2,2.25,4 dims=8,10,16 mpi_dims=1,2,2             ! 16 processes  1 node    1280 patches   16 cores    256x320x512  80 patches/core
 !size=2,2,4 dims=8,8,16 mpi_dims=1,1,1               ! 16 processes  1 node    1024 patches   16 cores    256x256x512  64 patches/core
 !size=1,1,1 dims=3*8   mpi_dims=2,2,1                !  1 process    1 node      64 patches    2 cores    128x128x128  32 patches/core
 !size=2,1,1 dims=3*8   mpi_dims=2,1,1                !  1 process    1 node      64 patches    2 cores    128x128x128  32 patches/core
 !size=1,1,1 dims=3*8   mpi_dims=1,1,1                !  1 process    1 node     512 patches   10 cores    256x256x256  51 patches/core
 !size=1,1,1 dims=3*10  mpi_dims=1,1,1                !  1 process    1 node    1000 patches   20 cores    320x320x320  50 patches/core
 !size=1,1,1 dims=3*16  mpi_dims=1,1,1                !  2 process    1 node    4096 patches   10 cores    512x512x512 200 patches/core
 !size=1,1,1 dims=3*20  mpi_dims=2,2,2                !  8 processes  4 nodes   8000 patches   80 cores    640x640x640 100 patches/core
 !size=1,1,1 dims=3*40  mpi_dims=4,4,4                ! 64 processes 64 nodes  64000 patches 1280 cores 1280x1280x1280  50 patches/core
 !size=1,1,1 dims=3*80  mpi_dims=4,4,4                ! 64 processes 64 nodes 512000 patches 1280 cores 2560x2560x2560 400 patches/core
 origin=0,0,0
/

!---------------------------------------------
! For unigrid run, use the no_mans_land=t line
!---------------------------------------------
&patch_params           nt=5 grace=0.5 n=3*32 no_mans_land=t /
!patch_params           nt=5 grace=0.1 n=3*21 no_mans_land=f /
!&out_params             end_time=0.010 out_time=0.025 print_time=0.0 /
!&out_params             end_time=0.020 out_time=0.025 print_time=0.0 /
&out_params             end_time=0.040 out_time=0.025 print_time=0.0 /
&io_params              verbose=0 do_trace=f omp_trace=f do_output=f restart=-2
                        method='parallel' format=11 guard_zones=f time_derivs=0 /
&doẃnload_params        verbose=0 use_different=0 check_filled=t /
&guard_zone_params      method='simple' verbose=0 /
&timer_params           sec_per_report=5 /
&time_slices_params     order=1 /
&lock_params            verbose=0 /

!---------------------------------
! Initial condition and forces
!---------------------------------
&initial_params         type='turbulence' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=2 t_turn=0.05 k1=1 k2=2 pk=0.0 seed=5 
                        verbose=0 t_damp=3e-4 /
&IC_turbulence_params   b0=0.1 /
&selfgravity_params     selfgravity=f /
&trace_particle_params  on=f verbose=0 per_cell=1.0 /

!---------------------------------
! Solver specific parameters
!---------------------------------
&flux_params            on=f verbose=0 /
&ramses_params          courant_factor=0.250 isothermal=t gamma=1.0 slope_type=3.5
                        !riemann='hlld_vec'
                        smallr=1e-3 smallc=1 detailed_timer=f /
&stagger_params         gamma=1.0 nu=0.30,0.0,1.0,0.1,1.0,1.0 /
&timestep_params        /
&refine_params          on=f check_interval=2 /

!---------------------------------
! Sink particle parameters
!---------------------------------
&sink_patch_params      on=f n_ad_hoc=2 /
&sink_params            x=0.52 y=0.52 z=0.52 vx=0.1 mass=1 /
&sink_params            x=0.48 y=0.48 z=0.48 vx=0.2 mass=1 /
&particle_params        verbose=2 /

!----------------------------------------------------------------------------------
! MPI and loadbalancing parameters
!----------------------------------------------------------------------------------
&load_balance_params    /

!----------------------------------------------------------------------------------
! Method=0 uses a ready queue, which may or may not work for more than 1e12 updates
! Method=1 uses a simple master thread dispatcher
! Method=2 uses a more complex master thread dispatcher
!----------------------------------------------------------------------------------
&dispatcher_params      method=0 test=f /
&task_mesg_params       verbose=0 method='private' /    ! optimal for unigrid
!&task_mesg_params       verbose=1 method='virtual' /    ! works for unigrid
!&task_mesg_params       verbose=0 method='master' /     ! works for both AMR & unig
&task_list_params       verbose=0 /
&mpi_mesg_params        verbose=0 send_priv=t /

