&cartesian_params                         !  ranks   nodes    patches    cores   rootgr   initial-patches/core 
 size=1,1,1 dims=3*4  mpi_dims=1,1,2      !    2       1         64        20     64^3          3
!size=1,1,1 dims=3*8  mpi_dims=1,2,2      !    4       2        512        40    128^3         12
!size=1,1,1 dims=3*16 mpi_dims=2,2,2      !    8       4       2048        80    256^3         25
!size=1,1,1 dims=3*32 mpi_dims=4,4,4      !   64      32        16k       640    512^3         25
 omp_init=t origin=0,0,0 /
!---------------------------------------------
! For unigrid run, use the no_mans_land=t line
!---------------------------------------------
&patch_params           nt=5 grace=0.3 n=3*32 no_mans_land=t /
&out_params             end_time=0.081 out_time=0.010 print_every=100 /
&io_params              verbose=0 do_trace=f omp_trace=f do_output=t restart=-2
                        task_logging=1 guard_zones=t time_derivs=0
                        method='background' format=10 /
&time_slices_params     order=3 /
&amr_io_params          verbose=0 nt=2 /
&pdf_io_params          on=f verbose=0 out_time=0.02 nbins=201 bin_min=-12. bin_max=8. /
&timer_params           sec_per_report=10 min_fraction=5e-3 /
&validate_params        mode='' /
&download_params        verbose=0 use_locks=f sorted=t check_filled=t
 !use_prolong='different_prolong'     ! ~0.8 ms (T430s) 0.4 (steno) [default]
 !use_prolong='prolong'               ! ~1.4 ms (T430s) 0.9 (steno)
 !use_prolong='guard_zones'           ! ~1.6 ms (T430s)
 !use_prolong='different'             ! ~1.7 ms (T430s)
 !use_prolong='remesh'                ! not operational
 !use_restrict='different'            ! ~0.4 ms (T430s) [default]
 !use_restrict='guard_zones'          ! ~0.4 ms (problem)
 !use_restrict='different_restrict'   ! ~3.5 ms (T430s)
                        id_debug=0 /
&counters_params        verbose=0 /
!&lock_params            verbose=0 alternate_time=5 verbose_time=00 tasks=t /
&lock_params            verbose=0 log='log' tasks=t /
&remesh_params          verbose=0 order=0 /
&refine_params          on=t verbose=0 levelmin=7 levelmax=10
                        min_jeans=30
                        max_vorticity=8
                        max_compress=8 max_compress_level=9
                        check_interval=5 /
&task_list_params       verbose=0  
                        detailed_timer=f dead_mans_hand=60 /
!---------------------------------
! Initial condition and forces
!---------------------------------
&cooling_params         on=f /
&IC_params         type='turbulence' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=8 t_turn=0.10 k1=1 k2=2 pk=0.0 seed=5 /
&IC_turbulence_params   b0=0.1 /
&selfgravity_params     on=f /
&trace_particle_params  on=f verbose=0 per_cell=1.0 /
!---------------------------------
! Solver specific parameters
!---------------------------------
&eos_params             gamma=1 /
&ramses_params          courant_factor=0.250 slope_type=3.5 smallr=1e-5 smallc=1
                        unsigned=t detailed_timer=f /
&stagger_params         gamma=1.0 nu=0.30,0.0,1.0,0.1,1.0,1.0 /
&timestep_params        /
&sinkparticles_params   on=f rho_limit=1.2 max_sinks=1 verbose=0 /
!----------------------------------------------------------------------------------
! MPI and loadbalancing parameters
!----------------------------------------------------------------------------------
&dispatcher_params      method=0 test=f /
&dispatcher0_params     verbose=0 debug=f do_delay=t retry_stalled=20 max_stalled=19 /
&load_balance_params    /
&task_mesg_params       verbose=0 /
&mpi_mesg_params        verbose=0 /
