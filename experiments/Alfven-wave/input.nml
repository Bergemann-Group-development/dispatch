&experiment_params
/
&stagger_params              ! defaults are visible in the log file
 nu=    0.5, 1.0, 1.0, 0.1, 0.1, 0.1
 !nu=    0.5, 1., 0., 1., 0.1, 0.1
 !nu=    0.1, 1., 1., 1., 0.1, 0.1
 !nu=    0.2, 0., 0.1, 1., 0.1, 0.
 ! nu=0.20,1.4,1.0,0.0,1.0,1.0 /
 !nu= 0., 0., 0., 0., 0., 0.
 !     cs    du   pa   ofd   mas   eta
 !gamma=1.0001
 gamma=1.666667
/
&non_ideal_params
 mhd_AD=.true.
 mhd_Ohm=.false.
 ntestdadm=.true.
 etaMD=0.0
 gammaAD=80.
 rhoi0=1.
/
&patch_params
 n=3,5,9          ! patch dimensions
 !dt_fixed=1d-9        ! fixed time step
 ng =3,3,3
 nt=8                   ! time slots
 no_mans_land = f
/
&timer_params
 sec_per_report=15.0
/
&out_params
 out_time = 1.0
 end_time = 5.1
 print_time = 0.1
 guard_zones=f
/ 
&cartesian_params
 size=1,1,1
 dims=1,1,1				! number of patches
 origin=-0.5,-0.5,-0.5
/
&timestep_params
 verbose=1
 time_order=4
/
&refine_params
 refine_until=-0.01     ! disables refinment
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=f
 method='parallel'
/
&IC_params
/
&force_params
/
&IC_solenoidal_params
/
&ramses_params
! detailed_timer=f
 courant_factor=0.8
 !courant_factor=0.266667
 gamma=1.66666666
! gamma=1.0001
 slope_type=3.5
 !slope_type=-1
 !smallr=1e-4
 !smallc=5e-1
 riemann='hlld'
/
