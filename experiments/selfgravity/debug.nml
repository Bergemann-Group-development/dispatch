&experiment_params
 w_BE=0.15              ! Gaussian width
 p_BE=4                 ! f(r) = exp(-(r/w_gauss)**p_gauss) for small r
 a_BE=0.1               ! f(r) = a/r**2 for r >> w_gauss
 r_BE=0.48              ! phi(r)=0, rho(r)=constant, ..., for r > r_BE
 amplitude=1.0          ! density contrast
 levelmax=3             ! controls initil refinemt
/
&ghd_params
!G=0.0                  ! strength of gravity
 G=18                   ! strength of gravity
 tolerance=1e-3         ! tolerance on relative error
 min_iter=5             ! minimum number of iterations in gravity solver
 max_iter=1000          ! maximum number of iterations in gravity solver
!solver='gauss-seidel'  ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
!solver='jacobi'        ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
solver='sor'           ! solver name (jacobi, gauss-seidel, sor, cg, multi-grid)
!omega_sor=0.0
/
&hd_params              ! defaults are visible in the log file
 gamma=1.001
/
&patch_params
 dims=16,16,16          ! patch dimensions
!end_time=1.0000 out_time=0.0100 dt_fixed=0.0010
 end_time=15e-4 out_time=5e-4 dt_fixed=5e-4
!end_time=1.0000        ! experiment end time
!out_time=0.0100        ! output cadence
!dt_fixed=0.0002        ! fixed time step
/
&box_params
 dims=1,1,1             ! number of patches
/
&timestep_params
/
&refine_params
 refine_until=0.000     ! disables refinment
 min_jeans=12.
 msplit=3               ! level factor
 levelmax=4             ! controls refinement
/
&io_params
 levelmax=7             ! controls output
 do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
/
