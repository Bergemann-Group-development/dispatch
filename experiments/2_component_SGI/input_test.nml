&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
/

&out_params
 end_time=630.0 !1.89  !62.832 !630.0
 out_time=6.283 !0.06283 !6.283  !0.628319
 print_time=0.1
 guard_zones=t
/

&load_balance_params
  on=f
/

&IC_params
  mstar=1.7		! Mass of central star in solar masses
  dust2gas=0.01		! Dust-to-gas mass ratio
  a=1.0			! Dust grain size in cgs units
  d_int=3		! Internal dust grain density in cgs units
  nu=1.0e-5		! Intensity of turbulence
  nv=10			! Number of variables, excluding gravitational potential
  nc=2			! Number of fluid components
  wave_kill=t
  amp=1.0e-3
  lambda=0.58
/

&annulus_params
  rotating=t
  n_patch=1,17,1 !1,17,13 !1,5,9
  n_per_patch=1,42,690 !1,42,55 !1,80,100 !1,32,55 !1,160,495
  extent = 1.0, 70.0, 2.0
  roffset = 10.0
/

&zeus_params
  gamma = 1.0001
  trnvrsn = 0
  dtinit = 1.0e-5
  itote = 0
  qlin=0.1
  qcon=2.0
  iord=2
  iords=2
  istp=0
  nuscalar=1.0e-5
/

&mhd_params
 !nu=    2.5, 2.0, 1.0, 0.0, 2.0, 0.0 !<-- Gas only
 nu=    2.5, 2.0, 1.0, 0.0, 2.0, 0.0, 0.5, 6.0, 1.0, 0.0, 0.0, 0.0 !<-- Gas and dust
 !     cs    du   pa   ofd   mas   eta
 gamma=1.0001
 !gamma=1.0
 csound=1.0
 !gamma=1.66666
 tracer=.false. 			!Enable passive tracer for every fluid component
 force_coupled=.true.			!Enable coupled force type; turn off for ordinary de Val-Borro
 !ksi = 1d-17
/

&timestep_params
  time_order=2
/

&patch_params
  courant=0.2
/

&rubiks_params
 n_repeat=1
 n_levels=1
 position=0,0,0
 !n_patch=1,3,3
 n_patch=0,0,0
 !size=1,0.0025,0.002617995
 !size=1,0.0185185185,0.0193925472 ! should correspond to level "4"
 size=1,0.1665,0.1745
 m_zoom=3
 n_per_patch=1,32,32
 planet_cylpos=0,1.0,0
/

&selfgravity_params
 selfgravity=t
 nc = 2
 prediction=f order=1 verbose=0
/

&poisson_params
 floor=1e-6
 tolerance=1e-4
 fourPiG=1.0
 max_iter=150
 precondition=t
 verbose=1
 solver='cg'
/

&force_params
 type = 'star_and_drag'
 explicit_star = t
 i_gas = 1
 i_dust = 2
 K = 0.0!1.0e-9
 b = 0.4                ! Exponent for power law drag,
 sigma = 1.589e-8
 !gamma = 1.66666
 gamma = 1.0001
 !gamma = 1.0
 csound = 1.0
 !drag = 'linear'       ! F = K*(v-vd)
 drag = 'epstein'
 !drag = 'stokes'
 !drag = 'quadratic'    ! F = K*|v-vd|*(v-vd)
 !drag = 'power'        ! F = K*|v-vd|^b*(v-vd)
 !drag = 'third_order'  ! F = K*(1+|v-vd|^2)*(v-vd)
 !drag = 'mixed'        ! F = K*sqrt(1+|v-vd|^2)*(v-vd)
/

&viscosity_params
 !type  = 'turbulent_viscosity'
 !type2 = 'dust_diffusivity'
 type3 = 'dust_dispersion'
/

&download_params
/
