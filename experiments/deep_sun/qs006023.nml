
! -- Parameters defining the run -----------------------------------------------
&experiment_params  verbose=0 /

&boundary_params    verbose=0
                    !d_bot=231.
                    !e_bot=2896.484
                    bottom_bc_rate=0.99
                    scale=t 
                    divb_iter=4
                    damp_rate=0.2
                    r_sponge = 0.5
                    deriv_bnd=f
                    pb_fact=1.0
                    t_bdry=3.0
                    test=f
                    lower_bc=3
/


&cartesian_params   size=6,6,9 dims=6,6,18 mpi_dims=3,3,1 origin=0,0,-2.
                    omp_init=f periodic=t,t,f/

& initial_refine_params
  on = f
  n_refine = 0,0,2
  center   = 0.0,0.0,2.0
  extent   = 0.0,0.0,3.

&patch_params       nt=5 ng=8,8,8 grace=0.05 n=3*32 no_mans_land=t 
                    use_data_hub=f do_check_nan=f dt_fixed=-1 /
&snapshot_params    verbose=0 
                    meshfile='input_data/qs006023/qs006023_t007.mesh'
                    snapfile='input_data/qs006023/qs006023_t007_600.snap' 
                    model='bifrost'
                    flip_z=t verbose=0
                    b0=0.0,0.0,0.0 
                    /
&gravity_params     on=t constant=-27400 axis=3 position=0.0 mass=-1 minrad=-1 /
&newton_params      on=f axis=3 position=0.5 scale=3. ee0=61.72 ee1=1.2 time=0.2 /
&eos_params
 table_loc = 'input_data/qs006023'
 !table_loc = '../../data/eos/square_gas'
   /

&spitzer_conductivity_params
 on=f
/

! -- RT parameters -------------------------------------------------------------
&rt_setup_params    on=f verbose=0 /
&rt_integral_params verbose=0 dtau_min=1e-1 dtau_dif=1e1 dtau_max=1e2
                    solver=2 order=1 /
&sc_rt_params       on =t verbose=0 nt=3 n_mu=2 n_phi=4 n_bin=4
                    rt_grace=0.05 rt_llc=0,0,-1.9 rt_urc=6,6,6.9
                    n_warmup=12 rt_freq=1.0 cdtd=0.1 dnload_mhd=t/
&hybrid_rt_params   /

! -- I/O parameters ------------------------------------------------------------
&io_params          verbose=0 do_trace=f omp_trace=f do_output=t id_debug=0
                    restart=-1  guard_zones=t nml_version=1 /
&out_params         end_time=100.101 out_time=0.01 print_time=0 /
&aux_params         select='tt','qr','rkap','src', 'qspitz' /

! -- Stagger code parameters ---------------------------------------------------
                    !   cs    pa   ofd  mas   kap  eta
&stagger_params     nu= 0.1, 1.0, 1.0, 0.0, 1.0, 1.0 gamma=1.666667 verbose=0
eos='tabular'
                    do_maxwell=f do_temperature=t courant=0.15 /

&non_ideal_params   mhd_Ohm=f eta_Ohm=0.01 mhd_AD=f /
&timestep_params    time_order=2 /

! -- Task control parameters ---------------------------------------------------
&timer_params       sec_per_report=20 verbose=0 /
&task_list_params   job_seconds=1e6 /
&dispatcher_params  method=0 /
&dispatcher3_params verbose=0 f_over=3 use_taskyield=f use_critical=f /
&task_mesg_params   verbose=0 /
&mpi_mesg_params    verbose=0 debug=f /

&refine_params          on=f levelmax=9 levelmin=1 verbose=3 check_interval=2 /

&download_params order_interpolator=-1 /


&bifrost_params             
gamma=1.6666667
loginterpolation=t
ca_max = 100.0 
courant=0.15
max_r=3
symmetric_e=f
do_temperature=t
!nu_d_high = 0.2
!nu_e_high = 0.2
!nu_d_tr_loc = 0.5
!nu_e_tr_loc = 0.5
eos='tabular'
!     nu1   nu2  nu3  nu_d  nu_ee  eta3
!nu=  0.6, 0.6, 0.6, 0.6, 0.6, 0.3 /
!nu=  0.3, 0.2, 0.3, 0.0, 0.3, 0.3 /
!nu=  0.03 , 0.3,  0.1,  0.05,  0.05, 0.8 /
nu=  0.05 , 0.2,  0.4,  0.07,  0.03, 0.3 /
!nu=  0.01, 0.03, 0.1, 0.05, 0.05, 0.3 /

&ramses_params
 courant_factor=0.5
 csound=1.0
 gamma=1.6666667
 do_temperature=t
 slope_type=3
 !smallr=1e-8
 !smallc=1e-8
 !smallr=1e-3
 ! smallc=1e-2
 divb_iter=0
 unsigned=f
 convert_e=f
/

&non_ideal_params
 mhd_Ohm=f
 eta_Ohm=0.01
 mhd_AD=f
/

&divb_clean_params
 on=f
 divb_iter=4
 divb_cleaner=0
 /
