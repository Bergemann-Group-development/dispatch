! -- Parameters defining the run -----------------------------------------------
&snapshot_params    verbose=0 flip_z=t force_mean=f extension=1 order=2 b0=0.0,0.0,0.0 
                    model='stagger'
                    meshfile='../../data/stellar_atmospheres/mhd63.msh'
                    snapfile='../../data/stellar_atmospheres/mhd63.dat' /
&cartesian_params   size=6,6,3 dims=6,6,3 mpi_dims=2,2,1 origin=0,0,-2.5
                    omp_init=t periodic=t,t,f /
&patch_params       nt=5 grace=0.1 n=3*32 do_check_nan=f /
&experiment_params  /
&boundary_params    verbose=0 bottom_bc_rate=0.01 top_bc_rate=0.01 scale=t 
                    divb_iter=4 damp_rate=0.2 r_sponge=0.5 deriv_bnd=f upper_bc=2 lower_bc=3/
&gravity_params     on=t axis=3 position=0.0 constant=-27500 mass=-1 minrad=-1 /
&newton_params      on=t axis=3 position=0.5 scale=0.1 time=0.2 / !ee0=5.2155 

&pressure_node_params
                    on=t
                    t_bdry=3.0
                    bottom_bc_rate=0.01
                    pb_fact=1.0
/

! -- RT parameters -------------------------------------------------------------
&rt_setup_params    on=t verbose=0 /
&rt_integral_params verbose=0 dtau_min=1e-3 dtau_dif=1e3 dtau_max=1e4 solver=2 order=1 /
&sc_rt_params       on=f verbose=0 nt=5 n_mu=2 n_phi=4 n_bin=4 rt_grace=0.05
                    rt_llc=0,0,-1.4 rt_urc=6,6,0.45 dnload_mhd=f
                    n_warmup=6 cdtd=0.05 rt_freq=1.0 /

! -- I/O parameters ------------------------------------------------------------
&io_params          verbose=0 do_trace=f omp_trace=t do_output=t id_debug=0 guard_zones=t /
&out_params         end_time=100.101 out_time=0.05 print_every=30 /
&aux_params         verbose=0 select='tt','pg','qr' /

! -- Solver parameters ---------------------------------------------------------
&eos_params         gamma=1.2 /
&bifrost_params     loginterpolation=t ca_max = 100.0 courant=0.2 max_r=3
                    symmetric_e=f do_temperature=t eos='tabular'
                    !     nu1   nu2  nu3  nu_d  nu_ee  eta3
                    nu=  0.05 , 0.2,  0.4,  0.07,  0.03, 0.3 /
&ramses_params      verbose=0 courant_factor=0.1 slope_type=3.5 /
&stagger_params     verbose=0 courant=0.15 mhd=t
                    !   cs    pa   ofd  mas   kap  eta
                    nu= 0.03, 1.0, 1.0, 0.00, 1.0, 1.0 /
&divb_clean_params  on=f divb_iter=4 divb_cleaner=0 /

! -- Task control parameters ---------------------------------------------------
&halo_params        check_filled=f /
&timer_params       sec_per_report=20 verbose=0 /
&lock_params        verbose=1 alternate_time=300 /
