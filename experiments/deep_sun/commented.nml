! -- Parameters defining the run -----------------------------------------------
&snapshot_params
 verbose=0                              ! noise level
 flip_z=t                               ! t: z=up, f: z=down
 force_mean=f                           ! ?
 extension=1                            ! ?
 order=2                                ! ?
 b0=0.0,0.0,0.0                         ! initial B-field
 model='stagger'                        ! model type
 meshfile='input_data/mhd63.msh'        ! mesh file
 snapfile='input_data/mhd63.dat'        ! data file
/
&cartesian_params
 size=6,6,3                             ! size in code units
 dims=6,6,3                             ! patches per direction
 mpi_dims=2,2,1                         ! MPI distribution
 origin=0,0,-2.5                        ! zero point of scales
 omp_init=t                             ! distribute data over cores
 periodic=t,t,f                         ! periodic horizontally
/
&patch_params
 nt=5                                   ! time slices
 n=3*32                                 ! number of cells per patch
 grace=0.1                              ! allowed time-extrapolation
 do_check_nan=f                         ! check for NaN (slow!)
/
&experiment_params
/
&boundary_params
 verbose=0                              ! noise level
 bottom_bc_rate=0.01                    ! rate of change of bottom BC
 top_bc_rate=0.01                       ! rate of change of top BC
 scale=t                                ! ?
 divb_iter=4                            ! number of divB cleaner iterations
 damp_rate=0.2                          ! damping rate
 r_sponge=0.5                           ! sponge size at boundary
 deriv_bnd=f                            ! ?
/
&gravity_params
 on=t                                   ! on/off
 axis=3                                 ! z-axis
 position=0.0                           ! origin
 constant=-27500                        ! acceleration of gravity
 mass=-1                                ! ?
 minrad=-1                              ! ?
/
&newton_params
 on=t                                   ! on/off
 axis=3                                 ! z-axis
 position=0.5                           ! location
 scale=0.1                              ! transition interval
 time=0.2                               ! cooling time
 !ee0=5.2155                            ! energy level 0
 ee1=0.3                                ! energy level 1
/

! -- RT parameters -------------------------------------------------------------
&rt_setup_params
 on=t                                   ! on/off
 verbose=0                              ! noise level
/
&rt_integral_params                     ! integral RT solver
 verbose=0                              ! noise level
 dtau_min=1e-3                          ! solver specific
 dtau_dif=1e3                           ! solver specific
 dtau_max=1e4                           ! solver specific
 solver=2                               ! type of solver
 order=1                                ! solver order
/
&sc_rt_params                           ! short characteristics solver
 on=t                                   ! on/off
 verbose=0                              ! noise level
 nt=5                                   ! time slices
 n_mu=2                                 ! number of mu points
 n_phi=4                                ! number of phi points
 n_bin=4                                ! number of opacity bins
 rt_grace=0.05                          ! allowed time-extrapolation
 rt_llc=0,0,-1.4                        ! lower corner of RT
 rt_urc=6,6,0.45                        ! upper corner of RT
 dnload_mhd=f                           ! ?
 n_warmup=6                             ! initial warmup iterations
 vertical_propagation=f                 ! ?
 cdtd=0.05                              ! ?
 rt_freq=1.0                            ! RT solution cadence
/

! -- I/O parameters ------------------------------------------------------------
&io_params
 verbose=0                              ! noise level
 guard_zones=t                          ! include guard zones in I/O
 do_output=t                            ! I/O on/off
 do_trace=f                             ! trace procedure calls
 omp_trace=t                            ! separate thread logs
 id_debug=0                             ! task number for debug output
/
&out_params
 end_time=1.0                           ! end of run
 out_time=0.1                           ! output cadence
 print_every=30                         ! log file task cadence
/
&aux_params
 verbose=0                              ! noise level
 select='tt','pg','qr'                  ! selected auxiliary output
/

! -- Solver parameters ---------------------------------------------------------
&eos_params                             ! Equation Of State
 gamma=1.2                              ! approximate gamma for Riemann solver
/
&bifrost_params
 loginterpolation=t                     ! ?
 ca_max=100.0                           ! max fast mode speed
 courant=0.2                            ! Courant number
 max_r=3                                ! ?
 symmetric_e=f                          ! ?
 do_temperature=t                       ! compute temperature
 eos='tabular'                          ! type of EOS handler
 !     nu1  nu2  nu3  nu_d  nu_ee  eta3
 nu=  0.05, 0.2, 0.4, 0.07, 0.03,  0.3  ! artificial viscosity parameters
/
&ramses_params
 verbose=0                              ! noise level
 courant_factor=0.25                    ! Courant number
 slope_type=3.5                         ! slope limiter type
/
&stagger_params
 verbose=0                              ! noise level
 courant=0.15                           ! Courant number
 do_temperature=t                       ! compute temperature
 eos='tabular'                          ! type of EOS handler
 !   cs    pa   ofd  mas   kap  eta
 nu= 0.03, 1.0, 1.0, 0.00, 1.0, 1.0     ! artificial viscosity parameters
/
&divb_clean_params
 on=f                                   ! on/off
 divb_iter=4                            ! numeber of iterations
 divb_cleaner=0                         ! type of cleaner
/

! -- Task control parameters ---------------------------------------------------
&halo_params
 check_filled=f                         ! check that guard zones are filled
/
&timer_params
 sec_per_report=20                      ! cadence of performance reports
 verbose=0                              ! noise level
/
&lock_params
 verbose=1                              ! noise level
 alternate_time=300                     ! cadence of alternating file names
/
