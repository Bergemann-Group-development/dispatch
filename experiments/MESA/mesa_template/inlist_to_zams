&star_job
      load_saved_model = .true.
      saved_model_name = 'model_r12115_10mjup.mod'
	  set_initial_cumulative_energy_error = .true.


      save_model_when_terminate = .true.
      save_model_filename = 'near_zams.mod'
      required_termination_code_string = 'Lnuc_div_L_zams_limit'

      write_profile_when_terminate = .false.

/ ! end of star_job namelist


&controls

    !report_hydro_solver_progress = .true.
    !report_ierr = .true.
    !report_bad_negative_xa = .true.



    newton_iterations_limit = 30
    max_tries = 50


	mass_change=1e-6
	max_surface_cell_dq = 1d-12
	mesh_delta_coeff = 0.5
	use_gold_tolerances = .false.
    !steps_before_use_gold_tolerances = 10
    use_dedt_form_of_energy_eqn = .false.
    !Lnuc_div_L_zams_limit = 0.9d0
    !stop_near_zams = .true.
	  
/ ! end of controls namelist



&pgstar


/ ! end of pgstar namelist
