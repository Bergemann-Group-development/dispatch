
&star_job

      required_termination_code_string = 'xa_central_lower_limit'

      show_log_description_at_start = .false.

      eos_file_prefix = 'mesa'
      kappa_file_prefix = 'gs98'
      kappa_lowT_prefix = 'lowT_Freedman11'

      set_uniform_initial_composition = .true.
      initial_h1 = 0.70
      initial_h2 = 2e-5
      initial_he3 = 2.98e-5
      initial_he4 = 0.28
      
      h_he_net = 'pp_extras.net'
      show_net_species_info = .true.

      change_v_flag = .true.
      new_v_flag = .true.

      set_initial_age = .true.
      initial_age = 0

      set_initial_model_number = .true.
      initial_model_number = 0

      new_omega_div_omega_crit = 0.0d0 ! EDIT THIS TO SET ROTATION
      
      ! edit x_ctrl(21) in inlist_set_alpha_mlt to set MLT alpha in H envelope

      !pgstar_flag = .true.
      pgstar_flag = .false.
      disable_pgstar_for_relax = .true.

      logT_for_conv_vel_flag = 8.5d0

      create_pre_main_sequence_model = .true.

      !relax_mass_scale = .true.
      !dlgm_per_step = 1d-3 ! log10(delta M/Msun/step)
      !new_mass = 2.863362d-3 ! 3 Mjupiter in Msun units
      !new_mass = 0.01 ! 3 Mjupiter in Msun units
      !change_mass_years_for_dt = 1

/ ! end of star_job namelist


&controls

      use_gold_tolerances = .true.

      use_dedt_form_of_energy_eqn = .true.
      min_energy_for_dedt_form_of_energy_eqn = 1d13
      min_cell_energy_fraction_for_dedt_form = 1d-10

      ignore_too_large_correction = .true. ! for conv_vel's

      limit_for_rel_error_in_energy_conservation = 1d-4
      hard_limit_for_rel_error_in_energy_conservation = 1d-3

      num_trace_history_values = 3
      trace_history_value_name(1) = 'rel_E_err'
      trace_history_value_name(2) = 'log_rel_run_E_err'
      trace_history_value_name(3) = 'radius'

      ! check for retries and backups as part of test_suite
      max_number_retries = 10000
      max_number_backups = 1000
      max_model_number = 100000

      retry_limit = 100

      initial_mass = 1.0

      !max_star_mass_for_gain = 10.0
      !mass_change = 1e-5

      !----- Make sure we use a network with deuterium for proper PMS evolution -------
      default_net_name = 'pp_extras.net'

      !----- Accrete at a given metallicity. Same as initial composition -------
      accrete_same_as_surface = .false.
      accretion_h1 = 0.70 ! mass fraction
      accretion_h2 = 2e-5 ! if no h2 in current net, then this is automatically added to h1
      accretion_he3 = 2.98E-5
      accretion_he4 = 0.28
      accretion_zfracs = 3

      !---------------------------
      ! limit for change in mdot
      delta_mdot_atol = 1d-5 ! Msun/yr --- tolerance for absolute changes
      delta_mdot_rtol = 3.0 ! tolerance for relative changes

      !Pextra_factor = -1 ! keep the old form for now

      ! high center T limit to avoid negative mass fractions
      sig_min_factor_for_high_Tcenter = 0.01
       ! inactive when >= 1d0
         ! if Tcenter >= Tcenter_min_for_sig_min_factor_full_on,
         ! then okay to reduce sig by as much as this factor
         ! as needed to prevent causing negative abundances
      Tcenter_min_for_sig_min_factor_full_on = 3.2d9
         ! if Tcenter >= this, factor = sig_min_factor_for_neg_abundances
         ! this should be > Tcenter_max_for_sig_min_factor_full_off.
      Tcenter_max_for_sig_min_factor_full_off = 2.8d9
         ! if Tcenter <= this, factor = 1, so has no effect
         ! this should be < Tcenter_min_for_sig_min_factor_full_on.
      ! for T > full_off and < full_on, factor changes linearly with Tcenter

      velocity_logT_lower_bound = 8 
      max_dt_yrs_for_velocity_logT_lower_bound = 0.1
 
      dX_nuc_drop_limit = 5d-2
      dX_nuc_drop_limit_at_high_T = 5d-3 ! for center logT > 9.45

      
      delta_Ye_highT_limit = 1d-3

      okay_to_reduce_gradT_excess = .true. 
         
      gradT_excess_f1 = 1d-4
      gradT_excess_f2 = 1d-2
      gradT_excess_age_fraction = 0.9d0

      gradT_excess_lambda1 = 1.0
      gradT_excess_beta1 = 0.35
      
      gradT_excess_lambda2 = 0.5
      gradT_excess_beta2 = 0.25
      
      gradT_excess_dlambda = 0.1
      gradT_excess_dbeta = 0.1

      !gradT_excess_lambda1 = -1 ! force MLT++

      use_other_alpha_mlt = .true.
      x_ctrl(21) = 3.0 ! alpha_H
      x_ctrl(22) = 1.5 ! alpha_other
      x_ctrl(23) = 0.5 ! H_limit 
         ! use alpha_H if cell X >= H_limit; else use alpha_other

      thermohaline_coeff = 0
      Dutch_scaling_factor = 0.0 ! EDIT THIS TO SET WIND

      !min_overshoot_q = 1d0      ! =1 TURNS OFF OVERSHOOTING

      overshoot_scheme(1) = 'exponential'
      overshoot_zone_type(1) = 'any'
      overshoot_zone_loc(1) = 'any'
      overshoot_bdy_loc(1) = 'any'
      overshoot_f(1) = 0.010
      overshoot_f0(1) = 0.004

      when_to_stop_rtol = 1d-3
      when_to_stop_atol = 1d-3

      !hot_wind_full_on_T = 1d0
      !cool_wind_full_on_T = 0d0
      hot_wind_scheme = 'Dutch'
      Dutch_wind_lowT_scheme = 'de Jager'

      !varcontrol_target = 1d-4
      mesh_delta_coeff = 2.0
      mesh_delta_coeff_for_highT = 2.5
      !mesh_delta_coeff = 0.75
      !mesh_delta_coeff_for_highT = 1.5
      logT_max_for_standard_mesh_delta_coeff = 9.0 
      logT_min_for_highT_mesh_delta_coeff = 9.6 

      am_nu_visc_factor = 0
      am_D_mix_factor = 0.0333333333333333d00
      D_DSI_factor = 0
      D_SH_factor = 1
      D_SSI_factor = 1
      D_ES_factor = 1
      D_GSF_factor = 1
      D_ST_factor = 1

      he_core_boundary_h1_fraction = 0.5
      c_core_boundary_he4_fraction = 0.5
      o_core_boundary_c12_fraction = 0.5
      si_core_boundary_o16_fraction = 0.5

      Lnuc_div_L_zams_limit = 0.8d0

      ignore_too_large_correction = .true. ! for conv_vel's

      xa_central_lower_limit_species(1) = 'he4'
      xa_central_lower_limit(1) = 1d-6

/ ! end of controls namelist


&pgstar

      read_extra_pgstar_inlist1 = .true.
      extra_pgstar_inlist1_name = 'inlist_massive_defaults'

      read_extra_pgstar_inlist2 = .true.
      extra_pgstar_inlist2_name = 'inlist_common'

      read_extra_pgstar_inlist3 = .true.
      extra_pgstar_inlist3_name = 'inlist_to_zams'

/ ! end of pgstar namelist
