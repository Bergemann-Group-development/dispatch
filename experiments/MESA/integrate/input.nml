s $Id$

!--- Sink particle parameters --------------------------------------------------
&sinks_params           verbose=1 jeans_limit=4 per_omega=0.5 /
&mesa_params            verbose=2 mesa_threshhold_msun=0.5 /

!--- Experiment setup ----------------------------------------------------------
&cartesian_params       size=1,1,1 dims=3*4 mpi_dims=1,1,1 origin=0,0,0 /
&patch_params           nt=5 grace=0.1 n=3*16 no_mans_land=t /
&out_params             end_time=2 out_time=0.010 print_every=50 /
&io_params              verbose=0 do_trace=f omp_trace=t do_output=t
                        method='parallel' format=10 guard_zones=f time_derivs=0 /
&aux_params             select='sink_m','sink_p','sink_v' /
&download_params        verbose=0 check_filled=t /

!--- Initial condition and forces ----------------------------------------------
&experiment_params      l_pc=5 n_H2=240 cs_kms=0.18 /
&scaling_params         l_pc=5 n_H2=240 v_kms=0.18 mu=2.4 /
&initial_params         type='turbulence' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=2 t_turn=0.05 k1=1 k2=2 pk=0.0 seed=5 
                        verbose=0 t_damp=3e-4 /
&IC_turbulence_params   b0=0.0 /
&selfgravity_params     selfgravity=f /
&restart_params         run='previous_run' iout=1 /

!--- Solver specific parameters ------------------------------------------------
&cooling_params         on=f verbose=0 type=0 /
&flux_params            on=f verbose=0 /
&ramses_params          courant_factor=0.250 gamma=1.0 slope_type=3.5
                        smallr=1e-3 smallc=0.1 detailed_timer=f /
&refine_params          on=f check_interval=2 /

!--- Dispatcher and task list params -------------------------------------------
&dispatcher_params      method=0 test=f /
&dispatcher0_params     verbose=0 retry_stalled=1e4 max_stalled=1e4 /
&task_list_params       verbose=0 /
&timer_params           sec_per_report=15 detailed=f /

!--- MPI and loadbalancing parameters ------------------------------------------
&load_balance_params    /
&task_mesg_params       verbose=0 /
&mpi_mesg_params        verbose=0 /
