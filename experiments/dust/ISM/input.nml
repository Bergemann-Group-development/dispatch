!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=1 gamma=1d0 T_K=10 /
&scaling_params         l_pc=5 n_H2=240 v_kms=1.0 /
&cartesian_params       size=3*1.0 dims=3*4 mpi_dims=1,1,2 origin=3*-0.5 /
&patch_params           n=3*16 grace=0.1 /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params verbose=1 courant=1.0 detailed_timer=f /
&dust_params            verbose=1 n_bin=1 particles_per_bin=10 /

!--- Initial condition and forces ----------------------------------------------
&initial_params         type='turbulence' /
&IC_turbulence_params   b0=0.0 /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=1.4 t_turn=1.0 k1=1 k2=2 pk=0.0 seed=5 
                        verbose=0 /
&selfgravity_params     selfgravity=f /
&trace_particle_params  on=f verbose=0 per_cell=1.0 /

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=t
                        do_output=t method='legacy' format=10
                        guard_zones=f time_derivs=0 /
&out_params             end_time=0.5 out_time=0.10 print_every=30 /
&timer_params           sec_per_report=15 /
&aux_params             verbose=2 select='dust_d' /

!--- Solver parameters ---------------------------------------------------------
&ramses_params          gamma=1.0 csound=0.18 courant_factor=0.25 slope_type=2 /
