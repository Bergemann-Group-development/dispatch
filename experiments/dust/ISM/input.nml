!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=0 gamma=1d0 T_K=10 /
&scaling_params         l_pc=1 n_H2=1200 v_kms=1.0 /
&cartesian_params       size=3*1.0 dims=3*4 mpi_dims=1,1,2 origin=3*-0.5 /
&patch_params           n=3*20 grace=0.2 /
&selfgravity_params     selfgravity=f /
&poisson_params         verbose=1 solver='sor' /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params verbose=0 n_bin=3 particles_per_bin=10
                        out_time=1e-2 output_every=80
                        min_size_cgs=3e-7 max_size_cgs=3e-4 /
&dust_params            on=f verbose=0 /
&dust_cell_params       on=t verbose=0 n_bin=1 particles_per_bin=30
                        min_fraction=0.4 max_fraction=2
                        min_size_cgs=1e-5 max_size_cgs=1e-5 /

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=t
                        do_output=t method='legacy' format=10
                        guard_zones=f time_derivs=0 /
&out_params             end_time=0.101 out_time=0.01 print_every=30 /
&timer_params           sec_per_report=15 /
&aux_params             verbose=0 select='dust_d','dust_vrms','dust_vx','dust_vy','dust_vz' /

!--- RAMSES solver parameters --------------------------------------------------
&ramses_params          gamma=1.0 csound=0.18 courant_factor=0.25 slope_type=3 /
&initial_params         type='void' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=0.45 t_turn=0.45 k1=1 k2=2 pk=0.0 seed=5 
                        verbose=0 /
