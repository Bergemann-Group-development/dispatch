!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=0 gamma=1d0 T_K=10 /
&scaling_params         l_pc=1 n_H2=1200 v_kms=1.0 /
&cartesian_params       size=3*1.0 dims=3*6 mpi_dims=1,1,2 origin=3*-0.5 /
&patch_params           n=3*16 grace=0.3 /
&selfgravity_params     selfgravity=f /
&poisson_params         verbose=1 solver='sor' /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params on=t verbose=1 n_bin=1 particles_per_bin=20
                        particle_io=f out_time=1e-2 output_every=80
                        min_size_cgs=3e-7 max_size_cgs=3e-4 /
&dust_params            on=f verbose=0 /

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=t
                        do_output=f method='legacy' format=10
                        guard_zones=f time_derivs=0 /
&out_params             end_time=0.05 out_time=0.01 print_every=100 /
&timer_params           sec_per_report=5 /
&aux_params             verbose=0 select='dust_d','dust_vrms','dust_vx','dust_vy','dust_vz' /

!--- RAMSES solver parameters --------------------------------------------------
&eos_params             gamma=1d0 /
&ramses_params          csound=0.18 courant_factor=0.25 slope_type=3 /
&IC_params              type='void' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=0.45 t_turn=0.45 k1=1 k2=2 pk=0.0 seed=5 
                        verbose=0 /

&lock_params            verbose=0 /
