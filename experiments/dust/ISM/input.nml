!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=1 gamma=1d0 T_K=10 /
&scaling_params         l_pc=5 n_H2=240 v_kms=1.0 /
&cartesian_params       size=3*1.0 dims=3*8 mpi_dims=1,1,2 origin=3*-0.5 /
&patch_params           n=3*16 grace=0.1 /
&selfgravity_params     selfgravity=f /
&poisson_params         verbose=1 solver='sor' /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params verbose=0 courant=0.5 detailed_timer=f
                        / !ip_dbg=2628992 i_dbg=20,3,3,7,1 /
&dust_params            verbose=0 n_bin=3 min_size_cgs=3e-8 max_size_cgs=3e-1
                        particles_per_bin=120 /

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=t
                        do_output=t method='legacy' format=10
                        guard_zones=f time_derivs=0 /
&out_params             end_time=0.5 out_time=0.1 print_every=30 /
&timer_params           sec_per_report=15 /
&aux_params             verbose=0 select='dust_d' /

!--- RAMSES solver parameters --------------------------------------------------
&ramses_params          gamma=1.0 csound=0.18 courant_factor=0.25 slope_type=2 /
&initial_params         type='void' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=1.4 t_turn=1.0 k1=1 k2=2 pk=0.0 seed=5 
                        verbose=0 /

! -- Stagger code parameters ---------------------------------------------------
                        !   cs    pa   ofd  mas   kap  eta
&stagger_params         nu= 0.03, 1.0, 1.0, 0.00, 1.0, 1.0 gamma=1.4 eos='ideal'
                        do_temperature=f courant=0.15 /
&timestep_params        time_order=2 /
