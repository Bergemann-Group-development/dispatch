!-------------------------------------------------------------------------------
! This run starts from t=0, with particles, to test & validate start_time and
! out_time for particles, before moving on to restarting with particles.
!-------------------------------------------------------------------------------

!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=0 T_K=10 /
&scaling_params         l_pc=1 n_H2=1200 v_kms=1.0 /
&cartesian_params       size=3*1.0 dims=3*8 mpi_dims=1,1,1 origin=3*-0.5 /
&patch_params           n=3*16 grace=0.3 dt_fixed=-1e-4 /
&selfgravity_params     selfgravity=f /
&poisson_params         verbose=1 solver='sor' /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params on=t verbose=0 n_bin=3 particles_per_bin=10
                        particle_io=t start_time=2.1 out_time=0.05 output_every=100
                        dust_to_gas=1e-2
                        min_size_cgs=1e-5 max_size_cgs=1e0 max_init_size_cgs=1e-2 /
&dust_evolve_params     on=f verbose=0 do_implicit=t detailed_timer=t
                        max_fraction1=0.5 max_fraction2=0.05 /

!--- Input/Output parameters ---------------------------------------------------
!&restart_params         snapshot=2 run='run1' /
&io_params              verbose=0 do_trace=f omp_trace=t
                        do_output=t
                        !method='legacy'
                        !method='background'
                        method='parallel'
                        guard_zones=t time_derivs=0 /
&out_params             start_time=0.5 end_time=0.51 out_time=0.1
                        print_every=900 /
&timer_params           sec_per_report=5 /
&lock_params            verbose=1 /
&aux_params             verbose=0
                        select='dust_d','dust_vrms','dust_s',
                        'dust_vx','dust_vy','dust_vz' /

!--- RAMSES solver parameters --------------------------------------------------
&eos_params             gamma=1d0 /
&ramses_params          csound=0.18 courant_factor=0.25 slope_type=3 /
&IC_params              type='void' /
&force_params           type='turbulence' /
&turbulence_params      ampl_turb=0.45 t_turn=0.45 k1=1 k2=2 pk=0.0 seed=5
                        verbose=0 t_damp=0.01 /

