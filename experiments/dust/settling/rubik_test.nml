!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=1 scale_height=0.8 d_midplane_cgs=1e-11 /
&cartesian_params       size=3*2.0 dims=3*3 mpi_dims=1,1,3 origin=3*-1.0 /
&patch_params           n=3*16 grace=0.1 /
&scaling_params         d=1e-9 /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params verbose=0 v_min=1 courant=0.1 detailed_timer=f /
&dust_params            verbose=0 min_fraction=0.7 max_fraction=1.4
                       !n_bin=3 cadence=10 growth_rata=1e-10 particles_per_bin=20       ! 3 bins (commented out)
                        n_bin=1 cadence=0  growth_rate=1e-20 particles_per_bin=50       ! 1 bin
/

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=t do_output=t
                        method='legacy' guard_zones=f time_derivs=0 /
&out_params             end_time=50.0 out_time=2.00 print_every=10 /
&timer_params           sec_per_report=5 /
&aux_params             select='dust_d' /

!--- Solver parameters ---------------------------------------------------------
&muscl_params           gamma=1.0 courant=0.25 slope_type=2 method='hllc' /
&ramses_params          gamma=1.0 courant_factor=0.25 slope_type=2 /
&stagger_params         gamma=1.0 courant=0.20 /
