!---  Setup parameters ---------------------------------------------------------
&scaling_params         orbit_au=1                ! orbital size in AU
                        temperature_K=300         ! isothermal temperature
                        mass_msun=1               ! mass of star in solar masses
                        surface_density_cgs       ! surface density in cgs
/
&experiment_params      verbose=1                 ! information level
/
&cartesian_params       size=3*5.0                ! physical size in scale heights
                        origin=3*-2.5             ! offset of lower left corner
                        dims=3*3                  ! patch distribution (3x3x3)
                        mpi_dims=1,1,3            ! MPI distibution (not yet)
/
&patch_params           n=3*16                    ! cells per patch (16x16x16)
                        grace=0.1                 ! allowed time extraplation
/

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params verbose=0                 ! information level
                        v_min=1                   ! floor of assume gas speed
                        courant=1                 ! fraction of cell to move
                        detailed_timer=f          ! fine grained cost 
/
&dust_params            verbose=0                 ! information level
                        seed=11                   ! random seed
                        n_bin=6                   ! number of bins
                        cadence=30                ! dust evolution cadence
                        growth_rate=0.01          ! rate of increasing size
                        particles_per_bin=10      ! particles per cell-bin
                        min_fraction=0.7          ! of particles_per_bin
                        max_fraction=0.7          ! of particles_per_bin
                        d_min_cgs=1e-15           ! don't reduce weights further
                        solid_density_cgs=2       ! 2 g/cm**3
                        density_yr_cgs=1e-12      ! gas density for 1 yr stopping time @ 1 cm
                        dust_time=0.001           ! how often to do dust evolution
                        growth_rate=1e-9          ! naiive parameter for test_kernel
/

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0                 ! information level
                        do_trace=f                ! write a trace report to stdout?
                        omp_trace=f               ! redirect to data/rank_RRRRR.log
                        do_output=t               ! write binary output into data/
                        method='parallel'         ! ('legacy' => many files)
                        guard_zones=f             ! include guard zones?
/
&out_params             end_time=0.10             ! end-of-run time
                        out_time=0.10             ! output cadence
                        print_every=10            ! cadence of task-update log info
/
&timer_params           sec_per_report=10         ! cadence (seconds) of cost table
/

!--- Solver parameters ---------------------------------------------------------
&ramses_params                                    ! for SOLVER=ramses/hydro
                        gamma=1.0                 ! gas gamma
/
&muscl_params                                     ! for SOLVER=muscl
                        gamma=1.0                 ! gas gamma
                        method='hllc'             ! Riemann method
/
&stagger_params                                   ! for SOLVDER=stagger2/e
                        gamma=1.0                 ! gas gamma
/
