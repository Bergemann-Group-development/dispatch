!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=2 /
&scaling_params         orbit_au=1 temperature_K=47.596484 mass_msun=0.87096359
                        surface_density_cgs=158.1706 /
&cartesian_params       size=3*5.0 dims=3*3 mpi_dims=1,1,3 origin=3*-2.5 
                        periodic=t,t,f /
&patch_params           n=3*16 grace=0.1 /

!--- Dust and particle solver parameters ---------------------------------------
&particle_solver_params verbose=2 courant=1.0 detailed_timer=f id_dbg=-1 /
&dust_params            verbose=0 n_bin=1 min_size_cgs=0.1 max_size_cgs=0.1
                        solid_density_cgs=1 growth_rate=0
                        particles_per_bin=20 min_fraction=0.7 max_fraction=1.4 /

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=t do_output=t
                        method='legacy' guard_zones=f time_derivs=0 /
&out_params             end_time=5.00 out_time=0.50 print_every=20 /
&timer_params           sec_per_report=15 /
&aux_params             verbose=2 select='dust_d' /

!--- Solver parameters ---------------------------------------------------------
&muscl_params           gamma=1.0 courant=0.25 slope_type=2 method='hllc' /
&ramses_params          gamma=1.0 courant_factor=0.25 slope_type=2 /
&stagger_params         gamma=1.0 courant=0.20 /
