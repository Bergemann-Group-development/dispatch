!---  Setup parameters ---------------------------------------------------------
&experiment_params      verbose=1 scale_height=1.0 /
&cartesian_params       size=3*5.0 dims=3*3 mpi_dims=1,1,3 origin=3*-2.5 /
&patch_params           n=3*16 grace=0.1 /
!download_params        order_time=1 /

!--- Input/Output parameters ---------------------------------------------------
&io_params              verbose=0 do_trace=f omp_trace=f do_output=t
                        method='parallel' guard_zones=f time_derivs=0 /
&out_params             end_time=0.10 out_time=0.10 print_every=10 /
&timer_params           sec_per_report=10 /

!--- Solver parameters ---------------------------------------------------------
&muscl_params           gamma=1.0 courant=0.25 slope_type=2 method='hllc' /
&ramses_params          gamma=1.0 courant_factor=0.25 slope_type=2 /
&stagger_params         gamma=1.0 courant=0.20 /
