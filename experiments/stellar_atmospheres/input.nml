
! -- Parameters defining the run -----------------------------------------------
&experiment_params  verbose=0 d_bot=231.8 e_bot=2897.0 top_temperature=4500
                    smudge_boundary=f /
&cartesian_params   size=6,6,3 dims=6,6,3 mpi_dims=4,4,1 origin=0,0,-0.5
                    omp_init=f /
&patch_params       do_check_nan=t nt=5 grace=0.05 n=3*20 no_mans_land=t
                    use_data_hub=f dt_fixed=-1 periodic=t,t,f /
&snapshot_params    order=1 verbose=0 meshfile='input_data/mhd63.msh'
                    snapfile='input_data/mhd63.dat' model='stagger'
                    b0=-1.0 flip_z=f /
&gravity_params     on=t constant=27500 axis=3 position=0.0 mass=-1 minrad=-1 /
&sc_rt_params       on=t verbose=0 nt=1 n_mu=2 n_phi=4 n_lambda=4 rt_timestep=0.005
                    rt_grace=0.0 rt_llc=0,0,-0.5 rt_extent=6,6,0.45
                    vertical_propagation=t /
&rt_setup_params    verbose=0 n_warmup=2 unique_ids=t omp_warmup=f /
&hybrid_rt_params   /
&eos_params         /
&download_params    /

! -- I/O parameters ------------------------------------------------------------
&io_params          verbose=0 do_trace=f omp_trace=f do_output=t id_debug=0
                    restart=-1  guard_zones=t nml_version=1 /
&out_params         end_time=25.00 out_time=0.05 print_time=0 /

! -- Stagger code parameters ---------------------------------------------------
                    !   cs    pa   ofd  mas   kap  eta
&stagger_params     nu= 0.03, 1.0, 1.0, 0.05, 1.0, 1.0 gamma=1.4 eos='tabular'
                    courant=0.15 /
&non_ideal_params   mhd_Ohm=f eta_Ohm=0.01 mhd_AD=f /
&timestep_params    time_order=2 /

! -- Task control parameters ---------------------------------------------------
&timer_params       sec_per_report=20 /
&task_list_params   job_seconds=1e6 /
&dispatcher_params  method=6 /
&dispatcher3_params verbose=0 f_over=3 use_taskyield=f use_critical=f /
&task_mesg_params   verbose=0 /
&mpi_mesg_params    verbose=0 debug=f /

