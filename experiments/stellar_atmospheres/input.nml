&rt_params              n_mu=2 n_phi=3 n_bin=4 verbose=0 rt_time=0.01 vertical_propagation=f /

&io_params              verbose=0 do_trace=f do_output=t method='parallel' id_debug=0 /
&cartesian_params       size=6,6,3 dims=2*6,3 origin=0,0,-0.5 /
&patch_params           nt=5 grace=0.0 n=3*32 no_mans_land=t use_data_hub=f dt_fixed=-1 /
