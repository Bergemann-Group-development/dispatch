
&experiment_params      verbose=0 d_bot=38949.6 e_bot=1.74062e+6 /
&ic_params              verbose=0 file='48h5' order=1 /

&rt_params              verbose=0 nt=3 n_mu=1 n_phi=4 n_bin=4 rt_time=0.002
                        dtau_min=1e-6 dtau_dif=1e3 dtau_max=1e4 grace=0
                        order=0 dbg_position=2*-0.25 rt_bottom=0.4 /
&rt_setup_params        n_warmup=3 verbose=0 only_vertical=t /

&io_params              verbose=1 do_trace=f do_output=t method='parallel' id_debug=96 restart=-1 /

                        ! lower bdry = 20.90-0.54 = 20.36
                        ! lower bdry = 20.80-0.44 = 20.36
