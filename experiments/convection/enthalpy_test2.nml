!----------------- Main experiment parameters ----------------------------------
&experiment_params flux_BC=t stencil=1.8 kinematic=f amplitude=0.0,+0.1
                   mpoly=1.0 grav=20 courant_c=1.8 courant_v=1.8 /
&boundaries_params bc_rate=1.0 /
&gravity_params    on=t constant=1 axis=3 position=0.0 mass=-1 minrad=-1 /
&viscosity_params  on=f /
&conduction_params on=f /
!----------------- I/O paramters -----------------------------------------------
&io_params         verbose=0 do_trace=f do_debug=f do_output=t
                   method='parallel' guard_zones=t nml_version=1 /
!&restart_params    snapshot=5 /
&out_params        end_time=1e-2 out_time=1e-2 print_every=1 /
&timer_params      sec_per_report=20 /

!----------------- Initial condition parameter ---------------------------------
&patch_params      nt=5 n=3*32 do_check_nan=f grace=0.1 dt_fixed=1e-2 /
&cartesian_params  size=4,4,1 dims=8,8,2 mpi_dims=2,2,1 origin=3*0.0
                   periodic=t,t,f /

!----------------- Refinemennt parameters --------------------------------------
&refine_params     on=f levelmax=12 levelmin=1 verbose=3 check_interval=2 /

!----------------- Solver paramters --------------------------------------------
&aux_params        verbose=0 select= /
&eos_params        gamma=1.6666666666667 /
&divb_clean_params on=f divb_iter=4 divb_cleaner=0 /
&ramses_params     slope_type=2 smallr=1e-5 smallc=0.1 /
&non_ideal_params  mhd_Ohm=f eta_Ohm=0.1 mhd_AD=f /

!                     cs    pa   ofd  mas  kap  eta
&stagger_params    nu=0.10, 1.0, 1.0, 0.0, 1.0, 1.0 courant=0.10 do_maxwell=t /

&bifrost_params    loginterpolation=t ca_max=3e2 courant=0.2 max_r=3 symmetric_e=f
!                        Ca    U    Uv   d     e      E
!                        nu1   nu2  nu3  nu_d  nu_ee  eta3
                   nu=  0.03 , 0.1, 0.1, 0.05,  0.30,  0.3 /
                  !nu=  0.03 , 0.3, 0.1, 0.00,  0.05,  1.0 /
                  !nu=  0.05 , 0.1, 0.2, 0.05,  0.05,  0.8 /

!----------------- Framework paramters -----------------------------------------
&dispatcher_params /
&timestep_params   /
