&experiment_params
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: left hand side
 !-----------------------------------------------------------------------------
 rho_l    =  1.0
 rho_l2   =  1.0
 P_l      =  1.0
 P_l2     =  0d0
 vx_l     =  0.0
 vx_l2    =  0.0
 vy_l     =  0d0
 vy_l2    =  0d0
 rhotr_l  =  0.5
 !rhotr_l2 =  0.5

 !-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side
 !-----------------------------------------------------------------------------
 rho_r    =  0.125
 rho_r2   =  0.125
 P_r      =  0.1
 P_r2     =  0d0
 vx_r     =  0.0
 vx_r2    =  0.0
 vy_r     =  0d0
 vy_r2    =  0d0
 rhotr_r  =  0.5
 !rhotr_r2 =  0.5

/
&ramses_params
 detailed_timer=f
 courant_factor=0.8
 gamma=1.66666
 slope_type=2
 !slope_type=-1
 smallr=1e-4
 smallc=5e-1
 riemann='hllc'
 do_isothermal=f
/
&mhd_params              ! defaults are visible in the log file
 !nu=    0.2, 0., 0.1, 1., 0.1, 0.
 !nu=    0.1, 1., 0., 2., 0., 0.
 !nu=    0.2, 0., 0.5, 1., 1., 0.       !Personal best; pa, ofd and mas are pretty effective at bringing down ringing. Keep cs low!
 !nu=     0.2, 0., 2., 2., 2., 0.       !Slightly less ringing, slightly more continuous shock
 !nu=     0.5, 0., 3., 3., 3., 0.       !Avoids ringing in stationary shock
 !nu=     0.4, 0.4, 0.4, 0.4, 0.4, 0.
 !nu=    0.2, 0.0, 0.5, 1.0, 1.0, 0., 1.2, 10.0, 0.0, 3.2, 0.0, 0.0 !pa, mas, and eta are irrelevant
 !                                                                 do not raise cs above 1.5
 !                                                                 do not raise ofd above 3.0
 !                                                                 do not raise du above 10.0
 !nu=    0.5, 0.0, 0.5, 1.0, 1.0, 0., 4.0, 25.0, 0.0, 10.0, 0.0, 0.0 ! <- Best one so far for Sod Epstein regime
 !nu=    1.0, 0.5, 0.5, 1.0, 1.0, 0., 0.3, 12.0, 0.0, 1.0, 0.0, 0.0 ! <- Best one so far for ordinary shock and Sod linear regime
 nu=   0.10, 2.0, 1.0, 0.2, 1.0, 1.0,  0.1, 2.0, 1.0, 0.2, 1.0, 0.0
 !     cs    pa   ofd  mas  kap  eta   cs   pa   ofd  mas  kap  eta
 !gamma=1.0000001
 gamma=1.66666
 tracer=.true.
 force_coupled=.true.
 !ksi = 1d-17
/
&patch_params
 n=60,1,1          ! patch dimensions
 !dt_fixed=1d-2        ! fixed time step
 ng =2,0,0
 nt=8                   ! time slots
/
&timer_params
 sec_per_report=15.0
/
&out_params
 out_time = 0.1
 end_time = 0.5 !2.1
 print_time = 0.1
 guard_zones=f
/
&cartesian_params
 size=1,1,1
 dims=5,1,1				! number of patches
 origin=0,0,0
/
&timestep_params
 verbose=1
 time_order=2
/
&refine_params
 refine_until=-0.01     ! disables refinment
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=f
/
&IC_params
/
&force_params
 type = 'dust_gas_interaction'
 i_gas = 1
 i_dust = 2
 K = 1.0
 b = 0.5
 sigma = 1.589e-8
 gamma = 1.66666
 !gamma = 1.0000001
 !drag = 'linear'
 drag = 'epstein'
 !drag = 'stokes'
 !drag = 'quadratic'
 !drag = 'power'
 !drag = 'third_order'
 !drag = 'mixed'
/
&viscosity_params
/
&IC_solenoidal_params
/
