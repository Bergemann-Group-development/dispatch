&timer_params
 sec_per_report=30
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&box_params
 size=2.0,2.0,2.0
 dims=3,3,3
 mpi_dims=1,1,1
 origin=-1.0,-1.0,-1.0
/

&out_params
 end_time=0.501
 out_time=0.01
 guard_zones=t
 print_time=0.0
/

&patch_params
 courant=0.2
 n=17,17,17
 nt=5
 no_mans_land=f
/

&experiment_params
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=f
 min_jeans=0.25
 min_dx=0.001
 refinement_ratio=3
 check_interval=10
 refine_from_t=0.005
/

&selfgravity_params
 selfgravity=t
 prediction=f order=1 verbose=2
/

&poisson_params
 floor=1e-5
 tolerance=1e-3
 fourPiG=1.0
 max_iter=200
 precondition=t
 verbose=1
/

&zeus_params
 gamma=1.0001
 trnvrsn=0
 dtinit=1.0e-5
 itote=0
 qlin=0.1
 qcon=1.0
 iord=2
 iords=2
 istp=0
/

&ramses_params
 courant_factor=0.8
 gamma=1.0001
 slope_type=2
 smallr=1e-4
 smallc=5e-1
 riemann='hllc'
 do_isothermal=t
/

&mhd_params
 gamma=1.0
 csound=0.077746
 nu=  0.20, 1.0, 1.0, 0.2, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
/

&force_params
/
