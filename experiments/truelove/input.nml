&timer_params
 sec_per_report=30
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=t
/

&box_params
 size=1.0,1.0,1.0
 dims=1,1,1
 mpi_dims=1,1,1
 origin=0,0,0
/

&out_params
 end_time=5.01
 out_time=0.1
 guard_zones=t
/

&patch_params
 courant=0.5
 n=64,64,64
/

&experiment_params
 truealpha=0.0475
 chirho=0.01
/

&timestep_params
  time_order=0
/

&refine_params
 do_refine=f
/

&selfgravity_params
 selfgravity=t
 verbose=2
 grho=1.0
/

&poisson_params
 solver='zeus_sor'
/

&zeus_params
 gamma=1.0001
 trnvrsn=0
 dtinit=1.0e-5
 itote=0
 qlin=0.1
 qcon=1.0
 iord=2
 iords=2
 istp=0
/

&ramses_params
 courant_factor=0.8
 gamma=1.4
 slope_type=2
 smallr=1e-4
 smallc=5e-1
 riemann='hllc'
 do_isothermal=t
/

&mhd_params
 gamma=1.0001
 nu=  0.20, 1.0, 1.0, 0.2, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
/

&force_params
/
