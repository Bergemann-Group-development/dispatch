&timer_params       sec_per_report=3 /
&io_params          verbose=0 do_trace=f omp_trace=t do_output=t
                    method='background'
                    id_debug=-65
                    task_logging=0 namelist_errors=t guard_zones=t /
&out_params        !end_time=0.511
                   !end_time=.010 start_time=0.0 out_time=.001
                   !end_time=0.10 start_time=0.0 out_time=0.20
                    end_time=0.491 start_time=0.0 out_time=0.01
                   !end_time=0.491 start_time=0.42 out_time=0.002
                   !end_time=0.491 start_time=0.3 out_time=0.01
                   !start_time=0.3 out_time=0.01
                    print_every=1 /

&cartesian_params   size=3*2.0 dims=3*1 mpi_dims=1,1,1
                    origin=-1.0,-1.0,-1.0 periodic=3*f verbose=0 /
&patch_params       nt=9
                   !n=3*32             ! for refine_params ratio=2
                    n=3*33             ! for refine_params ratio=3
                    grace=0.1 /

&download_params    use_prolong='different' use_restrict='guard_zones' /
!&download_params    use_prolong='different' use_restrict='different_restrict' /

&selfgravity_params selfgravity=t verbose=0
                    !prediction=f order=2 /
                    prediction=t order=2 /
&poisson_params     floor=1e-4 tolerance=1e-4 max_iter=200
                    verbose=0 precondition=t solver='sor' /

! u1niform, non-rotating
&experiment_params  rho0=15.27026 r0=0.25 truealpha=0.0475 truebeta=0.0
                    perta=0.0 chipres=1.0 chirho=100.0 /
&scaling_params     l0=3.12e16 /
&force_params       /
&validate_params    verbose=0 id_dbg=-1 /

&halo_params        /
&interp_params      detailed_timer=t /

! This case has more Jeans refinement, and an initial region refinement
&refine_params      on=t check_interval=1 verbose=0
                    levelmin=3 levelmax=8 ratio=3
                    derefine_limit=0.4
                    min_jeans=5
                    region_llc=3*-0.3 region_urc=3*0.3 region_maxlevel=5
                    refine_from_t=0.0 refine_until_t=99.0 /

! uniform, rotating
!&experiment_params  rho0=15.2783 r0=0.25 truealpha=0.54 truebeta=0.08
                    !perta=0.0 chipres=1.0 chirho=100.0 /
!&scaling_params    l0=2.890e17 /

! rotating, perturbed, 10%
!&experiment_params rho0=16.0130 r0=0.25 truealpha=0.26 truebeta=0.16
                    ! perta=0.1 pertm=2 chipres=10.0 chirho=100.0 /
!&scaling_params    l0=2.0e17 /

&boundary_params    fixedbcs=t /
&timestep_params    time_order=2 /

&eos_params         gamma=1.0001 /
&zeus_params        trnvrsn=0 dtinit=1.0e-3 itote=0 qlin=0.1
                    qcon=1.0 iord=2 iords=2 istp=0 /

&ramses_params      courant_factor=0.20 slope_type=3.5
                    unsigned=t
                    smallr=1e-4 smallc=1e-3 isothermal=f /

&stagger_params     nu=  0.20, 1.0, 1.0, 0.2, 1.0, 1.0
                    !     cs    pa  ofd  mas  kap  eta
                    csound=1.0 ! non-rotating case
                    !csound=0.08451 ! rotating case
                    !csound=0.1829 ! rotating, perturbed case
/

&lock_params        verbose=0 /
&task_list_params   verbose=0 /

