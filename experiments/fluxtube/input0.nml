&timer_params
 sec_per_report=30
/
&io_params
 verbose=0
 do_trace=f
 omp_trace=f
 do_debug=f
 do_output=t
/
&cartesian_params
 size=1,1,1
 dims=1,1,1
 origin=0,0,0
/
&experiment_params
 x0=0.5
 y0=0.5
 z0=0.0
 r0=0.25
 B0=0.1
 temp=1e-4
 gamma=1.6667
 beta = 10.
 expe = 1
 first_pic=f
/
&patch_params
 nt=5
 nv=8
 nw=2
 ng=3*3
 courant=0.2
 grace=0.3
 n=3*32
!dt_fixed=0.001
/
&out_params
 end_time=100
 out_time=4
 print_time=0.0
 guard_zones=t
 time_derivs=f
/
&mhd_params
 gamma=1.6667
 nu=  0.01, 0.5, 1.0, 0.0, 1.0, 0.5
 !     cs    pa  ofd  mas  kap  eta
/
&timestep_params
 time_order=2
/
&refine_params
/

! PIC parameters
&mpi        nx=1 ny=1 nz=1 /

&main       nspecies=2 seed=33 Cdt=.5 Cdtwpe=0.5 /
&output     writefac=20 datadir='data' /

&init       do_pairs=t periodic_bcs=t,t,f /

&species    name='electron' mass=1.00 charge=-1. npercell=40 verbose=1 /
&species    name='ion'      mass=20.0 charge=+1. npercell=40 /

&maxwell    emf=0.55 tol_e=0.0001 tol_b=0.0001 do_e_fix=f verbose=0 /
&do         do_vth=t do_maxwell=t do_lorentz=t do_parallel_io=f /

&run_info   out_e_tot=t out_e_bal=t out_e_em=t out_e_pa=t out_namelists=t out_grid=t /
&dbgctl     trace=f trace_level=2 dbg=2 !dbg_select=1024
/
