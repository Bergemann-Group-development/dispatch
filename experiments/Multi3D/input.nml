! -- Parameters defining the run -----------------------------------------------
&scaling_params     l=1e8 v=1e6 d=1e-7
&io_params          do_trace=F omp_trace=F os_verbose=0 datadir='data/' verbose=0 gb_step=0.5 do_output=T/
&timer_params       sec_per_report = 1e8 /
!&atmos_params       verbose=1 atmos_file='./input_multi3d/atmos/atmos.hd140283_MARCS'  dims=1,1,3 FeH=-2.4 /
!&atmos_params       verbose=1 atmos_file='./input_multi3d/atmos/t5777g44m0005_20.5x5x230' read_Multi=T patches_per_mpi=1,1,1/
&atmos_params       verbose=1 atmos_file='./input_multi3d/atmos/t5777g44m0005_20.5x5x230' read_Multi=T dims=1,1,2/
!&atmos_params       verbose=1 read_Stagger=T dims=1,1,23 FeH=-0.0/
!&stagger_params     stagger_file='/shared-storage/bergemann-data/Stagger_remo/t5777g44m00/v05/t5777g44m0005' snap=0 dims=5,5,230 /
&atom_params        atom_file='./input_multi3d/atoms/atom.ba06' convlim=1d-2
                    verbose=2 exclude_trace_cont=F exclude_from_line_list=T use_atom_abnd=T/
&halo_params        check_filled=F verbose=0 /
&m3d_params         verbose=2 fcheck=1 pcheck=1,1,230 linecheck=4 lvlcheck=6 check_NaN=F
                    n_nu=2 maxiter=50 ilambd=0 comoving_frame=T lse_solver='no_pivot'
                    quad_scheme='set_a2' long_scheme='lobatto'
                    save_back_opac=T detailed_prints=F print_push=F print_finished=F print_start=F print_send=F/
!&composition_params verbose=0 absmet_file='./input_multi3d/absmet' /
                    !absdat_file='./input_multi3d/absdat'
                    !abund_file='./input_multi3d/abund
                    !linelist_file='./input_multi3d/test_linelist2.txt' /
!&linelist_params    exclude_elements='V CN Cr Si Fe'
!&spectrum_params    daa=0.001 aa_blue=4553.53 aa_red=4554.53 /