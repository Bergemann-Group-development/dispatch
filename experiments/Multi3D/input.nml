!===============================================================================
! Call Hierarchy ... start in dispatch.f90
!-------------------------------------------------------------------------------
! PROGRAM dispatch
!   call read_external
!     call create_patches
!       call task%init -> experiment_mod:init
!           call solver_t%init -> solver_mod:init
!               call mhd_t%init -> mhd_mod:init
!                   call extras%init -> extras_mod:init
!                       call gpatch_t%init -> gpatch_mod:init
!                           call patch_t%init -> patch_mod:init
!                               call task_t%init -> task_mod:init
!                               call mesh_init
!                                   call MeshFactory -> mesh_mod:MeshFactory
!                           call boundaries%init -> boundaries_mod:init
!                               read namelist: boundary_params
!                               call standard_boundaries%init -> standard_boundaries_mod:init
!         
!       
! 
! 
!===============================================================================

! -- Parameters defining the run -----------------------------------------------
!&io_params          do_trace=T omp_trace=F /
!&snapshot_params    verbose=0 flip_z=t force_mean=f extension=1 order=2 b0=0.0,0.0,0.0 
!                    model='stagger'
!                    meshfile='../../data/stellar_atmospheres/mhd63.msh'
!                    snapfile='../../data/stellar_atmospheres/mhd63.dat' /
!&cartesian_params   size=6,6,3 dims=6,6,3 mpi_dims=2,2,1 origin=0,0,-2.5
!                    omp_init=t periodic=t,t,f /
!&atmos_params       verbose=1 atmos_file='./input_multi3d/atmos/atmos.sun_MARCS' npatches=1 /
!&atmos_params       verbose=1 atmos_file='./input_multi3d/atmos/t5777g44m0005_20.5x5x230' npatches=1 read_Stagger=T/
&atmos_params       verbose=1 atmos_file='./input_multi3d/atmos/Sun.5x5x230' npatches=1 read_Stagger=T/
&boundary_params    verbose=0 condition=1 /
&download_params    check_filled=F verbose=0 /
!&atom_params        atom_file='./input_multi3d/atoms/atom.fe607a' qnorm=10.0 convlim=1d-3 /
!&atom_params        atom_file='./input_multi3d/atoms/atom.ba06' qnorm=10.0 convlim=1d-3 /
&atom_params        atom_file='./input_multi3d/atoms/atom.o41f' qnorm=10.0 /
&radiation_params   save_output=T /
&experiment_params  n_nu=1 maxiter=1 verbose=2 ilambd=0 quad_scheme='set_a4' long_scheme='set_a4'/
&timer_params       sec_per_report = 1000 /
&task_list_params   verbose=0 /
&dispatcher0_params verbose=0 /
&task_params        verbose=0 /
&halo_params        check_filled=F /
&m3d_params         fcheck=98 pcheck=1,1,230 /
