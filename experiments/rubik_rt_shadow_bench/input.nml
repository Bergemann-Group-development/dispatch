&io_params
 verbose=0
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
/

&rubiks_params
 size=3*0.1111111
 n_levels=2                         ! # of refinement levels in for the rubiks cube
 n_patch=3                          ! # of patches per direction
 m_zoom=3                           ! zoom-in level per direction
 n_repeat=1                         ! how many times rubiks cube is repeated along the orbit
/

&out_params
 end_time=3d-4
 out_time=1d-5
 print_time=0.0
 guard_zones=t
 time_derivs=f
/

&box_params
 size=1,1,1
 dims=3,3,3
 origin=0.0,0.0,0.0
 !origin=-0.005,-0.005,-0.005
/

&patch_params
 nt=5
 courant=0.0
 grace=0.0
 n=43,43,43
 !dt_fixed=1d-11
 no_mans_land=f
/

&eos_params
  gamma = 1.666667
  do_rt = t
/


! ------- Radiative transfer ---------
&rt_params
 solver= 'integral'
 use_data_hub = f
 do_output = t
 cr_heating = 0.0
 init_time = 0d0
 !periodic = f,t,t
 dtau='staggered'   !other options: centered, weighted, staggered
/

&cartesian_ray_geometry_params
do_chains = f
! along x axis
nx = 2 xti = 0.,45.
! along y axis
ny = 2 yti = 0.,45.
! along z axis
nz = 2 zti = 0.,45.
! use space_diagonals?
space_diagonals=t
/

! Treatment of boundary conditions for RT solver. 
&rt_bc_params
cool_temp = 290!103530!40000 !290   ! in kelvins
hot_temp  = 1740!621180!240000 !1740
/


&mhd_params
 nu=  0.15, 1.0, 1.0, 0.2, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
 gamma=1.666667
/
&ramses_params
 gamma=1.666667
 slope_type=2
 courant_factor=0.8
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/
&timestep_params
 !time_order=2
/

&initial_params
 clump_pos = 0.5,0.0,0.0 
 !clump_pos = 0.6666,0.6666,0.6666
 d0=1.0
 clump_dfact=10.0
 !t0=103530.0
 t0=290.0
 clump_a=0.1
 clump_b=0.06
 gamma=1.666667
/
&force_params   /
