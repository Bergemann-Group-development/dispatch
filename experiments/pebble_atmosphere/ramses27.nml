&io_params
 verbose=1
 do_output=t
 do_trace=f
 omp_trace=f
/
&out_params
 ! L_unit = R_E, u_unit = km/s, t_unit = 6300 sec ~ 2h, 1d ~ 12 t.u., 1 yr ~ 4000 t.u.
 end_time=2000.         ! outer scale = 1500 R_E => 1500 time units at 1 km/s
 !end_time=40.           ! outer scale = 1500 R_E => 1500 time units at 1 km/s
 out_time=10.           ! pebble speed 30 => 1.5 l.u. per snapshot
 !out_time=0.1
 print_time=0
 guard_zones=t
 time_derivs=f
 max_files=9000
/
&rubiks_params
 n_levels=4
 n_patch=3
 m_zoom=3
 n_repeat=7
/
&pebble_params
 do_pebbles=t
 trace_every=2
 omega_yr=0.0,0.0,1.0
 vz_pebble_cgs=1.5e6
 pebble_rate_cgs=0.0
 cell_probability=0.001
 ppc=1
/
&planet_params
 mass_m_earth=0.90
 radius_r_earth=27.
/
&atmosphere_params
 densitY_cgs=1e-9
 temperature_K=200.
 mass_m_earth=0.95
 orbit_au=1.0
/
&planet_atm_params
 v_head_cgs=0.0
 v_accrete_cgs=0e2
/
&patch_params
 !n=3*20
 n=3*32
 nv=5
 nt=7
 nw=1
 grace=0.0
 courant=0.25
/
&ramses_params
 gamma=1.4
 slope_type=2
 courant_factor=0.6
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/
&timer_params sec_per_report=5 /
&force_params                  /
&IC_params                /
