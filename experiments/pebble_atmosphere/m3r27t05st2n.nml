&experiment_params /
&IC_params /
&force_params   /

&timer_params sec_per_report=30 /
!&task_list_params
! sync_time=0.5
!/
&io_params
 verbose=0
 do_trace=f
 omp_trace=f
 !id_debug=137
 do_debug=f
 do_output=t
 do_legacy=t
/
&out_params
!end_time=2.1   out_time=0.2
!end_time=10    out_time=1              ! 00-10
!end_time=100  out_time=10              ! 00-10
end_time=1000 out_time=50  restart=10  ! 11-19
!end_time=1200 out_time=20  restart=19  ! 00-90
!end_time=9000 out_time=200 restart=19  ! 00-90
!end_time=9000 out_time=100 restart=80  ! 00-90
!end_time=1e4  out_time=100 restart=90  ! 90-100
 print_time=0
 guard_zones=t
 time_derivs=f
 max_files=9000
/
&rubiks_params
 n_levels=4                         ! # of refinement levels in for the rubiks cube
 n_patch=3                          ! # of patches per direction
 m_zoom=3                           ! zoom-in level per direction
 n_repeat=5                         ! how many times rubiks cube is repeated along the orbit
/
&eos_params                         ! For ideal gas EOS
gamma=1.4
/
&pebble_params
 do_pebbles=f                       ! pebbles are on/off
 only_pebbles=f                     ! do only pebbles?
 omega_yr=0.0,0.0,1.0               ! omega in units where 1 = 1/yr
 solid_density_cgs=3.               ! density of a pebble
 pebble_size_cm=1.                  ! size of a pebble
/

&planet_params
 radius_r_earth=1.35
 rad_mult=27.
 mass_m_earth=3.0
 orbit_radius_au=1.0
 position_orbit_radii=0.0, 1.0, 0.0 ! planet position in orbit radii      
 trap=0.05                          ! Hx = sqrt(10.)*Hz = 3.16*Hz
!artificial_friction=1e-4           ! friction time = 250
/
&atmosphere_params
 densitY_cgs=3e-12                  ! outer density of the atmosphere at 1 Hill radius (i.e. surrounding local disk density)
 temperature_K=200.                 ! outer temperature of the atmosphere at 1 Hill radius
 mass_m_earth=3.0
 orbit_au=1.0
 gamma = 1.4                        ! adiabatic index (gradient?)
 temp_gamma=2000.                   ! temperature above which second gamma is used instead of first
 nr=500                             ! number of initial atmosphere layers from which mhd values will be picked up
/
&planet_atm_params                  ! initial parameters for planet atmosphere when it is interpolated to mhd grid
 gamma = 1.4
 v_head_cgs=0.0                     ! headwind speed
 v_accrete_cgs=0.0                  ! accretion speed
 omega = 0.0,0.0,1.0
!test=t
/
&patch_params
 periodic=f,t,f
 n=3*33
 nt=5
 grace=0.00
 courant=0.2
!dt_fixed=0.001
/

&mhd_params
 gamma=1.4
 nu=  0.20, 1.0, 1.0, 0.0, 1.0, 1.0
 !     cs   pa   ofd  mas  kap  eta
/
&ramses_params
 gamma=1.4
 slope_type=2
 courant_factor=0.8
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/

&refine_params
msplit=3
reftimes = 3
refine_time= 2.0, 4.0, 8.0
refine_level = 5, 6, 7
/

&timestep_params
/
