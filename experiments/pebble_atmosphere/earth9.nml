&experiment_params /
&IC_params /
&force_params   /

&io_params
 !restart=10
 !inputdir='data/earth3'
 do_trace=f
 verbose=1
 do_debug=f
 do_output=t
 do_legacy=t
/
&rubiks_params
 n_levels=5                         ! # of refinement levels in for the rubiks cube
 n_patch=3                          ! # of patches per direction
 m_zoom=3                           ! zoom-in level per direction
 n_repeat=3                         ! how many times rubiks cube is repeated along the orbit
/

&eos_params                         ! For ideal gas EOS
gamma=1.4
/
&pebble_params
 do_pebbles=f                       ! pebbles are on/off
 only_pebbles=f                     ! do only pebbles?
 omega_yr=0.0,0.0,1.0               ! omega in units where 1 = 1/yr
 vz_pebble_cgs=1.5e6                ! about 15 km/s vertically
 !vz_pebble_cgs = 3e6               ! about 30 km/s vertically
 pebble_rate_cgs = 1e2              ! about one pebble per 10 second (3e6 per year)
 IC_density=1e-7
 solid_density_cgs=3.               ! density of a pebble
 pebble_size_cm=1.                  ! size of a pebble
/

&planet_params
 radius_r_earth=9.0 
 mass_m_earth=1.0
 orbit_radius_au=1.0
 position_orbit_radii=0.0, 1.0, 0.0 ! planet position in orbit radii      
 temperature_k=800.                ! surface temperature in K as an initial guess
 artificial_friction_time = 0.
 artificial_friction_strength = 0.0
/
&atmosphere_params
 densitY_cgs=3e-12                  ! outer density of the atmosphere at 1 Hill radius (i.e. surrounding local disk density)
 temperature_K=200.                 ! outer temperature of the atmosphere at 1 Hill radius
 mass_m_earth=1.0
 orbit_au=1.0
 gamma = 1.4                        ! adiabatic index (gradient?)
 temp_gamma=2000.                   ! temperature above which second gamma is used instead of first
 nr=500                             ! number of initial atmosphere layers from which mhd values will be picked up
/
&planet_atm_params                  ! initial parameters for planet atmosphere when it is interpolated to mhd grid
 gamma = 1.4
 v_head_cgs=0.0                     ! headwind speed
 v_accrete_cgs=0.0                  ! accretion speed
 omega = 0.0,0.0,1.0
/

&patch_params
 n=30,30,30
 nt=5
 grace=0.0
 courant=0.2
!dt_fixed=0.001
/
&out_params
 end_time=2000.
 out_time=20.
 print_time=1.
 guard_zones=t
 time_derivs=f
 max_files=9000
/
&mhd_params
 gamma=1.4
 omega_yr=0.0,0.0,1.0
 nu=  0.20, 1.0, 1.0, 0.2, 1.0, 1.0
 !     cs   pa   ofd  mas  kap  eta
/
&ramses_params
 gamma=1.4
 slope_type=2
 courant_factor=0.2
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
 friction = 0.0
/

&refine_params
msplit=3
reftimes = 3
refine_time= 2.0, 4.0, 8.0
refine_level = 5, 6, 7
/

&timestep_params
 time_order=2
/

