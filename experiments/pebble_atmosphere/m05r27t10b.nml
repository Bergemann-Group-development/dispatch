! These params are intended for the master branch, with use_data_hub and no_mans_land=.true. 

&experiment_params
 x_sponge=500.
/
&IC_params /
&force_params   /

&timer_params sec_per_report=10 /
!&task_list_params
! sync_time=0.5
!/
&io_params
 verbose=0
 do_trace=f
 omp_trace=f
 do_debug=f
 do_output=f
 do_legacy=t
!id_debug=204
/
&out_params
 end_time=5000 out_time=100 !restart=180
 !end_time=50 out_time=5
 print_time=0
 guard_zones=t
 time_derivs=f
 max_files=9000
/
&rubiks_params
 n_levels=4                         ! # of refinement levels in for the rubiks cube
 n_patch=3                          ! # of patches per direction
 m_zoom=3                           ! zoom-in level per direction
 n_repeat=5                         ! how many times rubiks cube is repeated along the orbit
/
&eos_params                         ! For ideal gas EOS
 gamma=1.4
/
&pebble_params
 detailed_timer=f
 !id_dbg=36730
 do_pebbles=t                       ! pebbles on/off
 only_pebbles=f                     ! do only pebbles?
 omega_yr=0.0,0.0,1.0               ! omega in units where 1 = 1/yr
 solid_density_cgs=3.               ! density of a pebble
 pebble_size_cm=1.                  ! size of a pebble
 size_range=3                       ! power of 10 size range
 !------------------------------------- TOP/BOTTOM ENTRY --------------
 pebble_rate_cgs=0                  ! top/bottom rate of pebble entry
 vz_pebble_cgs=1.5e6                ! incoming vertical velocity
 !------------------------------------- RANDOM DISTRIBUTION -----------
 ppc=0.02                           ! particles per cell, everywhere
 trace_every=10                     ! trace every so many pebbles => data/*.trc
/

&planet_params
 radius_r_earth=0.80
 rad_mult=27.
 mass_m_earth=0.5
 orbit_radius_au=1.0
 position_orbit_radii=0.0, 1.0, 0.0 ! planet position in orbit radii      
 trap=0.10                          ! Hx = sqrt(10.)*Hz = 3.16*Hz
!artificial_friction=1e-4           ! friction time = 250
/
&atmosphere_params
 densitY_cgs=1e-10                  ! outer density of the atmosphere at 1 Hill radius (i.e. surrounding local disk density)
 temperature_K=300.                 ! outer temperature of the atmosphere at 1 Hill radius
 mass_m_earth=0.5
 orbit_au=1.0
 gamma = 1.4                        ! adiabatic index (gradient?)
 temp_gamma=2000.                   ! temperature above which second gamma is used instead of first
 nr=500                             ! number of initial atmosphere layers from which mhd values will be picked up
/
&planet_atm_params                  ! initial parameters for planet atmosphere when it is interpolated to mhd grid
 gamma = 1.4
 v_head_cgs=0.0                     ! headwind speed
 v_accrete_cgs=0.0                  ! accretion speed
 omega = 0.0,0.0,1.0
!test=t
/
&patch_params
 use_data_hub=t no_mans_land=t
 periodic=f,t,f
 n=3*48
 nt=5
 grace=0.30
 courant=0.2
!dt_fixed=0.001
/

&mhd_params
 gamma=1.4
 nu=  0.05, 1.0, 1.0, 0.0, 1.0, 1.0
 !     cs   pa   ofd  mas  kap  eta
/

&refine_params
msplit=3
reftimes = 3
refine_time= 2.0, 4.0, 8.0
refine_level = 5, 6, 7
/

&timestep_params /
