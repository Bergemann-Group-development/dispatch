&io_params
 verbose=1
 do_output=t
 do_trace=f
 omp_trace=f
/
&out_params
 ! L_unit = R_E, u_unit = km/s, t_unit = 6300 sec ~ 2h
 end_time=2.00          ! outer scale = 1500 R_E => 1500 time units at 1 km/s
 !out_time=0.40          ! pebble speed 30 => 1.5 l.u. per snapshot
 out_time=0.1
 print_time=0
 guard_zones=t
 time_derivs=f
 max_files=9000
/
&rubiks_params
 n_levels=7
 n_patch=3
 m_zoom=3
 n_repeat=5
/
&pebble_params
 do_pebbles=t
 trace_every=10         ! trace every 10th pebble => data/*.peb
 omega_yr=0.0,0.0,1.0
!omega_yr=0.0,0.0,0.0   ! TEST only
 !----------------------- TOP/BOTTOM ENTRY --------------
 vz_pebble_cgs=1.5e6    ! incoming vertical velocity
 pebble_rate_cgs=1      ! top/bottom rate of pebble entry
 !----------------------- RANDOM DISTRIBUTION -----------
 ppc=1                  ! particles per cell
 cell_probability=0.1   ! probability per cell
/
&planet_params
 mass_m_earth=1.0
/
&atmosphere_params
 densitY_cgs=3e-12
 temperature_K=200.
 mass_m_earth=1.0
 orbit_au=1.0
/
&planet_atm_params
 v_head_cgs=0.0
 v_accrete_cgs=0.0
/
&initial_params /
&force_params   /
&patch_params
 n=3*32
 nv=5
 nt=7
 nw=1
 grace=0.0
 courant=0.2
/
&ramses_params          ! Used only when SOLVER=ramses/hydro
 gamma=1.4
 slope_type=2
 courant_factor=0.8
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/
&timer_params
 sec_per_report=1
/
