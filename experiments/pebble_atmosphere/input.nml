&timer_params sec_per_report=10 /

&experiment_params /
&initial_params
 initial_condition='planet_atmosphere'
/
&force_params   /

&io_params
 verbose=1
 do_output=f
 do_trace=f
 omp_trace=f
 !id_debug=62
/
&out_params
 end_time=10.0 out_time=1
 print_time=0
 guard_zones=t
 time_derivs=f
 max_files=9000
/
&rubiks_params
 n_levels=7
 n_patch=3
 m_zoom=3
 f_zoom=0.95
 n_repeat=1,3,1
/
&pebble_params
 do_pebbles=t
 omega_yr=0.0,0.0,1.0
!omega_yr=0.0,0.0,0.0   ! TEST only
 !----------------------- TOP/BOTTOM ENTRY --------------
 vz_pebble_cgs=1.5e6    ! incoming vertical velocity
 pebble_rate_cgs=1      ! top/bottom rate of pebble entry
 !----------------------- RANDOM DISTRIBUTION -----------
 ppc=0.1                ! particles per cell
 trace_every=1          ! trace every 10th pebble => data/*.peb
/
&planet_params
 mass_m_earth=1.0
/
&atmosphere_params
 densitY_cgs=1e-10
 kappa_cgs=1.0
 temperature_K=200.
 mass_m_earth=1.0
 orbit_au=1.0
/
&planet_atm_params
 omega=0.0,0.0,1.0
 v_head_cgs=0.0
 v_accrete_cgs=0.0
/
&patch_params
 n=3*32
 ng=3*2
 nv=5
 nt=7
 grace=0.0
 courant=0.2
 no_mans_land=t
 use_data_hub=f
/
&timestep_params /
&mhd_params
 gamma=1.4
 nu=  0.20, 1.0, 1.0, 0.2, 1.0, 1.0
 !     cs   pa   ofd  mas  kap  eta
/
&ramses_params          ! Used only when SOLVER=ramses/hydro
 gamma=1.4
 slope_type=2
 courant_factor=0.8
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/
