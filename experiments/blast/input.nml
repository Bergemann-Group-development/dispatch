&timer_params
/

&io_params
 verbose=2
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=t
/

&box_params
  size=1,1,0.01
  dims=1,1,1
  origin=-0.5,-0.5,0.0
/

&out_params
 end_time=0.02
 out_time=0.001
 guard_zones=t
/

&initial_params
  r0=0.125
  d0=1.0,1.0
  p0=1.0,100.0
  bx0=7.0711,7.0711
  by0=7.0711,7.0711
/

&zeus_params
  gamma=1.6666666666667
  trnvrsn=0
  dtinit=1.0e-5
  itote=0
  qlin=0.1
  qcon=1.0
  iord=2
  iords=2
  istp=0
/

&timestep_params
  time_order=0
/

&patch_params
  courant=0.5
  n=100,100,1
/

&refine_params
  tol_shock=0.2
  tol_contact=0.2
  check_interval=1
  msplit=2
  levelmax=8
  refine_from_time=0.0
/

&ramses_params
 courant_factor=0.8
 gamma=1.6666667
 slope_type=2
 smallr=1e-4
 smallc=5e-1
 riemann='hllc'
 do_isothermal=f
/
