&timer_params
/

&io_params
 verbose=0
 do_trace=f
 do_debug=f
 do_output=f
 guard_zones=t
 nml_version=1
/

&cartesian_params
 size=3*1
 dims=16,16,1 mpi_dims=2,2,1            ! 2-D case (not for HLLC/HLLD)
 !dims=8,8,8 mpi_dims=2,2,2              ! 3-D case
 !origin=-0.5,-0.5,-0.5
 origin=3*0
/

&out_params
 end_time=0.5
 end_time=0.02
 out_time=0.01
 print_time=0
 print_every=500
/


&patch_params
 nt=5
 n=32,32,1                              ! 2-D case (not for HLLC/HLLD)
 !n=3*16                                 ! 3-D case
 do_check_nan=f
 !dt_fixed=0.0001
 grace=0.05
 no_mans_land=t
/

&experiment_params
 r0=0.125
 d0=1.0,1.0
 e0=1.0,100.0
 bx0=7.0711,7.0711
 by0=7.0711,7.0711
 !bz0=7.0711,7.0711
/

&zeus_params
 gamma=1.6666666666667
 trnvrsn=0
 dtinit=1.0e-5
 itote=0
 qlin=0.1
 qcon=1.0
 iord=2
 iords=2
 istp=0
/

&timestep_params
/

&refine_params
 on=f
/

&ramses_params
 courant_factor=0.25
 csound=1.0
 gamma=1.6666667
 slope_type=3
 !smallr=1e-4
 !smallc=5e-1
 !slope_type=3.5
  smallr=1e-5
  smallc=1e-0
/


&stagger_params
 gamma=1.666667
 courant=0.10
 do_maxwell=f
 nu=  0.10, 0.02, 1.0, 0.00, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
/

&force_params
/

&bifrost_params             
 gamma=1.6666666666667
 loginterpolation=t
 ca_max = 3e2 
 courant=0.2
 max_r=3
 symmetric_e=f
 !     Ca    U    Uv   d     e      E
 !     nu1   nu2  nu3  nu_d  nu_ee  eta3
 nu=  0.03 , 0.3,  0.1,  0.0,  0.05, 0.9
/
