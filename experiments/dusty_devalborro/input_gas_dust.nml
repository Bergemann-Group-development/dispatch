&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 !method='parallel'
 method='legacy'
/

&out_params
 end_time=62.832 !1.89  !62.832 !630.0
 out_time=1.0 !0.06283 !6.283  !0.628319
 print_time=0.3
