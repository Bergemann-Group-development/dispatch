  ramp_mass=t
  mtotal=1.0!1.001
  mplanet=1.0e-3!1.0e-3
  dust2gas=0.01
  nv=10
  nc=2
/

&annulus_params
  rotating=t
  n_patch=1,5,9 !1,5,9
  n_per_patch=1,32,55 !1,32,55 !1,160,495
/

&zeus_params
  gamma = 1.0001
  trnvrsn = 0
  dtinit = 1.0e-5
  itote = 0
  qlin=0.1
  qcon=2.0
  iord=2
  iords=2
  istp=0
  nuscalar=1.0e-5
/

&mhd_params
 !nu=    0.8, 2.0, 2.0, 0.1, 0.6, 0.0, 0.5, 2.5, 2.5, 0.1, 0.3, 0.0 ! Attempt at stabalizing dusty de Val-Borro, 42 * 0.12566
 !nu=    0.5, 1.0, 1.0, 0.0, 0.6, 0.0, 0.5, 3.5, 3.5, 0.0, 0.6, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    1.5, 1.0, 1.0, 0.0, 0.6, 0.0, 1.5, 3.5, 3.5, 0.0, 0.6, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    0.8, 2.0, 2.0, 0.0, 0.6, 0.0, 0.5, 2.5, 2.5, 0.0, 0.3, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    1.5, 2.0, 2.0, 0.0, 0.6, 0.0, 2.5, 2.5, 2.5, 0.0, 0.3, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    1.5, 2.0, 2.0, 0.0, 0.6, 0.0, 1.5, 2.5, 2.5, 0.3, 0.6, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    1.5, 2.0, 2.0, 0.0, 0.6, 0.0, 1.5, 6.5, 6.5, 0.3, 0.6, 0.0 ! went very bad very fast! Faster than any of the others
 !nu=    1.5, 2.0, 2.0, 0.0, 0.6, 0.0, 1.5, 2.5, 2.5, 2.0, 0.6, 0.0 ! also went very bad very fast! Faster than any of the others
 !nu=    1.5, 2.0, 2.0, 0.0, 0.6, 0.0, 2.5, 2.5, 2.5, 0.3, 0.6, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    1.5, 2.0, 2.0, 0.0, 0.6, 0.0, 2.0, 2.5, 2.5, 0.3, 0.6, 0.0 ! quickly became unstable in p_r in dust at inner edge
 !nu=    2.5, 2.0, 1.0, 0.0, 2.0, 0.0, 0.5, 6.0, 1.0, 0.0, 0.0, 0.0
 !nu=    2.5, 2.0, 1.0, 0.0, 2.0, 0.0, 0.8, 12.0, 1.0, 0.0, 0.0, 0.0
 nu=   0.10, 2.0, 1.0, 0.2, 1.0, 1.0,  0.1, 2.0, 1.0, 0.2, 1.0, 0.0
 !     cs    pa   ofd  mas  kap  eta   cs   pa   ofd  mas  kap  eta
 gamma=1.0001
 !gamma=1.0
 csound=1.0
 !gamma=1.66666
 tracer=.false. 			!Enable passive tracer for every fluid component
 force_coupled=.true.			!Enable coupled force type; turn off for ordinary de Val-Borro
 !ksi = 1d-17
/

&timestep_params
  time_order=2
/

&patch_params
  courant=0.2
/

&rubiks_params
 n_repeat=1
 n_levels=4
 position=0,0,0
 n_patch=1,3,3
 !n_patch=0,0,0
 !size=1,0.0025,0.002617995
 !size=1,0.0185185185,0.0193925472 ! should correspond to level "4"
 size=1,0.1665,0.1745
 m_zoom=3
 n_per_patch=1,32,32
 planet_cylpos=0,1.0,0
/

&force_params
 type = 'star_and_planet'
 do_pressure = f
 use_viscosity = f
 i_gas = 1
 i_dust = 2
 K = 1.0e-9
 !d_int = 0.0252825      ! Internal density of dust grains in numerical units
 d_int = 1.0             ! Internal density of dust grains in numerical units
 !a = 1.0e-5             ! Size (radius) of dust grains in numerical units
 a = 1.0e-5                 ! Size (radius) of dust grains in numerical units
 b = 0.4                 ! Exponent for power law drag,
 sigma = 1.589e-8
 !gamma = 1.66666
 gamma = 1.0001
 !gamma = 1.0
 csound = 1.0
 cd = 0.00016
 !drag = 'linear'       ! F = K*(v-vd)
 drag = 'epstein'
 !drag = 'stokes'
 !drag = 'quadratic'    ! F = K*|v-vd|*(v-vd)
 !drag = 'power'        ! F = K*|v-vd|^b*(v-vd)
 !drag = 'third_order'  ! F = K*(1+|v-vd|^2)*(v-vd)
 !drag = 'mixed'        ! F = K*sqrt(1+|v-vd|^2)*(v-vd)
/
&viscosity_params
 type = 'constant_viscosity'
 nu = 1.0e-5
 nc = 2
/

&download_params
/
