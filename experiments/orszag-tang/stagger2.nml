&io_params
 verbose=0
 do_trace=f
 do_debug=f
 do_output=t
 guard_zones=t
 nml_version=1
/
&cartesian_params
 size=1,1,0.0078
 dims=3,3,1
 origin=0,0,0
/
&experiment_params
 d0=1.2
 !B0=0.0,0.0,0.0
/
&patch_params
 nt=5
 ng=3*6
 n=32,32,1
 do_check_nan=f
 !dt_fixed=0.01
 grace=0.01
/

&aux_params  verbose=0 select='tt','qr','rkap','src','qout' /

&eos_params
gamma=1.6666666666667
/

&out_params
 end_time=2.000
 out_time=0.01
 print_time=0
/
&stagger_params
 courant=0.10
 nu=  0.10, 1.0, 1.0, 0.0, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
 gamma=1.6666666666667
 do_maxwell=t
 !gamma=1.
/

&initial_params
 idirect=3
/

&bifrost_params             
gamma=1.6666666666667
loginterpolation=t
ca_max = 3e2 
courant=0.1
max_r=3
symmetric_e=f
!     Ca    U    Uv   d     e      E
!     nu1   nu2  nu3  nu_d  nu_ee  eta3
nu=  0.03 , 0.3,  0.1,  0.0,  0.05, 0.9 /

&dispatcher_params      method=o /
&timestep_params
/
