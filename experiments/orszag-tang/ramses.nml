&io_params
 verbose=0
 do_trace=f
 do_debug=f
 do_output=t
 guard_zones=t
 nml_version=1
/

! --- XY plane ---
&patch_params nt=5 n=32,32,3 no_mans_land=t  do_check_nan=f grace=0.01 /
&cartesian_params size=1,1,0.0078 dims=12,12,1 mpi_dims=4,4,1 origin=0,0,0 /
&IC_params idirect=3 !b0=0.0
/
! --- XZ plane ---
!&patch_params nt=5 ng=3*8 n=32,1,32 do_check_nan=t grace=0.01 /
!&cartesian_params size=1,0.0078,1 dims=3,1,3 origin=0,0,0 /
!&IC_params idirect=2 !b0=0.0
/
! --- YZ plane ---
!&patch_params nt=5 ng=3*8 n=1,32,32 do_check_nan=t grace=0.01 /
!&cartesian_params size=0.0078,1,1 dims=1,3,3 origin=0,0,0 /
!&IC_params idirect=1 !b0=0.0
/

&aux_params  verbose=0 select='tt','qr','rkap','src','qout' /

&eos_params
gamma=1.6666666666667
/

&out_params
 end_time=1.001
 out_time=0.1
 print_time=0
/
&stagger_params
 courant=0.10
 nu=  0.10, 1.0, 1.0, 0.0, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
 gamma=1.6666666666667
 do_maxwell=t
 !gamma=1.
/

&bifrost_params             
gamma=1.6666666666667
loginterpolation=t
ca_max = 3e2 
courant=0.2
max_r=3
symmetric_e=f
!     Ca    U    Uv   d     e      E
!     nu1   nu2  nu3  nu_d  nu_ee  eta3
!nu=  0.03 , 0.3,  0.1,  0.0,  0.05, 1.0 /
!nu=  0.05 , 0.1,  0.2,  0.05,  0.05, 0.8 /
nu=  0.03 , 0.1,  0.1,  0.05,  0.3, 0.3 /

&dispatcher_params      method=0 /
&timestep_params
/

&divb_clean_params
 on=t
 divb_iter=4
 divb_cleaner=0
 /

 & IC_refine_params
  on = f
  n_refine = 0,0,2
  center   = 0.0,0.0,0.0
  extent   = 0.0,0.0,0.5

&refine_params          on=f levelmax=12 levelmin=1 verbose=3 check_interval=2 /
