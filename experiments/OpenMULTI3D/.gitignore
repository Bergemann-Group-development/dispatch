# The parent repository ignores new experiment files by default. Keep the test
# source and its reviewed fixtures visible without exposing generated artifacts.
!.gitignore
!AGENTS.md
!AUTHORS
!LICENSE
!README.md
!QUICKSTART.md
!CLAUDE.md
!SUBAGENTS.md
!docs/
docs/*
!docs/GLOSSARY.md
!docs/Doxyfile
!docs/doxygen_filter.pl
!docs/manual/
docs/manual/*
!docs/manual/main.tex
!docs/manual/ref.bib
!docs/manual/tabs/
!docs/manual/figs/
# everything in figs/ is source of the manual, whatever its format, including the
# figures drawn by figs/science_case.py, so the manual builds without the runs and
# the observed atlas
!docs/manual/figs/**
!docs/PythonNamingConventions.md
!tests/
tests/*
!tests/README.md
!tests/*.py
!tests/support/
!tests/fixtures/
!tests/science/
!tests/io/
!tests/workflows/
!tests/execution/
!tests/studio/
!tests/browser/
!tests/native/

# Reviewed example inputs are source whatever their extension; the broad *.txt and
# similar data rules above would otherwise hide them.
!tests/fixtures/**

# Golden data, until the references are reviewed and given provenance.
!tests/golden/
tests/golden/*
!tests/golden/*.npz

# Caches and anything a test run writes stay out, at any depth.
tests/**/__pycache__/
tests/**/.pytest_cache/
tests/**/*.pyc

# Nothing is needed here for tumult/, HOP/, SRC/ or TumultStudio/:
# the parent repository negates those directories wholesale, so new files in them
# are visible.

# The parent repository ignores *.txt as data; these are source.
!pyproject.toml
!slurm/
slurm/*
!slurm/.gitkeep
!pytest.ini

# Local reports, helper scripts and the retired GUI are not repository source.
reports/
TumultStudio2/

# Helper scripts are source; everything else that lands in bin/ is not.
!bin/
bin/*

# Reusable, input-agnostic API benchmark drivers, the convergence namelists
# and the paper benchmark runs.
# Native outputs stay under data/.
!benchmarks/
benchmarks/*
!benchmarks/api/
!benchmarks/api/*.py
!benchmarks/api/README.md
!benchmarks/convergence/
!benchmarks/convergence/*.nml
!benchmarks/convergence/README.md
!benchmarks/paper/
!benchmarks/paper/*.nml
!benchmarks/paper/benchmarks.tex

# Project skills and agents; local Claude settings and worktrees stay ignored.
!.claude/
.claude/*
!.claude/skills/
!.claude/agents/
.claude/**/__pycache__/

# Example namelists are source.
!examples/
!examples/*.nml

# The shipped namelist presets are source.
!tumult/presets/**/*.nml

# Agents' scratch work, campaign scripts, reports and notes stay untracked
# (scratch/, alpha_campaign/, docs/notes/); the parent rules already ignore them.

# HOP's default data tables are source; the parent rules ignore every folder named data
# and every .txt file.
!HOP/hopacity/data/
!HOP/hopacity/data/**
# The line-list fixture of HOP's tests, which the parent's *.txt rule would hide.
!HOP/tests/fixtures/**

# input/ holds downloads (line lists, absmet tables, atmosphere grids, spectra) and
# user files; only these are source: the links to HOP's default data, the sample
# atmospheres and atoms, the line list the native tests use and the line masks.
!input/
input/*
!input/Anstee-1802-2014.txt
!input/absdat
!input/abund
!input/isotopes
!input/molec
!input/vcs
!input/atmos/
input/atmos/*
!input/atmos/mdw.mod
!input/atmos/metal_poor_rgb.mod
!input/atmos/metal_poor_tos.mod
!input/atmos/rsg.mod
!input/atmos/sun.mod
!input/atmos/p4000_g+4.5_m0.0_t01_st_z+0.00_a+0.00_c+0.00_n+0.00_o+0.00_r+0.00_s+0.00.mod
!input/atmos/p5777_g+4.4_m0.0_t01_st_z+0.00_a+0.00_c+0.00_n+0.00_o+0.00_r+0.00_s+0.00.mod
!input/atmos/p6500_g+4.0_m0.0_t01_st_z-3.00_a+0.40_c+0.00_n+0.00_o+0.40_r+0.00_s+0.00.mod
!input/atmos/s4000_g+1.0_m15._t05_st_z+0.00_a+0.00_c+0.00_n+0.00_o+0.00_r+0.00_s+0.00.mod
!input/atmos/s5000_g+2.0_m1.0_t02_st_z-3.00_a+0.40_c+0.00_n+0.00_o+0.40_r+0.00_s+0.00.mod
!input/atoms/
input/atoms/*
!input/atoms/atom.ba06
!input/atoms/atom.fe607a
!input/atoms/atom.mg86e
!input/atoms/atom.mg86g
!input/atoms/atom.o41f
!input/linelists/
input/linelists/*
!input/linelists/master_line.txt
!input/linemasks/
!input/linemasks/**
