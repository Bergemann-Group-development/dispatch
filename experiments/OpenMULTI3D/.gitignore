# The parent repository ignores new experiment files by default. Keep the
# execution regression tests reviewable without exposing generated artifacts.
!.gitignore
!AGENTS.md
!CLAUDE.md
!SUBAGENTS.md
!docs/
docs/*
!docs/FAQ.md
!docs/GLOSSARY.md
!docs/GUIWorkflow.md
!docs/PythonNamingConventions.md
!tests/
tests/*
!tests/test_execution.py
!tests/test_ui_execution.py
!tests/test_flux_sets.py
!tests/test_linemask.py
!tests/test_linediag.py
!tests/test_sparams.py
!tests/test_ladder_workflows.py
!tests/test_segments.py
!tests/test_nlte_corrections.py
!tests/test_continuum.py
!tests/test_spectrum_io.py

# Keep development plans visible under the parent experiment ignore rule.
!plan/
!plan/*.md

# Nothing is needed here for tumult/, HOP/, SRC/ or TumultStudio2/: the parent
# repository negates those directories wholesale, so new files in them are visible.

# The parent repository ignores *.txt as data; the GUI extras file is source.
!requirements-gui.txt
!tests/test_synthesis_preparation.py
!tests/test_synthesis_contract.py

# Review documents are maintained source; benchmark outputs remain ignored.
!reports/
reports/*
!reports/review/
reports/review/*
!reports/review/*.md

# Helper scripts are source; everything else that lands in bin/ is not.
!bin/
bin/*
!bin/tpy

# The ionisation-balance harness and its comparison script are the reproduction path the
# review reports promise. Their outputs under reports/bench/ stay ignored by reports/*.
!reports/bench_ionbalance.py
!reports/bench_table.py

# The same for the 3D departure-resolution harness, its comparison script, and the
# end-to-end check of the snapshot two-phase API against real dispatch.x runs.
!reports/bench_departures.py
!reports/depfield_table.py
!reports/verify_departure_api.py

# The HOP library gate and the golden data it pins (the other goldens predate these rules
# and are tracked already; this makes a new or regenerated one visible in git status).
!tests/test_hop.py
!tests/golden/
tests/golden/*
!tests/golden/*.npz
