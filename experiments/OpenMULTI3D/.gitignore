# The parent repository ignores new experiment files by default. Keep the test
# source and its reviewed fixtures visible without exposing generated artifacts.
!.gitignore
!AGENTS.md
!CLAUDE.md
!SUBAGENTS.md
!docs/
docs/*
!docs/FAQ.md
!docs/GLOSSARY.md
!docs/GUIWorkflow.md
!docs/PythonNamingConventions.md
!tests/
tests/*
!tests/README.md
!tests/*.py
!tests/support/
!tests/fixtures/
!tests/science/
!tests/io/
!tests/workflows/
!tests/execution/
!tests/studio/
!tests/browser/
!tests/native/

# Reviewed example inputs are source whatever their extension; the broad *.txt and
# similar data rules above would otherwise hide them.
!tests/fixtures/**

# Golden data, until the references are reviewed and given provenance.
!tests/golden/
tests/golden/*
!tests/golden/*.npz

# Caches and anything a test run writes stay out, at any depth.
tests/**/__pycache__/
tests/**/.pytest_cache/
tests/**/*.pyc

# Nothing is needed here for tumult/, HOP/, SRC/, TumultStudio/ or TumultStudio2/:
# the parent repository negates those directories wholesale, so new files in them
# are visible.

# The parent repository ignores *.txt as data; these are source.
!requirements-gui.txt
!requirements-test.txt
!pytest.ini

# Review documents are maintained source; benchmark outputs remain ignored.
!reports/
reports/*
!reports/tests.md
!reports/test-requirements.md
!reports/api_scripting_plan.md
!reports/api_scripting_implementation.md
!reports/review/
reports/review/*
!reports/review/*.md

# Helper scripts are source; everything else that lands in bin/ is not.
!bin/
bin/*
!bin/tpy

# The ionisation-balance harness and its comparison script are the reproduction path the
# review reports promise. Their outputs under reports/bench/ stay ignored by reports/*.
!reports/bench_ionbalance.py
!reports/bench_table.py

# The same for the 3D departure-resolution harness, its comparison script, and the
# end-to-end check of the snapshot two-phase API against real dispatch.x runs.
!reports/bench_departures.py
!reports/depfield_table.py
!reports/verify_departure_api.py

# Reusable, input-agnostic API benchmark drivers. Native outputs stay under data/.
!benchmarks/
benchmarks/*
!benchmarks/api/
!benchmarks/api/*.py
!benchmarks/api/README.md
