#!/bin/sh
# Run Python with this checkout importable, on an interpreter that has its dependencies.
#
# Ad-hoc scripts need the project directory on sys.path so that `tumult` and
# `TumultStudio` import by their real names. The test suite gets the same path from
# pytest, which puts the project directory there for the test packages under tests/.
#
# Resolution order: $TUMULT_PYTHON, the checkout's own .venv, the conda environment named
# by $TUMULT_ENV (default tumult_studio), then python3 on PATH. Do not prepend a conda
# directory to PATH to select an interpreter: with the base environment activated that
# shadows .venv with an interpreter carrying none of the dependencies, which fails on the
# first `import numba` and looks like a missing installation.
#
#   bin/tpy reports/bench_table.py reports/bench/crop5 reports/bench/unfolded
#   bin/tpy -c 'import tumult; print(tumult.__file__)'
#   bin/tpy --which          # report the interpreter and paths, run nothing
set -e
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
env_name=${TUMULT_ENV:-tumult_studio}

py=${TUMULT_PYTHON:-}
if [ -z "$py" ] && [ -x "$root/.venv/bin/python" ]; then
    py="$root/.venv/bin/python"
fi
if [ -z "$py" ]; then
    for candidate in "${CONDA_EXE%/bin/conda}/envs/$env_name/bin/python" \
                     "$HOME/miniforge3/envs/$env_name/bin/python" \
                     "$HOME/miniconda3/envs/$env_name/bin/python" \
                     "$HOME/anaconda3/envs/$env_name/bin/python"; do
        if [ -x "$candidate" ]; then py="$candidate"; break; fi
    done
fi
if [ -z "$py" ]; then
    py=$(command -v python3 || command -v python || true)
fi
if [ -z "$py" ]; then
    echo "tpy: no usable Python found; set TUMULT_PYTHON" >&2
    exit 127
fi

PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
if [ "$1" = "--which" ]; then
    printf '%s\nPYTHONPATH=%s\n' "$py" "$PYTHONPATH"
    exit 0
fi
exec "$py" "$@"
