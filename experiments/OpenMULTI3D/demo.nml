! -- Parameters defining the run -----------------------------------------------
&io_params          datadir='data' gb_step=6.0 do_trace=F /
&timer_params       sec_per_report=1e8 verbose=2 /
&atmos_params       atmos_file='./input/atmos/p5777_g+4.4_m0.0_t01_st_z+0.00_a+0.00_c+0.00_n+0.00_o+0.00_r+0.00_s+0.00.mod' /
&atom_params        atom_file='./input/atoms/atom.ba06' use_atom_abnd=T convlim=1d-2 /
&m3d_params         verbose=1 maxiter=99 ng_step=20 /
!&linelist_params    linelist_file='./input/linelists/master_line.txt' /
!&spectrum_params    daa=0.01 aa_blue=4840 aa_red=4880 /