! -- Parameters defining the run -----------------------------------------------
&io_params          datadir='data' gb_step=6.0 do_trace=F /
&timer_params       sec_per_report=1e8 verbose=2 /
&atmos_params       dims=32 nx=30 ny=30 nz=96 atmos_format='m3dis' atmos_file='input/atmos/SunLTE_t5777_g4.440_z0.000_sn779_m3dis' /
&linelist_params    linelist_file='./input/linelists/sed_benchmark.txt' /
&spectrum_params    R_sampling=1e5 aa_blue=4000 aa_red=9000 /
&m3d_debug_params   verbose=2 /