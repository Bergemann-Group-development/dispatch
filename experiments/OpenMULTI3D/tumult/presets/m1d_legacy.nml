&rt_output_params
  angle_quad = 'Gauss'
  ntheta = 3
  sample_back_opac = .false.
/
&run_params
  rotate_atmos = .false.
/
&atom_params
  overlapping_bb = .false.
  overlapping_bf = .false.
  legacy_freql = .true.
  use_classic_col = .false.
  level_partf = .true.
  use_atom_abnd = .true.
/
&composition_params
