! Comparison with Multi3D: its z-mesh, angle sets and composition, with no frozen columns.
! Use on its own rather than combined.
&atmos_params
  use_ne = .true.
  use_rho = .true.
  amr = 'Z'
  nz = 230
  dims = 32
/
&nlte_params
  decouple_continuum = .false.
  initial_Jnu = 'zero'
  premature_finish = .false.
  convmax = 0
/
&rt_iteration_params
  angle_quad = 'set_a4'
  sample_back_opac = .false.
/
&rt_output_params
  angle_quad = 'lobatto'
  sample_back_opac = .false.
/
&run_params
  rotate_atmos = .false.
/
&atom_params
  overlapping_bb = .true.
  overlapping_bf = .true.
  legacy_freql = .false.
  level_partf = .true.
  use_atom_abnd = .false.
/
&composition_params
  h_occupation_probability = .false.
  mhd_eos = .false.
  helium_scattering = .false.
  irwin_dis = .false.
  absdat_file = 'input/absdat/MULTI_absdat.txt'
  abund_file = 'input/abund/legacy_abund.txt'
  molec_file = 'input/molec/molec_data.txt'
  molecule_damping_estimates = .false.
/