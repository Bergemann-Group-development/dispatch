! TumultStudio NLTE departures preset -- layered on top of base.nml.
! Solves the NLTE departure coefficients ONLY: long_scheme='none' skips the formal
! solution, so NO spectrum is written (Spectrum.has_spectrum is False). Use nlte.nml
! for NLTE runs that need a spectrum.
&m3d_params      maxiter=99 ilambd=3 long_scheme='none' /
&atmos_params    save_atmos=.true. /
&atom_params     relative_abundance=.true. convlim=1e-2 /
