! TumultStudio NLTE preset -- layered on top of base.nml for NLTE runs that produce a
! spectrum. Same NLTE iteration as departures.nml but WITHOUT angle_quad='none', so the
! formal solution runs and a spectrum is written. (The library's two-step NLTE path forces
! rt_output_params angle_quad='none' on the departure runs itself; see tumult/synthesis.py.)
&rt_iteration_params maxiter=99 /
&rt_output_params    maxiter=3 /
&nlte_params     convlim=1e-2 /
&atmos_params    save_atmos=.true. /
&atom_params     relative_abundance=.true. /
