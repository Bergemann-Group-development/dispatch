! Comparison with MULTI 1D: its frequency quadrature, Gauss angles, collision rates and
! composition, with decoupled continua and the absmet lines split into absorption and
! scattering by van Regemorter's epsilon, as MULTI does (line_scattering). Use on its
! own rather than combined.
&atmos_params
  use_ne = .true.
  use_rho = .false.
  use_vel = 3*.false.
  amr = 'Z'
/
&nlte_params
  decouple_continuum = .true.
  initial_Jnu = 'zero'
  premature_finish = .false.
  convmax = 0
/
&rt_iteration_params
  angle_quad = 'Gauss'
  ntheta = 3
  sample_back_opac = .false.
/
&rt_output_params
  angle_quad = 'Gauss'
  ntheta = 3
  sample_back_opac = .false.
/
&run_params
  rotate_atmos = .false.
/
&atom_params
  overlapping_bb = .false.
  overlapping_bf = .false.
  legacy_freql = .true.
  level_partf = .true.
  use_atom_abnd = .true.
/
&composition_params
  h_occupation_probability = .false.
  mhd_eos = .false.
  helium_scattering = .false.
  irwin_dis = .false.
  absdat_file = 'input/absdat/MULTI_absdat.txt'
  abund_file = 'input/abund/legacy_abund.txt'
  molec_file = 'input/molec/molec_data.txt'
  molecule_damping_estimates = .false.
/
&linelist_params
  line_scattering = .true.
/