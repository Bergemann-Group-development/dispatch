! Comparison with Turbospectrum: its data files, MARCS densities and abundances, and its
! 12-point disk-centre-to-limb output angles. Use on its own rather than combined.
&atmos_params
  atmos_format = 'Marcs'
  use_rho = .false.
  use_abnd = .true.
/
&rt_output_params
  angle_quad = 'custom'
  custom_mu = '1.0, 0.974726, 0.916958, 0.830825, 0.722203, 0.598497, 0.468138, 0.340008, 0.222841, 0.124619, 0.052035, 0.010018'
/
&composition_params
  molec_file = 'input/molec/molec_data_MARCS.txt'
  absdat_file = 'input/absdat/TS_absdat.txt'
  hydrogen_profiles = 'stehle'
  mhd_eos = .false.
  molecule_damping_estimates = .false.
/
&linelist_params
  dlam = 100
  tolerance = 0.001
/