&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 guard_zones=t
 method='parallel'
 restart=250
/

&dispatcher0_params
  verbose=0
  debug=f
/

&timer_params
 sec_per_report=20.0
/

&out_params
 end_time=1.7850e8 ! 2000 orbits at 0.02 au
 out_time=4.4625e2 ! 1 output every 0.01 orbit at 0.02 au
 print_time=100.0
/

&IC_params
  with_density_floor=.true.
  disc_mass=0.01 ! in M_Sun
  pbeta0=0.922e3
  rotating_disk=t
  opening_angle=3.0
/

&experiment_params
  coord_type='spherical'
  n_patches=18,7,1
  n_per_patch=40,42,1
  extent=9.95,1.0,2.0 ! r, theta, phi; angular extents as factor of pi
  r_offset=0.05 ! in AU
/

&zeus_params
  gamma = 1.01
  trnvrsn = 0
  dtinit = 1.0e-2
  itote = 0
  qlin=0.1
  qcon=2.0
  iord=2
  iords=2
  istp=0
  nuscalar=0.0
  courant=0.25
/

&zeustw_params
  gamma = 1.01
  qlin=0.1
  qcon=2.0
  courant=0.25
/

&timestep_params
  time_order=0
/

&patch_params
  periodic=f
  no_mans_land=f
  grace=0.01
  ng=3*3
/

&pebble_params
  do_pebbles=t
  do_split=f
  verbose=1
  ppc=1.0
  debug=f
  trace_every=100
/
