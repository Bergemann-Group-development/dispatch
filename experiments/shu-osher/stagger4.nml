&timer_params           /
&io_params              verbose=0 do_trace=f do_debug=f do_output=t method='parallel' /

!&cartesian_params             size=2,0.002,0.002 dims=1,1,1 origin=-1,-0.001,-0.001 /
&cartesian_params             size=9,1.,1. dims=1,1,1 origin=-4.5,0.0,0.0 /
&patch_params           n=800,1,1 ng=3*4 nt=5 no_mans_land=f /
!
&out_params             end_time=2.001 out_time=0.1 print_time=0.0 guard_zones=f /
!
&initial_params         P_l=10.33333 P_r=1.0 rho_l=3.857143 
                        vx_l=2.629369 vx_r=0.0 x_disc = -4.0
                        a_d = 0.2 f_d = 5.0 /
&timestep_params        time_order=2 /
&refine_params          do_refine=f tol_shock=0.1 tol_contact=0.1 min_dx=0.0025 grad_var='d' tol_grad=0.1 /
&zeus_params            gamma=1.4 trnvrsn=0 dtinit=1.0e-5 itote=1 qlin=0.2 qcon=1.0 iord=2 iords=3 istp=2 /
&ramses_params          courant_factor=0.25 gamma=1.4 slope_type=3.5 smallr=1e-4 smallc=5e-1 riemann='hllc' /
                                        !     cs   pa  ofd  mas  kap  eta
&stagger_params             gamma=1.4 nu=  0.2, 0.0, 0.5, 0.01, 0.05, 1.0
                            cdtd=0.5 /
&force_params           /

