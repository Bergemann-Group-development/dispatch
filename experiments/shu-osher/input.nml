&timer_params           /
&io_params              verbose=0 do_trace=f do_debug=f do_output=t guard_zones=t nml_version=1/

!&cartesian_params       size=2,0.002,0.002 dims=1,1,1 origin=-1,-0.001,-0.001 periodic=f,t,t /
&cartesian_params       size=9,0.003,0.003 dims=5,1,1 origin=-4.5,0.0,0.0 periodic=f,t,t /
&patch_params           n=150,1,1 ng=3*6 nt=5 no_mans_land=t grace=0.05 do_check_nan=t/
!
&out_params             end_time=2.001 out_time=0.1 print_time=0.0 /
!
&initial_params         P_l=10.33333 P_r=1.0 rho_l=3.857143 
                        vx_l=2.629369 vx_r=0.0 x_disc = -4.0
                        a_d = 0.2 f_d = 5.0 /
&timestep_params        time_order=3 /
&refine_params          on=f /
&zeus_params            gamma=1.4 trnvrsn=0 dtinit=1.0e-5 itote=1 qlin=0.2 qcon=1.0 iord=2 iords=3 istp=2 /
                                        !     cs   pa  ofd  mas  kap  eta
&stagger_params             gamma=1.4 nu=  0.12, 0.05, 1.0, 0.0, 1.0, 1.0 /

&force_params           /


&ramses_params
 courant_factor=0.25
 csound=1.0
 gamma=1.6666667
 slope_type=3
 !smallr=1e-4
 !smallc=5e-1
 !slope_type=3.5
  smallr=1e-5
  smallc=1e-0
/
                                        
&bifrost_params             
gamma=1.4
loginterpolation=t
ca_max = 3e2 
courant=0.2
max_r=3
symmetric_e=f
!     Ca    U    Uv   d     e      E
!     nu1   nu2  nu3  nu_d  nu_ee  eta3
nu=  0.03 , 0.3,  0.1,  0.0,  0.05, 0.9 /

&dispatcher_params      method=0 /
&dispatcher3_params     verbose=0 f_over=3 use_taskyield=f use_critical=f /
