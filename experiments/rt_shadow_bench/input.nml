&io_params
 verbose=0
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
/

&out_params
 end_time=2d-9
 out_time=2d-9
 print_time=0.0
 guard_zones=t
 time_derivs=f
/

&box_params
 size=1.0,1.0,1.0
 dims=3,3,3
 origin=0.0,0.0,0.0
 !origin=-0.005,-0.005,-0.005
/

&patch_params
 nt=5
 courant=0.0
 grace=0.1
 n=43,43,43
 dt_fixed=1d-10
 no_mans_land=f
/

&eos_params
  gamma=1.666667
  do_rt=t
/

! ------- Radiative transfer ---------
&rt_params
 solver='integral'
 use_data_hub=t
 do_output=t
 cr_heating=0.0
 init_time=-1d-5
 debug=f
 detailed_timer=f
 dtau='staggered'   !other options: centered, weighted
/

&cartesian_ray_geometry_params
do_chains=f
! along x axis
nx=1 xti=0.,45.
! along y axis
ny=1 yti=0.,45.
! along z axis
nz=1 zti=0.,45.
! use space_diagonals?
space_diagonals=t
/

! Treatment of boundary conditions for RT solver. 
&rt_bc_params
 cool_temp=290.0
 hot_temp =1740.0
/


&mhd_params
 nu=  0.20, 1.0, 1.0, 0.2, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
 gamma=1.666667
/

&timestep_params
 !time_order=2
/

&initial_params
 clump_pos=0.5,0.5,0.5 
 !clump_pos=0.6666,0.6666,0.6666
 d0=1.0
 clump_dfact=10.0
 !t0=103530.0
 t0=290.0
 clump_a=0.1
 clump_b=0.06
 gamma=1.666667
/
&force_params   /
