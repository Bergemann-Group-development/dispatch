
&cartesian_params     
 size=1,1,1
 dims=4,4,4
 mpi_dims=2,2,2
 origin=0,0,0 
 periodic=t,t,f
 /

 & initial_refine_params
  on = f
  n_refine = 0,0,2
  ratio=2.0
  center   = 0.0,0.0,0.5
  extent   = 0.0,0.0,0.2


&out_params
 end_time=1d-5
 out_time=1d-7
 print_time=0.0
 /

&aux_params         verbose=1 select='tt','qr'/

&io_params
 verbose=0 
 do_trace=t
 omp_trace=t
 do_output=t  
 id_debug=0
 restart=-1  
 guard_zones=f
 method='legacy'
 namelist_errors=t
/

&patch_params
 nt=5
 grace=0.2
 n=32,32,32
 no_mans_land=t
 use_data_hub =f
 !dt_fixed=1d-8
 do_check_nan=f 
/

&eos_params
   gamma=1.666667/
&timestep_params        time_order=2 /
&ramses_params          /

&timer_params           sec_per_report=20 /
&dispatcher_params      method=0 /

&dispatcher0_params     verbose=0 debug=.false. /
&task_list_params       verbose=0 job_seconds=1e6 /
&task_mesg_params       verbose=0 /
&mpi_mesg_params        verbose=0 /
&lock_params            verbose=0 /

&download_params        verbose=0 /
!&download_params        verbose=0 use_locks=t use_different=-2 sorted=t check_filled=t id_debug=0 /



! ------- Radiative transfer ---------
&sc_rt_params              
 on =t
 verbose=-1
 nt=3
 n_mu=2
 n_phi=4
 n_bin=4
 n_warmup=10
 rt_timestep=1d-8
 rt_grace=0.05
 rt_llc = 0,0,0
 rt_urc = 1,1,1 
 vertical_propagation = f
 cdtd=0.1
 rt_freq=10
 dnload_mhd=f
/

&rt_integral_params verbose=0 dtau_min=1e-2 dtau_dif=1e6 dtau_max=1e2 solver=2 order=1 /

&rt_setup_params        verbose=0 n_warmup=6 unique_ids=t omp_warmup=f/

! Treatment of boundary conditions for RT solver. 
&boundary_params
cool_temp = 290!103530!40000 !290   ! in kelvins
hot_temp  = 1740!621180!240000 !1740
wall = f,f,
       f,f,
       t,f
/

&cartesian_ray_geometry_params
do_chains=f
! along x axis
nx=2 xti=0.,45.
! along y axis
ny=2 yti=0.,45.
! along z axis
nz=2 zti=0.,45.
! use space_diagonals?
space_diagonals=t
/

&stagger_params
 nu=  0.15, 1.0, 1.0, 0.05, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
/
&ramses_params
 slope_type=2
 courant_factor=0.8
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/
&timestep_params
 time_order=2
/

&IC_params
 clump_pos = 0.5,0.5,0.5 
 !clump_pos = 0.6666,0.6666,0.6666
 d0=1.0
 clump_dfact=10.0
 !t0=103530.0
 t0=290.0
 clump_a=0.06
 clump_b=0.1
/

&bifrost_params             
loginterpolation=t
ca_max = 3e2 
courant=0.20
max_r=3
symmetric_e=f
eos='tabular'
!     nu1   nu2  nu3  nu_d  nu_ee  eta3
!nu=  0.6, 0.6, 0.6, 0.6, 0.6, 0.3 /
!nu=  0.3, 0.2, 0.3, 0.0, 0.3, 0.3 /
nu=  0.03 , 0.3,  0.1,  0.0,  0.05, 0.8 /
!nu=  0.01, 0.03, 0.1, 0.05, 0.05, 0.3 /


&divb_clean_params
 on=f
 /
