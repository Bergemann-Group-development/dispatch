
&rubiks_params
 size=3*0.1111111
 n_levels=2                         ! # of refinement levels in for the rubiks cube
 n_patch=3                          ! # of patches per direction
 m_zoom=3                           ! zoom-in level per direction
 n_repeat=1                         ! how many times rubiks cube is repeated along the orbit
/

&cartesian_params     
 size=1,1,1
 dims=3*3
 mpi_dims=2,2,1
 origin=0,0,0 
 periodic=f,f,f
 omp_init=f  /


&out_params
 end_time=1d-6
 out_time=1d-7
 print_time=0.0
 /

 &aux_params         verbose=0 select='tt','qr','rkap','src' /

&io_params
 verbose=1 
 do_trace=f
 omp_trace=f
 do_output=t  
 id_debug=0
 restart=-1  
 guard_zones=f
 nml_version=1
/

&patch_params
 nt=5
 grace=0.02
 n=32,32,32
 !dt_fixed=1d-11
 no_mans_land=t
 use_data_hub =f
 !dt_fixed=1d-8
/

&eos_params
   /
&timestep_params        time_order=2 /
&ramses_params          /

&timer_params           sec_per_report=20 /
&dispatcher_params      method=0 /
&dispatcher3_params     verbose=0 f_over=3 use_taskyield=f use_critical=t /
&download_params        verbose=0 /
&task_list_params       job_seconds=1e6 /
&task_mesg_params       verbose=1 /
&mpi_mesg_params        verbose=1 debug=.true. /


&download_params        verbose=0 use_locks=t use_different=-2 sorted=t check_filled=t id_debug=0 /

&eos_params
  gamma = 1.666667
  do_rt = t
/


! ------- Radiative transfer ---------
&hybrid_rt_params              
 on =t 
 verbose=0 
 nt=1
 n_mu=4
 n_phi=12
 n_lambda=1
 epsilon=0.9
 rt_timestep=1d-9
 rt_grace=0.02
 rt_llc = 0,0,0
 rt_extent = 1,1,1 
 vertical_propagation = f
 dtau = 'weighted'
 !dtau = 'staggered'
/

&sc_rt_params              
 on =t 
 verbose=0 
 nt=1
 n_mu=5
 n_phi=4
 n_bin=1
 n_warmup=5
 rt_timestep=1d-8
 rt_grace=0.02
 rt_llc = 0,0,0
 rt_urc = 1,1,1 
 vertical_propagation = f
/

&rt_integral_params verbose=0 dtau_min=1e-1 dtau_dif=1e6 order=1 /

&rt_setup_params        verbose=0 n_warmup=3 unique_ids=t omp_warmup=f/

! Treatment of boundary conditions for RT solver. 
&rt_bc_params
cool_temp = 290!103530!40000 !290   ! in kelvins
hot_temp  = 1740!621180!240000 !1740
wall = f,f,
       f,f,
       t,f
/

&cartesian_ray_geometry_params
do_chains=f
! along x axis
nx=2 xti=0.,45.
! along y axis
ny=2 yti=0.,45.
! along z axis
nz=2 zti=0.,45.
! use space_diagonals?
space_diagonals=t
/

&stagger_params
 nu=  0.15, 1.0, 1.0, 0.05, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
 gamma=1.666667
/
&ramses_params
 gamma=1.666667
 slope_type=2
 courant_factor=0.8
 smallr=1e-20
 smallc=1e-3
 do_isothermal=f
 csound=0.2
 detailed_timer=f
/
&timestep_params
 time_order=2
/

&IC_params
 clump_pos = 0.5,0.5,0.5 
 !clump_pos = 0.6666,0.6666,0.6666
 d0=1.0
 clump_dfact=10.0
 !t0=103530.0
 t0=290.0
 clump_a=0.1
 clump_b=0.06
 gamma=1.666667
/

