&timer_params           /
&io_params              verbose=0 do_trace=f do_debug=f do_output=t guard_zones=f method='background'/

! in X
&cartesian_params       size=1,0.003,0.003 dims=12,1,1 mpi_dims=1,1,1 origin=0.0,0.0,0.0 periodic = f,t,t /
&patch_params           n=100,1,1  nt=5 no_mans_land=t grace=0.05 do_check_nan=t use_data_hub=f /

&out_params             end_time=0.1 out_time=1e-2 print_time=0.0 /

!& aux_params            select='tt','pg' /

&IC_params         
                        rho_l = 1
                        vx_l  = 0
                        vy_l  = 0
                        vz_l  = 0
                        Bx_l  = 0.75
                        By_l  = 1.0
                        Bz_l  = 0
                        p_l   = 1.0
                        rho_r = 0.125
                        vx_r  = 0
                        vy_r  = 0
                        vz_r  = 0
                        Bx_r  = 0.75
                        By_r  = -1.0
                        Bz_r  = 0
                        p_r   = 0.1
                        idir  = 1
                        /
&timestep_params        time_order=2 /

& initial_refine_params
  on = f
  n_refine = 0,0,2
  center   = 0.0,0.0,0.0
  extent   = 0.0,0.0,0.5

&refine_params          on=f levelmax=12 levelmin=1 verbose=3 check_interval=2 /

grad_var='d' tol_grad=0.1 /

&eos_params
  gamma=2.0
  !s0=10.
/
                                        
&bifrost_params             
loginterpolation=t
ca_max = 3e2 
courant=0.3
symmetric_e=f
!     Ca    U    Uv   d     e      E
!     nu1   nu2  nu3  nu_d  nu_ee  eta3
!nu=  0.01 , 0.3,  0.1,  0.5,  0.5, 0.9 /
nu=  0.06 , 0.15,  0.5,  0.05,  0.3, 0.3 /

&ramses_params
  slope_type=2
/

&dispatcher_params      method=0 /
&dispatcher3_params     verbose=0 f_over=3 use_taskyield=f use_critical=f /

&divb_clean_params
 on=f
 divb_iter=4
 divb_cleaner=0
 /

! -- Framework parameters ------------------------------------------------------
&halo_params            check_filled=f /
&guards_params          /
