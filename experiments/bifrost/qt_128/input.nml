! This default input file is used for development and testing purposes.
! It also shows an example of all the necessary namelist entries.

&load_balance_params
/

&dispatcher_params 
 method=0 
/

&mpi_mesg_params
 max_sent=500
 max_recv=100
 min_nq=10
/
&timer_params
 sec_per_report=2
/
&io_params
 verbose=2
 do_validate=f
 do_debug=f
 do_output=f
 do_trace=t
 omp_trace=f
/
&cartesian_params
 size=1,1,1 dims=1,1,1 mpi_dims=1,1,1                !  1 proces
 origin=0,0,0
/
&experiment_params
/

&bifrost_mesh_params
 meshfile = 'qt_128x128x128.mesh'
 dims = 3*128
 dx =  1.875E-01
 dy =  1.875E-01
 dz =  1.969E-01
/

&patch_params
 nt=5
 ng=10
 courant=0.2
 grace=0.3
 n=3*128
!dt_fixed=0.001
/
&out_params
 end_time=1e-3
 out_time=0.05
 print_time=0.0
 guard_zones=f
 time_derivs=f
/

&timestep_params
 time_order=2
/

&IC_params
 k=3,3,3
 a0=0.0,0.0,0.0
 u0=0,0,0
 b0=0,0,0.0
 !type='single_compressive'
 !type='single_solenoidal'
 type='single_advection'
 !type='raw'
/
