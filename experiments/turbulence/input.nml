&io_params
 do_trace=t
 verbose=5
 do_debug=f
/
&box_params
 size=1,1,1
 dims=2,2,2
 origin=0,0,0
/
&experiment_params
 d0=1.2
 B0=0.0,0.0,0.0
/
&patch_params
 nt=5
 n=20,20,20
!dt_fixed=0.03
/
&out_params
 end_time=0.006
 out_time=0.1
 print_time=0.0001
 guard_zones=t
 time_derivs=f
/
&mhd_params
 courant=0.1
 nu=  0.05,  0.6, 2.0, 1.0,  0.2,  1.0
 !     cs    du   pa   ofd   mas   eta
/
&timestep_params
 time_order=2
/
&force_params
 k=1,1,2
 a0=1,1.2,1.1
 t_turn=0.30
 type='single_solenoidal'
/
&initial_params
 k=3,3,3
 a0=0.0,0.0,0.0
 u0=0,0,0
 b0=0,0,0.3
 type='single_compressive'
/
