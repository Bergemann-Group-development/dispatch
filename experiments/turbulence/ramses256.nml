! $Id$
!
! This default input file runs turbulence at 50x50x50 resolution in 2x2x2 patches.
! It should take only a few minutes on a laptop, and produces 10 snapshots in time.
!
! Do not modify the input.nml file to make experiments with other parameters.
! Instead, copy input.nml to othername.nml, and run ./dispatch.x other.nml, which
! produces data files named data/other_ppp_tttt.dat, where ppp is the patch number
! and tttt is the snapshot number.

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=f
/
&box_params
 face_nbors=f
 size=1,1,1
 !dims=16,16,16
 dims=8,8,8
 !dims=2,2,2
 !dims=1,1,1
 origin=0,0,0
/
&experiment_params
/
&patch_params
 nt=3
 courant=0.2
 grace=0.1
 !n=16,16,16
 n=32,32,32
 !n=128,128,128
 !n=256,256,256
!dt_fixed=0.001
/
&out_params
 end_time=0.2
 out_time=0.02
 print_time=0e-3
 guard_zones=t
 time_derivs=f
/
&mhd_params /
&timestep_params
 time_order=0
/
&force_params
 type='zero'
/
&initial_params
 k=3,3,3
 a0=0.0,0.0,0.0
 u0=0,0,0
 b0=0,0,0
 type='ramses256'
/
&timer_params
 calls_per_report=100000
/
&ramses_params
 courant_factor=0.8
 !courant_factor=0.266667
 gamma=1.00001
 slope_type=2
 !slope_type=-1
 smallr=1e-4
 smallc=5e-1
 riemann='hllc'
 !riemann='llf'
 do_isothermal=t
/
