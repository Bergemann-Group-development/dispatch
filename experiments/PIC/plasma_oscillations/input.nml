&particle_solver_params verbose=0 on=t /
&fields_params          verbose=0 /
&species_params         verbose=0 n=2 /
&particles_params       verbose=1 mass=1.0 test=t /
&particles_params       verbose=1 mass=.01 test=t /
&experiment_params      verbose=0 amplitude=0.01 /

&cartesian_params       size=1,1,1 dims=3*4 mpi_dims=2,1,1 origin=0,0,0 /
&patch_params           n=3*32 nt=5 grace=0.1 do_check_nan=f /

&io_params              verbose=0 do_trace=t omp_trace=t
                        do_output=t guard_zones=f time_derivs=0
                        end_time=1.0 out_time=0.1 print_every=1
/
&timer_params           sec_per_report=10 /
