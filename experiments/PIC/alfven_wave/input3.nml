&IC_params
 r0=0.25
 B0=0.1
 temp=1e-4
 gamma=1.6667
 beta = 10.
 expe = 1
 first_pic=t
/

&io_params
 verbose=0
 do_trace=f
 omp_trace=f
 do_debug=f
 do_output=t
 guard_zones=t
 nml_version=1
/


&cartesian_params
 size=1,1,3
 dims=1,1,3
 mpi_dims = 1,1,1
 origin=0,0,0
 periodic = f,f,f
/

&patch_params
 nt=5
 ng=3*4
 grace=0.02
 n=3*22
 no_mans_land=t
 do_check_nan=t
 !dt_fixed=0.05
 limit_dtime=f
/

&out_params
 end_time=2.1
 out_time=0.02
 print_time=0.0
/

&stagger_params
 verbose = 0
 eos = 'ideal'
 courant = 0.05
 gamma=1.6667
 nu=  0.10, 1.0, 1.0, 0.00, 0.1, 1.0
 !nu=  0.010, 0.5, 1.0, 0.0, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
/

&non_ideal_params
 mhd_Ohm=f
 eta_Ohm=0.05
/

&timer_params
 sec_per_report=300
 dead_mans_hand =-1.0
/

&timestep_params
time_order=2
/
&refine_params
on=f
/

! PIC parameters

&pic_params
 on= t
 do_pairs=f 
 do_mhd = f                            ! do MHD under PIC - should be true if pic is not completely overlapping the patch
 do_tests= f
 periodic_bcs=f,f,f
 region_llc=0.0,0.0,1.0
 region_extent=1,1,1 
/

&mpi        nx=1 ny=1 nz=1 /

&main       nspecies=2 seed=33 Cdt=.5 Cdtwpe=0.1 Cdtwce=0.5 /
&output     writefac=20 datadir='data' /

&species    name='electron' mass=1.0 charge=-1. npercell=20 verbose=1 /
&species    name='ion'      mass=50.0 charge=+1. npercell=20   /
!&species    name='electron' mass=1.00 charge=-1. npercell=100 verbose=1 /
!&species    name='ion'      mass=50.0 charge=+1. npercell=100 /

&maxwell    emf=0.55 tol_e=0.0001 tol_b=0.0001 do_e_fix=f verbose=0 do_b_fix=f /
&do         do_vth=t do_maxwell=t do_lorentz=t do_parallel_io=f /

&run_info   out_e_tot=t out_e_bal=t out_e_em=t out_e_pa=t out_namelists=t out_grid=t /
&dbgctl     do_check_interpolate=f trace=f trace_level=2 dbg=2 !dbg_select=1024
/
