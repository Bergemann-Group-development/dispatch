&IC_params
 r0=0.25
 B0=0.1
 temp=1e-4
 gamma=1.6667
 beta = 10.
 expe = 2
 first_pic=f
/

&io_params
 verbose=0
 do_trace=f
 omp_trace=f
 do_debug=f
 do_output=t
 method='parallel'
 guard_zones=t
 time_derivs=f
/

&cartesian_params
 size=1,1,3
 dims=1,1,3
 mpi_dims = 1,1,1
 origin=0,0,0
/

&patch_params
 nt=5
 ng=3*4
 grace=0.3
 n=3*32
 no_mans_land=t
 do_check_nan=t
 dt_fixed=1.6e-2
/

&out_params
 end_time=100.0
 out_time=0.5
 print_time=0.0
/

&stagger_params
 do_maxwell=t
 verbose = 0
 eos = 'ideal'
 courant = 0.2
 gamma=1.6667
 nu=  0.20, 1.0, 1.0, 0.0, 1.0, 1.0
 !     cs    pa  ofd  mas  kap  eta
/

&non_ideal_params
 mhd_Ohm=f
 eta_Ohm=0.05
/

&timer_params
 sec_per_report=300
/

&timestep_params
/
&refine_params
do_refine=t
region_llc=0.2,0.2,1.2
region_urc=0.8,0.8,1.8
/

! PIC parameters
&mpi        nx=1 ny=1 nz=1 /

&main       nspecies=2 seed=33 Cdt=.5 Cdtwpe=0.1 Cdtwce=0.5 /
&output     writefac=20 datadir='data' /

&init       do_pairs=f periodic_bcs=t,t,f /

&species    name='electron' mass=1.00 charge=-1. npercell=30 verbose=1 /
&species    name='ion'      mass=50.0 charge=+1. npercell=30 /
!&species    name='electron' mass=1.00 charge=-1. npercell=100 verbose=1 /
!&species    name='ion'      mass=50.0 charge=+1. npercell=100 /

&maxwell    emf=0.55 tol_e=0.0001 tol_b=0.0001 do_e_fix=f verbose=0 /
&do         do_vth=t do_maxwell=t do_lorentz=t do_parallel_io=f /

&run_info   out_e_tot=t out_e_bal=t out_e_em=t out_e_pa=t out_namelists=t out_grid=t /
&dbgctl     do_check_interpolate=f trace=f trace_level=2 dbg=2 !dbg_select=1024
/
