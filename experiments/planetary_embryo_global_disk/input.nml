&io_params
 verbose=2
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=t
/

&out_params
 end_time=630.0
 out_time=5e-4
 guard_zones=t
 print_time=1e-4
/

&IC_params
  mstar=1.0
/

&annulus_params
  rotating=t
  n_patch=1,1,1
  n_per_patch=1,128,384
  roffset=0.5
  extent=1.0,2.0,2.0 ! the phi-component is given in units of pi.
/

&zeus_params
  gamma = 1.0001
  trnvrsn = 0
  dtinit = 1.0e-5
  itote = 0
  qlin=0.1
  qcon=2.0
  iord=2
  iords=2
  istp=0
  nuscalar=0.0
/

&timestep_params
  time_order=0
/

&patch_params
  courant=0.5
  nt=5
  nw=1
/

&ring_params
 n_patch=1,3,9
 n_levels=1
 n_repeat=1
 m_zoom=3
 repeat_dir=3
 n_per_patch=1,32,32
 position=0,0,0
 planet_cylpos=0,1.0,0
 size=1,0.16666666,0.1745329
/

&rubiks_params
 n_repeat=1
 n_levels=2
 position=0,0,0
 n_patch=1,3,3
 !size=1,0.0025,0.002617995
 size=1,0.0185185185,0.0193925472 ! should correspond to level "4"
 m_zoom=3
 n_per_patch=1,32,32
 planet_cylpos=0,1.0,0
/

&planetesimal_params
  mass_final=1e-3
  radius=0.00046696
  ramp_mass=f
  aplanet=1.0
/

&refine_params
/
