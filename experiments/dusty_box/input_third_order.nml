&experiment_params
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: uniform background level for gas and dust
 !-----------------------------------------------------------------------------
 rho    =  1.0
 rho2   =  1.0
 P      =  1.0
 P2     =  0d0
 vx     =  0.0
 vx2    =  1.0
 vy     =  0d0
 vy2    =  0d0
 rhotr  =  0.5
/
&stagger_params              ! defaults are visible in the log file
 !nu=    0.2, 0., 0.1, 1., 0.1, 0.
 !nu=    0.1, 1., 0., 2., 0., 0.
 !nu=    0.2, 0., 0.5, 1., 1., 0.       !Personal best; pa, ofd and mas are pretty effective at bringing down ringing. Keep cs low!
 !nu=     0.2, 0., 2., 2., 2., 0.       !Slightly less ringing, slightly more continuous shock
 !nu=     0.5, 0., 3., 3., 3., 0.       !Avoids ringing in stationary shock
 !nu=     0.4, 0.4, 0.4, 0.4, 0.4, 0.
 !nu=    0.2, 0.0, 0.5, 1.0, 1.0, 0., 1.2, 10.0, 0.0, 3.2, 0.0, 0.0 !pa, mas, and eta are irrelevant
 !                                                                 do not raise cs above 1.5
 !                                                                 do not raise ofd above 3.0
 !                                                                 do not raise du above 10.0
 nu=    0.5, 0.0, 0.5, 1.0, 1.0, 0., 4.0, 25.0, 0.0, 10.0, 0.0, 0.0 ! <- Best one so far for Sod Epstein regime
 !nu=    1.0, 0.5, 0.5, 1.0, 1.0, 0., 0.3, 12.0, 0.0, 1.0, 0.0, 0.0 ! <- Best one so far for ordinary shock and Sod linear regime
 !     cs    du   pa   ofd   mas   eta
 gamma=1.0
 tracer=.true.
 force_coupled=.true.
/
&patch_params
 n=60,1,1          ! patch dimensions
 ng =2,0,0
 nt=5              ! time slots
 grace=0.01
/
&timer_params
 sec_per_report=15.0
/
&out_params
 out_time = 0.1
 end_time = 2.01
 print_time = 0.1
/
&cartesian_params
 size=1,1,1
 dims=5,1,1         ! number of patches
 origin=0,0,0
/
&timestep_params
 verbose=1
 time_order=2
/
&refine_params
 do_refine=f
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=f
 guard_zones=f
 do_legacy=t
/
&IC_params
/
&force_params
 type = 'dust_gas_interaction'
 i_gas = 1
 i_dust = 2
 K = 1.0
 b = 0.5
 gamma = 1.0
 !drag = 'linear'
 !drag = 'epstein'
 !drag = 'stokes'
 !drag = 'quadratic'
 !drag = 'power'
 drag = 'third_order'
 !drag = 'mixed'
/
&viscosity_params
/
&IC_solenoidal_params
/
