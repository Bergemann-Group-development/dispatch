&experiment_params
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: uniform background level for gas and dust
 !-----------------------------------------------------------------------------
 rho    =  1.0
 rho2   =  0.01
 P      =  1.0
 P2     =  0d0
 vx     =  0.0
 vx2    =  1.0
 vy     =  0d0
 vy2    =  0d0
 rhotr  =  0.5
 rhotr2 =  0.5
/
&ramses_params
 detailed_timer=f
 courant_factor=0.8
 gamma=1.66666
 slope_type=2
 !slope_type=-1
 smallr=1e-4
 smallc=5e-1
 riemann='hllc'
 do_isothermal=f
/
&mhd_params              ! defaults are visible in the log file
 !nu=    0.2, 0., 0.1, 1., 0.1, 0.
 !nu=    0.1, 1., 0., 2., 0., 0.
 !nu=    0.2, 0., 0.5, 1., 1., 0.       !Personal best; pa, ofd and mas are pretty effective at bringing down ringing. Keep cs low!
 !nu=     0.2, 0., 2., 2., 2., 0.       !Slightly less ringing, slightly more continuous shock
 !nu=     0.5, 0., 3., 3., 3., 0.       !Avoids ringing in stationary shock
 !nu=     0.4, 0.4, 0.4, 0.4, 0.4, 0.
 !nu=    0.2, 0.0, 0.5, 1.0, 1.0, 0., 1.2, 10.0, 0.0, 3.2, 0.0, 0.0 !pa, mas, and eta are irrelevant
 !                                                                 do not raise cs above 1.5
 !                                                                 do not raise ofd above 3.0
 !                                                                 do not raise du above 10.0
 nu=    0.5, 0.0, 0.5, 1.0, 1.0, 0., 4.0, 25.0, 0.0, 10.0, 0.0, 0.0 ! <- Best one so far for Sod Epstein regime
 !nu=    1.0, 0.5, 0.5, 1.0, 1.0, 0., 0.3, 12.0, 0.0, 1.0, 0.0, 0.0 ! <- Best one so far for ordinary shock and Sod linear regime
 !     cs    du   pa   ofd   mas   eta
 !gamma=1.0000001
 !gamma=1.66666
 gamma=1.0
 !mhd_AD=.false.
 !mhd_Ohm=.false.
 tracer=.true.
 force_coupled=.true.
 nc=2                                   !Number of components
 !gamma_AD=75.
 !ksi = 1d-17
/
&patch_params
 n=60,1,1          ! patch dimensions
 !dt_fixed=1d-2        ! fixed time step
 ng =2,0,0
 nt=8                   ! time slots
/
&timer_params
 sec_per_report=15.0
/
&out_params
 out_time = 0.01
 end_time = 0.11 !2.1
 print_time = 0.01
 guard_zones=f
/
&box_params
 size=1,1,1
 dims=5,1,1				! number of patches
 origin=0,0,0
/
&timestep_params
 verbose=1
 time_order=2
/
&refine_params
 refine_until=-0.01     ! disables refinment
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=f
/
&initial_params
/
&force_params
 type = 'dust_gas_interaction'
 i_gas = 1
 i_dust = 2
 K = 1.0
 b = 0.5
 sigma = 1.589e-8
 !gamma = 1.66666
 !gamma = 1.0000001
 gamma = 1.0
 nc = 2
 !drag = 'linear'
 !drag = 'epstein'
 !drag = 'stokes'
 drag = 'quadratic'
 !drag = 'power'
 !drag = 'third_order'
 !drag = 'mixed'
/
&initial_solenoidal_params
/
