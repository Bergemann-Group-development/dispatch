&experiment_params
 !!-----------------------------------------------------------------------------
 ! Physical initial conditions: !!!AD!!! Same values as in Masson et al. 2012
 ! Left hand side
 !-----------------------------------------------------------------------------
 rho_l = 0.5
 P_l   = 0.125 
 vx_l = 5d0 
 vy_l = 0d0
 Bx_l = 1.4142135623730951d0
 By_l = 1.4142135623730951d0
 !!-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side (isothermal)
 !-----------------------------------------------------------------------------
 rho_r = 1.0727d0
 P_r = 0.2681
 vx_r = 2.3305d0
 vy_r = 1.3953d0
 Bx_r = 1.4142135623730951d0
 By_r = 3.8809d0
/
&non_ideal_params
 mhd_AD=.true.
 mhd_Ohm=.false.
 ntestDADM=.true.
 etaMD=0.0
 gamma_AD=75.
 rho_ions=1.
/
&patch_params
 n=16,16,16             ! patch dimensions
! dt_fixed=1d-6        ! fixed time step
 nt=8                   ! time slots
 ng=0,0,0
 no_mans_land = t
/
&out_params
 out_time = 0.01
 end_time = 5.00
 print_time = 0.05
/
&cartesian_params
 size=1,1,1
 dims=1,1,1             ! number of patches
 origin=-0.5,-0.5,-0.5
 omp_init=f
/
&timestep_params
 verbose=0
 time_order=2
/
&refine_params
 on=f                   ! disables refinement
 check_interval=2    
/
&parallel_io_params
 verbose=0              ! =1 for output file messages
 id_debug=0
/
&mpi_io_params
 verbose=0              ! =1 for output file messages
/
&io_params
 do_trace=f             ! =t to trace execution
 verbose=0              ! =1 for output file messages
 do_output=t
 do_debug=f 
 method='parallel'
 guard_zones=f
/
&ramses_params
 !gamma=1.0001
 slope_type=3.5
 isothermal=t
/
&flux_params
 verbose=0
 /
