&experiment_params
 !!-----------------------------------------------------------------------------
 ! Physical initial conditions: !!!AD!!! Same values as in Masson et al. 2012
 ! Left hand side
 !-----------------------------------------------------------------------------
 !rho_l = 5d-1
 !P_l   = 0.125 
 !vx_l = 5d0 
 !vy_l = 0d0
 !Bx_l = 1.4142135623730951d0
 !By_l = 1.4142135623730951d0
 !!-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side (isothermal)
 !-----------------------------------------------------------------------------
 !gamma_exp = 1.0
 !rho_r = 1.0727d0
 !P_r = 0.2681
 !vx_r = 2.3305d0
 !vy_r = 1.3953d0
 !Bx_r = 1.4142135623730951d0
 !By_r = 3.8809d0
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side (non-isothermal)
 !-----------------------------------------------------------------------------
 !gamma_exp = 1.66666
 !rho_r = 0.998d0
 !P_r = 1.4075
 !vx_r = 2.5303d0
 !vy_r = 1.1415d0
 !Bx_r = 1.4142135623730951d0
 !By_r = 3.4327d0

 !!-----------------------------------------------------------------------------
 ! Physical initial conditions: !!!OHMIC!!! Same values as in Masson et al. 2012
 ! Left hand side
 !-----------------------------------------------------------------------------
 rho_l = 0.4
 P_l   = 0.4
 vx_l = 3d0 
 vy_l = 0d0
 Bx_l = 0.7071067811865476
 By_l = 0.7071067811865476
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side (Ohmic)
 !-----------------------------------------------------------------------------
 gamma_exp = 1.4 !66666
 rho_r = 0.71084
 P_r = 1.19222
 vx_r = 1.68814
 vy_r = 0.4299
 Bx_r = 0.7071067811865476
 By_r = 1.43667

/
&mhd_params              ! defaults are visible in the log file
 nu=    1., 1.0, 1.0, 0.1, 0.1, 0.1
 !nu=    0.5, 0., 0., 0.1, 0.1, 0.1
 !     cs    du   pa   ofd   mas   eta
 gamma=1.4 !66666
 mhd_AD=.false.
 mhd_Ohm=.false.
 gamma_AD=75.
 !ksi = 1d-17
/
&patch_params
 !dims=16,16,16          ! patch dimensions
 n=128,64,1          	! patch dimensions
 dt_fixed=1d-3        ! fixed time step
 ng = 0,0,0
 nt=8                   ! time slots
 !end_time=4.1
 !nt=1                   ! time slots

/
&out_params
 out_time = 0.1
 end_time = 50.00
 print_time = 0.05
 guard_zones=f
/ 
&box_params
 size=1,1,1
 dims=1,1,1				! number of patches
 !origin=0,0,0

/
&timestep_params
 verbose=1
 time_order=2
/
&refine_params
 refine_until=-0.01     ! disables refinment
 min_jeans=10.
 levelmax=10
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=t 
/
&initial_params
/
