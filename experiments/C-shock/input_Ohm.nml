&experiment_params
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: !!!OHMIC!!! Same values as in Masson et al. 2012
 ! Left hand side
 !-----------------------------------------------------------------------------
 rho_l = 0.4
 P_l   = 0.4
 vx_l = 3d0 
 vy_l = 0d0
 Bx_l = 0.7071067811865476
 By_l = 0.7071067811865476
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side (Ohmic)
 !-----------------------------------------------------------------------------
 rho_r = 0.71084
 P_r = 1.19222
 vx_r = 1.68814
 vy_r = 0.4299
 Bx_r = 0.7071067811865476
 By_r = 1.43667

/
&stagger_params              ! defaults are visible in the log file
 !nu=    0.5, 1.0, 1.0, 0.1, 0.1, 0.1
 !nu=    0.5, 1., 0., 1., 0.1, 0.1
 !nu=    0.1, 1., 1., 1., 0.1, 0.1
 !nu=    0.2, 0., 0.1, 1., 0.1, 0.
 !nu=    0.1, 1., 0., 2., 0., 0.
 !nu=    0.1, 1., 1., 0., 1., 0.1
 !nu=    0.1, 0.1, 0.1, 0.1, 0.5, 0.
 nu= 0., 0., 0., 0., 0., 0. 
 !       cs   pa  ofd  mas  kap  eta
 !gamma=1.0000001  
 gamma=1.666667
 courant=0.2
/

&non_ideal_params
 mhd_AD=.false.
 mhd_Ohm=.true.
 gamma_AD=75.
 eta_Ohm=0.1
/
&patch_params
 n=150,1,1          ! patch dimensions
 !dt_fixed=1d-6        ! fixed time step
 ng =2,0,0
 nt=8                   ! time slots
/
&timer_params
 sec_per_report=15.0
/
&out_params
 out_time = 0.1
 end_time = 5.1
 print_time = 0.1
/ 
&cartesian_params
 size=1,1,1
 dims=1,1,1				! number of patches
 origin=0,0,0
/
&timestep_params
 verbose=1
 time_order=2
/
&refine_params
 refine_until=-0.01     ! disables refinment
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=f
 guard_zones=f
/
&IC_params
/
&force_params
/
