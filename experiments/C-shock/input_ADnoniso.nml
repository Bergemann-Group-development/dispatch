&experiment_params
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: !!!AD!!! Same values as in Masson et al. 2012
 ! Left hand side
 !-----------------------------------------------------------------------------
 rho_l = 5d-1
 P_l   = 0.125 
 vx_l = 5d0 
 vy_l = 0d0
 Bx_l = 1.4142135623730951d0
 By_l = 1.4142135623730951d0
 !-----------------------------------------------------------------------------
 ! Physical initial conditions: right hand side (non-isothermal)
 !-----------------------------------------------------------------------------
 rho_r = 0.988d0
 P_r = 1.4075
 vx_r = 2.5303d0
 vy_r = 1.1415d0
 Bx_r = 1.4142135623730951d0
 By_r = 3.4327d0
 x0=0.5
/
&mhd_params              ! defaults are visible in the log file
 !nu=    0.5, 1.0, 1.0, 0.1, 0.1, 0.1
 !nu=    0.5, 1., 0., 1., 0.1, 0.1
 !nu=    0.1, 1., 1., 1., 0.1, 0.1
 !nu=    0.2, 0., 0.1, 1., 0.1, 0.
 nu= 0.1, 0., 0., 0., 0.5, 0.
 !     cs    du   pa   ofd   mas   eta
 !gamma=1.0000001  
 gamma=1.666667
/

&non_ideal_params
 mhd_AD=.true.
 mhd_Ohm=.false.
 gamma_AD=75.
/

&patch_params
 n=30,1,1          ! patch dimensions
 !dt_fixed=1d-2        ! fixed time step
 ng =2,0,0
 nt=8                   ! time slots
 courant=0.1
/
&timer_params
 sec_per_report=15.0
/
&out_params
 out_time = 0.1
 end_time = 2.1
 print_time = 0.1
 guard_zones=f
/ 
&cartesian_params
 size=1,1,1
 dims=5,1,1				! number of patches
 origin=0,0,0
/
&timestep_params
 verbose=1
 time_order=2
/
&refine_params
 refine_until=-0.01     ! disables refinment
/
&io_params
 !do_trace=f             ! =t to trace execution
 verbose=1              ! =1 for output file messages
 do_output=t
 do_debug=f 
/
&IC_params
/
&force_params
/
