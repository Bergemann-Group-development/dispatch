! $Id: c9d088095a5971b37f99f4a603475b0a3d103fe3 $
!
! This default input file defines a run that should take only a few minutes
! on a laptop, producing 10 snapshots in time.
!
! Do not modify this default input.nml file to make experiments. Instead, copy
! input.nml to whatever.nml, and run ./dispatch.x whatever.nml, which produces
! data files named data/whatever/ttttt/, where ttttt is the snapshot number.

! To make the box 2 times larger:

!scaling_params         v_kms=1.0 l_pc=0.50 d_cgs=2e-23 /               ! increase l_pc
&scaling_params         v_kms=1.0 l_pc=2.00 d_cgs=2e-23 /               ! increase l_pc
&experiment_params      density_cgs=6e-22 cs_kms=0.18 /
!sinks_params           verbose=0 radius_au=2.6e3 mass_msun=30 /        ! increase radius_au
&sinks_params           verbose=0 radius_au=10.4e3 mass_msun=30 /       ! increase radius_au
&winds_params           verbose=0 velocity_kms=2e3 msun_per_yr=1e-5
                       !ramp_time_myr=0.0012 cs_kms=180.                ! increase ramp_time_myr
                        ramp_time_myr=0.0050 cs_kms=180.                ! increase ramp_time_myr
                        incremental=t /
&cooling_params         verbose=1 type='Casiana'
                        on=f do_heat=t do_subcycle=t /
&io_params              verbose=0 do_trace=f omp_trace=f id_debug=0
                        do_output=t guard_zones=f time_derivs=0
                        method='parallel' format=8
                        !method='legacy'
/
!out_params             end_time=0.07 out_time=0.0005 print_every=100   ! increase out_time
&out_params             end_time=0.07 out_time=0.0005 print_every=500   ! increase out_time
                        print_time=0 /
&mpi_io_params          verbose=0 /
&parallel_io_params     verbose=0 id_debug=0 /
&time_slices_params     verbose=0 order=1 id_debug=-1 /
&timer_params           sec_per_report=30 /
&ramses_params          detailed_timer=f courant_factor=0.25 slope_type=2
                        isothermal=f gamma=1.67 smallr=1e-6 smallc=0.18 /
&dispatcher0_params     verbose=0 detailed_timer=f /
&cartesian_params       size=1,1,1                                      ! physical size
                        dims=3*07                                       ! Cartesian patch arrangement
                        mpi_dims=2,1,1                                  ! MPI rank distribution
                        origin=0,0,0                                    ! Cartesian system origin
                        omp_init=t                                      ! spread memory allocation
/
&patch_params           nt=5 grace=0.1 n=3*32 no_mans_land=t do_check_nan=f /
&download_params        verbose=0 order_time=1
                        !use_same='different'
                        !use_same='guard_zones'
                        !use_same='guard_same'
                        detailed_timer=f /
&guard_zone_params      verbose=0 detailed_timer=f /
&timestep_params        /

&IC_params
 type='single_solenoidal'
!type='single_compressive'
!type='single_advection'
!type='exa256'
!type='raw'
/
&IC_solenoidal_params  k=1,1,2 a0=0.0,0.0,0.0                           /
&IC_compressive_params k=3,3,3 a0=0.0,0.0,0.0 u0=0.1,0.2,0.3 b0=0,0,0.0 /
&IC_advection_params   k=3,3,3 a0=0.0,0.0,0.0 u0=0.1,0.2,0.3 b0=0,0,0.0 /

&force_params               type='single_solenoidal' /
&force_solenoidal_params    k=1,1,2 a0=10.0,10.2,10.1 t_turn=0.1000 /

                            !    cs   pa  ofd  mas  kap  eta
&stagger_params             nu=0.30, 1.0, 1.0, 0.0, 1.0, 1.0
                            courant=0.2 eos='ideal' gamma=1.6666667
/
