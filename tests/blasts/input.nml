! Blast wave

&experiment_params      d0=1 d1=0 p0=1 p1=300 w=4 power=4 gamma=1.666667 /

&box_params             size=1,1,1 dims=1,1,1 origin=0,0,0 /
&patch_params           n=3*100 ng=3*3 nt=5 no_mans_land=f /

&io_params              verbose=1 do_trace=f do_output=t method='parallel' /
&out_params             out_time=0.01 end_time=0.20 print_time=0.0 guard_zones=f / 

                        !  du   pa   ofd  mas  kap  eta  
&stagger_params         nu=.05, 2.0, 1.0, 0.0, 1.0, 1.0  courant=0.2 /
&ramses_params          courant_factor=0.25 gamma=2 slope_type=3.5 smallr=1e-4 smallc=5e-1 riemann='hlld' /
&non_ideal_params       mhd_AD=.false. mhd_Ohm=.false. ntestdadm=.true. etaMD=0.0 gammaAD=80. rhoi0=1. /
&zeus_params            gamma=2 trnvrsn=0 dtinit=1.0e-5 itote=1 qlin=0.2 qcon=1.0 iord=2 iords=3 istp=2 /

&timestep_params        time_order=2 /
&refine_params          do_refine=f /
&timer_params           sec_per_report=15.0 /

&force_params           /
&IC_params         /
