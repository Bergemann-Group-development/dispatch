! Stand-off shock, with initially everything uniform, except for velocioties converging from left and right

!experiment_params      d_l=1 d_r=1 vx_l=0.0 vx_r=-0.0 bx_l=0 bx_r=0 by_l=0 by_r=0 bz_l=0 bz_r=0 gamma=1.4 /
&experiment_params      d_l=1 d_r=1 vx_l=1.0 vx_r=-1.0 bx_l=0 bx_r=0 by_l=0 by_r=0 bz_l=0 bz_r=0 gamma=1.4 /

&cartesian_params       size=1,1,1 dims=1,1,1 origin=0,0,0 /
&patch_params           n=501,1,1 ng=3*2 nt=5 no_mans_land=f /                          ! for stagger2 ..
!patch_params           n=501,4,4 ng=3*3 nt=5 no_mans_land=f /                          ! for HLLD

&io_params              verbose=0 do_trace=f do_output=t method='parallel' /
&out_params             out_time=0.01 end_time=0.05 print_time=0.0 guard_zones=f / 
&out_params             out_time=2.0e-5 end_time=8e-5 print_time=0.0 guard_zones=f /  ! for tests

&ramses_params          courant_factor=0.25 gamma=1.4 slope_type=3.5 smallr=1e-4 smallc=5e-1 riemann='hlld' /
&non_ideal_params       mhd_AD=.false. mhd_Ohm=.false. ntestdadm=.true. etaMD=0.0 gammaAD=80. rhoi0=1. /
&zeus_params            gamma=2 trnvrsn=0 dtinit=1.0e-5 itote=1 qlin=0.2 qcon=1.0 iord=2 iords=3 istp=2 /

&timestep_params        time_order=2 /
&refine_params          do_refine=f tol_shock=0.1 tol_contact=0.1 min_dx=0.0025 grad_var='d' tol_grad=0.1 /
&timer_params           sec_per_report=15.0 /

&force_params           /
&IC_params         /
                        !  du    pa   ofd  mas   kap  eta  nu
&stagger_params         nu=0.15, 2.0, 0.0, 0.00, 2.0, 1.0, 0.3  gamma=1.4 do_smooth=f courant=0.1 verbose=1 /
