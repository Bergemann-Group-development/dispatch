! Brio & Wu test

&experiment_params      P_l =1.0  P_r =0.1  d_l =1.0  d_r =0.2  gamma=2
                        vx_l=0.0  vx_r=0.0  vy_l=0.0  vy_r=0.0  vz_l=0.0  vz_r=0.0
                        Bx_l=1.0  Bx_r=1.0  By_l=1.0  By_r=0.0  Bz_l=0.0  Bz_r=0.0
/

&cartesian_params             size=1,1,1 dims=1,1,1 origin=0,0,0 /
&patch_params           n=501,1,1 ng=3*2 nt=5 no_mans_land=f /                          ! for stagger2 ..
!patch_params           n=501,4,4 ng=3*3 nt=5 no_mans_land=f /                          ! for HLLD

&io_params              verbose=0 do_trace=f do_output=t method='parallel' /
&out_params             out_time=0.01 end_time=0.20 print_time=0.0 guard_zones=f / 
&out_params             out_time=2.2e-3 end_time=4.4e-3 print_time=0.0 guard_zones=f /  ! for tests

                        !  du   pa   ofd  mas  kap  eta  
&stagger_params         nu=.01, 2.0, 1.0, 0.0, 1.0, 1.0  gamma=2 /
&ramses_params          courant_factor=0.25 gamma=2 slope_type=3.5 smallr=1e-4 smallc=5e-1 riemann='hlld' /
&non_ideal_params       mhd_AD=.false. mhd_Ohm=.false. ntestdadm=.true. etaMD=0.0 gammaAD=80. rhoi0=1. /
&zeus_params            gamma=2 trnvrsn=0 dtinit=1.0e-5 itote=1 qlin=0.2 qcon=1.0 iord=2 iords=3 istp=2 /

&timestep_params        time_order=2 /
&refine_params          do_refine=f tol_shock=0.1 tol_contact=0.1 min_dx=0.0025 grad_var='d' tol_grad=0.1 /
&timer_params           sec_per_report=15.0 /

&force_params           /
&IC_params         /
