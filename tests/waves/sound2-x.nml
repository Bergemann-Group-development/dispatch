&experiment_params      mhd=t waves=2 nj=1 d0=1 b0=0 ampl=1e-2 type='sound2' direction='x' /

&cartesian_params       size=1,0.08333,0.08333 dims=1,1,1 origin=0,0,0 /
&patch_params           n=32,2,2 ng=3*3 nt=5 no_mans_land=f /

&io_params              verbose=-1 do_trace=f do_output=t method='parallel' /
&out_params             out_time=0.02 end_time=2.01 print_time=0.0 guard_zones=f / 

                                    !   du    pa   ofd  mas  kap  eta  
&stagger_params         courant=0.20 nu=0.005, 0.0, 0.0, 0.2, 0.0, 0.0  gamma=1.4 /
&ramses_params          courant_factor=0.25 isothermal=t gamma=1 slope_type=2.0 /
&non_ideal_params       mhd_AD=.false. mhd_Ohm=.false. ntestdadm=.true. etaMD=0.0 gammaAD=80. rhoi0=1. /

&refine_params          /
&timestep_params        time_order=3 /
&timer_params           sec_per_report=15.0 /

&IC_params         /
&force_params           /
