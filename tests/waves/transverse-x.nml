&experiment_params      d0=1 b0=1 ampl=1 type='transverse' direction='x' /

&cartesian_params             size=1,1,1 dims=1,1,1 origin=0,0,0 /
&patch_params           n=33,1,1 ng=3*2 nt=5 no_mans_land=f /
!patch_params           n=33,33,33 ng=3*2 nt=5 no_mans_land=f /

&io_params              verbose=-1 do_trace=f do_output=t method='parallel' /
&out_params             out_time=0.10 end_time=5.01 print_time=0.0 guard_zones=f / 
&out_params             out_time=2.2e-3 end_time=4.4e-3 print_time=0.0 guard_zones=f / 

                        !  du   pa   ofd  mas  kap  eta  
&stagger_params         nu=.01, 2.0, 1.0, 0.0, 1.0, 1.0  gamma=1.666667 /
&ramses_params          courant_factor=0.25 gamma=1.666667 slope_type=3.5 riemann='hlld' /
&non_ideal_params       mhd_AD=.false. mhd_Ohm=.false. ntestdadm=.true. etaMD=0.0 gammaAD=80. rhoi0=1. /

&refine_params          /
&timestep_params        time_order=2 /
&timer_params           sec_per_report=15.0 /
