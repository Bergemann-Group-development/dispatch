&timer_params
 sec_per_report=20
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&out_params
 end_time=2000.0
 out_time=20.0
 guard_zones=t
 time_derivs=f
 print_time=20.0
/

&box_params
 size=1,1,1
 dims=3,3,1
 dims=9,9,1
 mpi_dims=1,1,1
/

&patch_params
  courant=1.0
  !n=8,8,1
  !n=16,16,1
  !n=32,32,1
  !n=96,96,1
  n=128,128,1
  !n=256,256,1
  nt=5
  no_mans_land=f
/

&initial_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=f
/

&selfgravity_params
 selfgravity=t
 verbose=1
 prediction=f order=1
/

&poisson_params
 floor=1e-6
 tolerance=1e-4
 fourpiG=1.0
 max_iter=400
 precondition=t
 verbose=1
 solver='cg'
/
