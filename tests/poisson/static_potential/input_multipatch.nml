&timer_params
 sec_per_report=20
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&rubiks_params
 !size=0.004115226,0.004115226,1.0  n_levels=1
 !size=0.0123456,0.0123456,1.0  n_levels=1
 !size=0.037037,0.037037,1.0  n_levels=1
 !size=0.11111,0.11111,1.0 n_levels=1
 size=0.33333,0.33333,1.0 n_levels=1
 !size=1.0,1.0,1.0
 !n_patch=1,1,1
 n_patch=3,3,1
 !n_patch=9,9,1
 !n_patch=27,27,1
 n_repeat=1,1,1
 m_zoom=3
 position=0.5,0.5,0.0
/

&out_params
 end_time=800.0
 out_time=10.0
 guard_zones=t
 time_derivs=f
 print_time=1.0
/

&patch_params
  courant=1.0
  !n=8,8,1
  !n=16,16,1
  !n=32,32,1
  !n=96,96,1
  n=96,96,1
  nt=5
  no_mans_land=f
/

&initial_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=f
/

&selfgravity_params
 selfgravity=t
 verbose=1
 prediction=f order=1
/

&poisson_params
 floor=1e-8
 tolerance=1e-3
 fourpiG=1.0
 max_iter=200
 precondition=t
 verbose=1
 solver='cg'
/
