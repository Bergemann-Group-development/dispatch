&timer_params
 sec_per_report=20
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&rubiks_params
 !size=0.004115226,0.004115226,1.0  n_levels=5
 !size=0.01234567,0.01234567,1.0  n_levels=4
 size=0.037037037,0.037037037,1.0  n_levels=3
 !size=0.1111111,0.1111111,1.0 n_levels=1
 !size=0.1111111,0.1111111,1.0 n_levels=2
 !size=0.333333,0.333333,1.0 n_levels=1
 !size=0.4,0.4,1.0 n_levels=1
 !size=0.625,0.625,1.0 n_levels=2
 !size=0.375,0.375,1.0 n_levels=3
 !size=0.1875,0.1875,1.0 n_levels=4
 !size=1.0,1.0,1.0 n_levels=3
 n_patch=3,3,1
 !n_patch=3,3,1
 !n_patch=9,9,1
 n_repeat=1,1,1
 m_zoom=3,3,1
 position=0.5,0.5,0.0
/

&out_params
 end_time=1500.0
 out_time=100.0
 guard_zones=t
 time_derivs=f
 print_time=20.0
/

&patch_params
  courant=1.0
  !n=4,4,1
  !n=8,8,1
  n=16,16,1
  !n=17,17,1
  !n=32,32,1
  !n=64,64,1
  !n=96,96,1
  !n=128,128,1
  nt=5
  no_mans_land=f
/

&initial_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=f
 refine_from_t=0.1
 refinement_ratio=3
 min_dx=0.03
 region_llc=0.45,0.45,-0.5
 region_urc=0.55,0.55,-0.5
 check_interval=1
/

&selfgravity_params
 selfgravity=t
 verbose=1
 prediction=f order=1
/

&poisson_params
 floor=1e-6
 tolerance=1e-4
 fourpiG=1.0
 max_iter=200
 precondition=t
 verbose=1
 solver='cg'
/

&download_params
 order_interpolator=-1
/
