&timer_params
 sec_per_report=20
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&out_params
 end_time=1000.0
 out_time=20.0
 guard_zones=t
 time_derivs=f
 print_time=20.0
/

&cartesian_params
 size=1,1,1
 dims=1,1,1
 mpi_dims=1,1,1
/

&patch_params
  courant=1.0
  !n=5,5,1
  n=9,9,1
  !n=17,17,1
  !n=33,33,1
  n=65,65,1
  !n=129,129,1
  nt=5
  no_mans_land=f
/

&IC_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=t
 refine_from_t=0.
 refine_until_t=0.
 refinement_ratio=3
 region_llc=-0.05,-0.05,-0.5
 region_urc=0.05,0.05,-0.5
 levelmax=4
/

&selfgravity_params
 selfgravity=t
 verbose=1
 prediction=f order=1
/

&poisson_params
 floor=1e-6
 tolerance=1e-4
 fourpiG=1.0
 max_iter=300
 precondition=t
 verbose=1
 solver='cg'
/

&download_params
 order_interpolator=-1
/
