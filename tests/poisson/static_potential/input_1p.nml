&timer_params
 sec_per_report=20
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&rubiks_params
 size=1.0,1.0,1.0
 n_patch=1,1,1
 n_repeat=1,1,1
 m_zoom=1
 n_levels=1
 position=0.5,0.5,0.0
/

&out_params
 end_time=1.0
 out_time=0.1
 guard_zones=t
 time_derivs=f
 print_time=10.0
/

&patch_params
  courant=1.0
  n=16,16,1
  !n=32,32,1
  !n=64,64,1
  !n=128,128,1
  !n=256,256,1
  !n=512,512,1
  !n=1024,1024,1
  !n=2048,2048,1
  nt=5
  no_mans_land=f
/

&initial_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=f
/

&selfgravity_params
 selfgravity=t
 verbose=2
 prediction=f order=1
/

&poisson_params
 floor=1e-8
 tolerance=1e-4
 fourpiG=1.0
 max_iter=500
 precondition=t
 verbose=2
/
