&timer_params
 sec_per_report=10
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&rubiks_params
 !size=0.0123456,0.0123456,1.0
 !size=0.037037,0.037037,1.0
 !size=0.11111,0.11111,1.0
 size=0.33333,0.33333,1.0
 !size=1.0,1.0,1.0
 n_patch=3,3,1
 n_repeat=1,1,1
 m_zoom=3
 n_levels=1
 position=0.5,0.5,0.0
/

&out_params
 end_time=100.0
 out_time=10.0
 guard_zones=t
 time_derivs=f
 print_time=500.0
/

&patch_params
  courant=1.0
  n=32,32,1
  nt=5
  no_mans_land=t
/

&experiment_params
 aepsilon=1e-3
/

&initial_params
 r0=0.25
/

&timestep_params
  time_order=1
/

&refine_params
 do_refine=f
/

&selfgravity_params
 selfgravity=t
 verbose=1
 fourpiG=1.0
 prediction=f
 order=1
 max_iter=1000
 repsilon=1e-1
 aepsilon=1e-3
/

&poisson_params
 solver='zeus_sor'
/
