&timer_params
 sec_per_report=10.
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
 time_derivs=0
 guard_zones=t
 method='legacy'
/

&out_params
 end_time=2000.0
 out_time=100.0
 print_time=50.0
/

&cartesian_params
 size=1,1,1
 !dims=1,1,1
 dims=3,3,1
 !dims=9,9,1
 mpi_dims=1,1,1
/

&patch_params
  !n=8,8,1
  !n=16,16,1
  n=32,32,1
  !n=65,65,1
  !n=96,96,1
  !n=128,128,1
  !n=256,256,1
  nt=5
  no_mans_land=f
  grace=0.01
/

&IC_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&selfgravity_params
 selfgravity=t
 verbose=1
 prediction=f order=1
 d0=0.0  ! the default value used by the code (the mean of the density) is 
         ! not suitable for this test and gives poor results.
/

&poisson_params
 floor=1e-6
 tolerance=1e-4
 fourpiG=1.0
 max_iter=200
 precondition=t
 verbose=1
 solver='cg'
/

&download_params
 order_interpolator=-1
/

&task_list_params
  mulligan_level=0
/
