&timer_params
 sec_per_report=20
/

&io_params
 verbose=1
 do_trace=f
 do_debug=f
 do_output=t
 do_legacy=t
 omp_trace=f
/

&out_params
 end_time=100.0
 out_time=10.0
 guard_zones=t
 time_derivs=f
 print_time=20.0
/

&box_params
 size=1,1,1
 dims=1,1,1
 mpi_dims=1,1,1
/

&patch_params
  courant=1.0
  n=16,16,1
  nt=5
  no_mans_land=f
/

&initial_params
 r0=0.1
/

&timestep_params
  time_order=2
/

&refine_params
 do_refine=f
 refine_from_t=0.1
 refinement_ratio=3
 min_dx=0.03
 region_llc=0.45,0.45,-0.5
 region_urc=0.55,0.55,-0.5
 check_interval=1
/

&selfgravity_params
 selfgravity=t
 verbose=1
 prediction=f order=1
/

&poisson_params
 floor=1e-6
 tolerance=1e-4
 fourpiG=1.0
 max_iter=200
 precondition=t
 verbose=1
 solver='cg'
/

&download_params
 order_interpolator=-1
/
