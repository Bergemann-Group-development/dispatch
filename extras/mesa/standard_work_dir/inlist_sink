&star_job

  ! ------------------------------------------
  ! ONLY FOR CREATING 2nd CORE!
  ! ------------------------------------------
  !create_initial_model = .true. ! this is an alternative to create_pre_main_sequence_model
  !radius_in_cm_for_create_initial_model = 6.955e11 ! in cm (10 Rsun)
  !radius_in_cm_for_create_initial_model = 1.391e11 ! in cm (2 Rsun)
  !radius_in_cm_for_create_initial_model = 2.782e11 ! in cm (4 Rsun)
  !radius_in_cm_for_create_initial_model = 4.4879e10 ! in cm (3e-3 AU = 0.64 Rsun)
  !radius_in_cm_for_create_initial_model = 3.4775e11 ! in cm (5 Rsun)
  !mass_in_gm_for_create_initial_model = 2.78474e30 ! in grams = 0.0014 Msun
  !initial_model_relax_num_steps = 10

  !create_pre_main_sequence_model = .true.



  !relax_mass_scale = .true.
  !relax_initial_mass_scale = .false.
  !dlgm_per_step = 1d-3 ! log10(delta M/Msun/step)
  !new_mass = 2.863362d-3 ! 3 Mjupiter in Msun units
  !new_mass = 9.54265748d-3 ! 10 Mjupiter in Msun units
  !new_mass = 0.0014 ! ~20 Mjupiter in Msun units
  !change_mass_years_for_dt = 1.0

  ! ------------------------------------------
  ! Load 2nd Core
  ! ------------------------------------------
  ! start a run from a saved model:
  
  load_saved_model = .true.
  saved_model_name = 'model8845_3mjup.mod'

  ! ------------------------------------------
  ! Network for deuterium burning and PMS stuff

  change_initial_net = .true.
  new_net_name = 'pp_extras.net'
  show_net_species_info = .true.

  ! ------------------------------------------
  ! Are these the right opacities
  kappa_file_prefix = 'gs98'
  kappa_lowT_prefix = 'lowT_Freedman11'

   ! ------------------------------------------
  set_uniform_initial_composition = .true.
  initial_h1 = 0.70
  initial_h2 = 2e-5 ! if no h2 in current net, then this will be added to h1
  initial_he3 = 2.98e-5
  initial_he4 = 0.28

  ! ------------------------------------------
  ! Rotation
  !change_initial_rotation_flag = .false.
  !new_rotation_flag = .true.
  !change_rotation_flag = .true.

  ! Rotation test
  !new_omega = 3.3e-6
  !set_omega = .true.
  !set_initial_omega = .false.
  !set_omega_step_limit = 1000000

  ! ------------------------------------------


  pgstar_flag = .false.
  write_profile_when_terminate = .true.
  ! ------------------------------------------

  history_columns_file = 'closeup_history_columns.list'
  profile_columns_file = 'closeup_profile_columns.list'

/ ! end of star_job namelist

&controls
  log_directory = 'LOGS'

  max_model_number = 1000000

  !initial_mass = 0.03     !! Til PMS-model

  ! ------------------------------------------
  ! Accretion rate [Msun / year] -- max one can be active
  ! FOR CONSTANT ACC. RATE:
  !mass_change = 5e-5              ! Constant accretion
  ! automatic stops for mass loss/gain when reaching this mass -- enable with constant accretion
  !max_star_mass_for_gain = 1.0 ! in Msun units (negative means ignore this parameter)
  ! FOR ACCRETION HISTORY:
  use_other_adjust_mdot = .true.   ! Accretion specified in file

  ! ------------------------------------------
  !Hot/Cold accretion
  varcontrol_target = 5d-3
  use_other_energy = .true.
  x_ctrl(1) = 0.10   !  ALPHA PARAMETER
  ! ------------------------------------------

  
  ! ------------------------------------------
  history_interval = 1
  !max_age = 1d12
  !xa_central_lower_limit_species(1) = 'h1'
  !xa_central_lower_limit(1) = 1d-4

  accrete_same_as_surface = .false.
  accretion_h1 = 0.70 ! mass fraction
  accretion_h2 = 2e-5 ! if no h2 in current net, then this is automatically added to h1
  accretion_he3 = 2.98E-5
  accretion_he4 = 0.28
  accretion_zfracs = 3

      ! extra heat
      !inject_uniform_extra_heat = 1.4e3 ! erg g^-1 s^-1

  !photostep = 1

  ! limit for change in mdot
  delta_mdot_atol = 1d-3 ! Msun/yr --- tolerance for absolute changes
  delta_mdot_rtol = 3.0 ! tolerance for relative changes

  !
  mesh_delta_coeff = 0.75

  ! ------------------------------------------
  ! stop when the star nears ZAMS (Lnuc/L > 0.99)
  !Lnuc_div_L_zams_limit = 0.999d0
  !stop_near_zams = .false.

  xa_central_lower_limit_species(1) = 'h1'
  xa_central_lower_limit(1) = 0.68
  !x_ctrl(21) = 0.68

  
  ! ------------------------------------------
  ! Convection:
  mixing_length_alpha = 1.82

  overshoot_f_above_nonburn_core = 0.016
  overshoot_f_above_burn_h_core  = 0.016
  overshoot_f0_above_nonburn_core = 0.008
  overshoot_f0_above_burn_h_core  = 0.008

  overshoot_f0_above_nonburn_shell = 0.0087
  overshoot_f_above_nonburn_shell = 0.0174
  overshoot_f0_below_nonburn_shell = 0.0087
  overshoot_f_below_nonburn_shell = 0.0174

  overshoot_f0_below_burn_h_shell = 0.0087
  overshoot_f_below_burn_h_shell = 0.0174
  overshoot_f0_above_burn_h_shell = 0.0087
  overshoot_f_above_burn_h_shell = 0.0174

  ! Change mesh delta coeff in overshooting regions:
  xtra_coef_os_above_nonburn = 0.5
  xtra_coef_os_below_nonburn = 0.5

  xtra_coef_os_above_burn_h = 0.5
  xtra_coef_os_below_burn_h = 0.5

  ! ------------------------------------------
  !profile_interval = 30
  !max_num_profile_models = 300

/ ! end of controls namelist


&pgstar

    read_extra_pgstar_inlist1 = .false.
    extra_pgstar_inlist1_name = 'inlist_pgstar'

/ ! end of pgstar namelist
